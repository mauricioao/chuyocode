# ChuyoCode environment variables.
# Copy to `.env` and fill in real values. Required vars are validated at
# startup by src/lib/env.ts — the server refuses to boot if any are missing.

# --- Required (spec 1) ---
# SANITY_PROJECT_ID and SANITY_DATASET are NOT secrets (they appear in the
# public Studio URL) — real values pre-filled so a fresh clone runs faster.
SANITY_PROJECT_ID=z9wkqssq
SANITY_DATASET=production_
# Supabase URL is public; the anon/publishable key is a client key (safe to
# expose in a browser) but still keep the real one out of git.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Optional (later work units: pass gate + rewarded ads) ---
# SECRETS — never commit real values. Server-only.
# Service-role key: privileged 24h-pass writes (never expose to browser).
SUPABASE_SERVICE_ROLE_KEY=
# HMAC secret used to sign/verify pass cookies + ad-completion tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AD_HMAC_SECRET=

# --- Legal entity (site owner) ---
# Rendered on /legal/terms and /legal/privacy. These ARE public by law (Ley
# 29733 requires the data controller to be identified on the site), but live
# here so they stay out of source control instead of being hardcoded. All
# OPTIONAL: the legal pages fall back to a neutral label when a value is unset.
LEGAL_OWNER_NAME=
LEGAL_OWNER_RUC=
LEGAL_OWNER_CITY=
LEGAL_OWNER_EMAIL=

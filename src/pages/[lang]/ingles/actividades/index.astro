---
/**
 * Public feed of community activities — `/[lang]/ingles/actividades` (SSR,
 * "Descubrir"/discovery). LIVE activities only (`visible`), filterable by
 * search (`?q=`), CEFR level (`?nivel=`), block type (`?tipo=`), and whether
 * the viewer has already seen them (`?novistas=1`), sortable by recency,
 * hearts, or views (`?orden=`), paginated 20/page.
 *
 * Under `ingles/**`, so this route is ALREADY gated and marked
 * private/no-store by the middleware (`@lib/access`'s `GATED_SECTIONS`,
 * `src/middleware.ts`'s own header comment) — no per-page gate or
 * `markPrivate` call is needed here, unlike `/[lang]/crear` or
 * `/[lang]/mis-actividades`, which sit OUTSIDE that section. `Astro.locals.user`
 * is therefore expected non-null in production — the `isGuest` branch below
 * exists only for parity with `[id].astro`'s own documented pattern
 * (defensive, and what the TEMP local override needs for screenshots); a
 * real anonymous visitor is redirected away by the middleware before this
 * page ever runs, so `isGuest` is always `false` in practice.
 *
 * "DESKTOP" REDESIGN, community-folds-into-propuestos pass (owner spec
 * 2026-10-07, "ya no tendremos ejercicios propuestos separados de
 * actividades de la comunidad... de igual manera será una carpeta y abrirá
 * una ventana dentro del escritorio"): this catalog now RENDERS AS A WINDOW
 * over the desk too, exactly like the practice page (`[id].astro`'s own
 * header) — same `DeskScene`/`DeskWindow` shell, same real URL (every
 * filter/the page number/the search term all still live in the query
 * string, so the whole page keeps working with scripting off and stays
 * deep-linkable). The "Ejercicios propuestos" folder/route is GONE — its
 * curated-exercise levels dock now points here instead
 * (`DeskScene.astro`'s own header), and `/[lang]/ingles/propuestos`,
 * `/[lang]/ingles/[level]/[focus]` and `/[lang]/ingles/[level]/[focus]/[slug]`
 * are now permanent redirects to this exact route.
 *
 * ONE WINDOW, NOT A STACK (owner spec: filter changes, pagination, opening
 * an activity, and going back must all feel like ONE window): a filter
 * link, a pagination link, and an `ActivityCard`'s own link are all PLAIN
 * `<a href>`s — Astro's ClientRouter still treats each as a real navigation
 * (so the URL/back button/no-JS story is unchanged), but the window's own
 * drag offset survives it regardless, because that offset lives in
 * `sessionStorage` under one shared key (`@lib/deskWindowDragMath`'s own
 * `DESK_WINDOW_OFFSET_STORAGE_KEY`, re-applied on every `DeskWindow` mount —
 * `deskWindowDrag.ts`'s own header), never in in-memory DOM state that a
 * fresh page render would lose. The scale-in open animation is the other
 * half of "feels like one window": it is GATED to a genuine folder/desk
 * opener click (`@lib/ui/deskWindow.ts#applyDeskWindowOrigin`'s own header)
 * and never replays for any of these plain in-window links, only for a
 * fresh open from the hub's own folder. The practice window's `‹` back arrow
 * returns here with `history.back()` when it can (`DeskWindow.astro`'s own
 * `backHref` doc), landing back on the exact filtered/scrolled state the
 * visitor left.
 *
 * UNIFIED SEARCH HEADER (community-search-unify pass, carried over
 * unchanged): search + the compact filters panel now sit in the window's
 * OWN title-bar `actions` — the same slot the practice window's heart/
 * share/more icons already use (same compact 36px controls, no second row
 * needed), rather than `PageTitle`'s old `actions` slot (there is no
 * `PageTitle` heading here any more — the window's own title bar already
 * shows "Actividades de la comunidad"). ALL FILTERS STILL LIVE IN THE URL,
 * as plain GET forms plus plain links (pagination, chips, "Limpiar
 * filtros") — the whole page still works with scripting off, stays
 * deep-linkable, and survives a back-button press. The actual query
 * building (search escaping, sort columns, the `novistas` exclusion) lives
 * in `getPublishedActivities` (`@lib/activities/activities`) and
 * `discoveryQuery.ts`, never here.
 *
 * Active filters (nivel/tipo/orden!=default/novistas) are visible without
 * opening the panel: a row of small removable chips under the title bar,
 * each a plain link dropping just that one param.
 *
 * "Actividad del día": only on page 1 with NO filters active, a highlighted
 * card picked deterministically for the calendar day
 * (`pickDailyActivity`, `@lib/activities/dailyPick`) among the top 20 live
 * activities by heart count. Hidden entirely when there are no candidates.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import DeskScene from '@components/ingles/DeskScene.astro';
import DeskWindow from '@components/ingles/DeskWindow.astro';
import ActivityCard from '@components/ui/ActivityCard.astro';
import Emoji from '@components/ui/Emoji.astro';
import SearchFilter from '@components/ui/SearchFilter.astro';
import CommunityFiltersPanel from '@components/activities/CommunityFiltersPanel.astro';
import { buttonVariants } from '@components/ui/button';
import { PlusIcon } from '@phosphor-icons/react/dist/ssr/Plus';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { LEVELS, isLevel } from '@lib/exerciseTaxonomy';
import { getPublishedActivities, ACTIVITIES_PAGE_SIZE, type PublishedActivityCard } from '@lib/activities/activities';
import { isBlockTypeFilter, isSortOrder, type BlockTypeFilter, type SortOrder } from '@lib/activities/discoveryQuery';
import { pickDailyActivity } from '@lib/activities/dailyPick';
import { ROW_PADDING_X } from '@lib/ui/layout';
import { ICON_TOOLTIP_BUBBLE_CLASS, ICON_TOOLTIP_TRIGGER_CLASS } from '@lib/ui/iconTooltip';
import { loadDeskSceneData } from '@lib/ingles/deskSceneData';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const t = UI_LABELS[lang].activities.explore;
const levelLabels = UI_LABELS[lang].english.levels;
const user = Astro.locals.user;
const isGuest = user === null;
const viewerId = user?.id ?? null;

// Every filter defaults to "off"/"none" for an invalid or absent value — the
// same lenient posture the level filter already had: a bad URL shows the
// unfiltered feed rather than 404ing, because every one of these params is a
// plain link/form field a visitor can always get back to.
const nivelParam = Astro.url.searchParams.get('nivel');
const activeLevel = isLevel(nivelParam) ? nivelParam : null;

const tipoParam = Astro.url.searchParams.get('tipo');
const activeTipo: BlockTypeFilter | null = isBlockTypeFilter(tipoParam) ? tipoParam : null;

const ordenParam = Astro.url.searchParams.get('orden');
const orden: SortOrder = isSortOrder(ordenParam) ? ordenParam : 'recientes';

const rawQuery = Astro.url.searchParams.get('q');
const activeQuery = rawQuery && rawQuery.trim().length > 0 ? rawQuery.trim() : null;

const novistas = Astro.url.searchParams.get('novistas') === '1';

const pageParam = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const requestedPage = Number.isFinite(pageParam) && pageParam >= 1 ? pageParam : 1;

const anyFilterActive = activeLevel !== null || activeTipo !== null || activeQuery !== null || novistas;

const { activities, total } = await getPublishedActivities({
  level: activeLevel,
  page: requestedPage,
  q: activeQuery,
  tipo: activeTipo,
  orden,
  novistas,
  viewerId,
});
const totalPages = Math.max(1, Math.ceil(total / ACTIVITIES_PAGE_SIZE));
// A page beyond the last one still renders (empty grid + pagination back to
// the real range) rather than 404ing — the same "URL always answers" rule
// `/[lang]/ingles/index.astro` follows for an empty level.
const currentPage = Math.min(requestedPage, totalPages);

// "Actividad del día" candidates: the top 20 live activities by heart count
// — exactly `getPublishedActivities`' own page size under `orden=gustadas`,
// so no separate query shape is needed for it. Fetched (and shown) only on
// page 1 with nothing else filtering the feed.
const showDailyPick = currentPage === 1 && !anyFilterActive;
let dailyPick: PublishedActivityCard | null = null;
if (showDailyPick) {
  const candidates = await getPublishedActivities({ level: null, page: 1, orden: 'gustadas', viewerId });
  dailyPick = pickDailyActivity(candidates.activities, new Date());
}

const basePath = `/${lang}/ingles/actividades`;

/** Build `/[lang]/ingles/actividades` with the CURRENT filters plus `overrides`, omitting any param at its default. */
function buildHref(overrides: { page?: number } = {}): string {
  const params = new URLSearchParams();
  if (activeLevel) params.set('nivel', activeLevel);
  if (activeQuery) params.set('q', activeQuery);
  if (activeTipo) params.set('tipo', activeTipo);
  if (orden !== 'recientes') params.set('orden', orden);
  if (novistas) params.set('novistas', '1');
  const page = overrides.page ?? currentPage;
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return `${basePath}${qs ? `?${qs}` : ''}`;
}

/** nivel/tipo/orden(!=default)/novistas only — never q, never page. Shared by
 * SearchFilter's `preserve` prop, the filters panel's active count, and the
 * chip row's "drop just this one" hrefs. */
const activeFilterParams: Record<string, string> = {};
if (activeLevel) activeFilterParams.nivel = activeLevel;
if (activeTipo) activeFilterParams.tipo = activeTipo;
if (orden !== 'recientes') activeFilterParams.orden = orden;
if (novistas) activeFilterParams.novistas = '1';

/** `basePath` with the current `q` plus every active filter EXCEPT `omit` — one chip's own "remove me" link. */
function hrefWithoutFilter(omit: keyof typeof activeFilterParams): string {
  const params = new URLSearchParams();
  if (activeQuery) params.set('q', activeQuery);
  for (const [key, value] of Object.entries(activeFilterParams)) {
    if (key === omit) continue;
    params.set(key, value);
  }
  const qs = params.toString();
  return `${basePath}${qs ? `?${qs}` : ''}`;
}

// The panel's own "Limpiar": keeps `q`, drops every filter — plain link, no JS.
const panelClearHref = (() => {
  const params = new URLSearchParams();
  if (activeQuery) params.set('q', activeQuery);
  const qs = params.toString();
  return `${basePath}${qs ? `?${qs}` : ''}`;
})();

const TYPE_OPTIONS: Array<{ value: BlockTypeFilter | ''; label: string }> = [
  { value: '', label: t.typeAll },
  { value: 'worksheet', label: t.typeWorksheet },
  { value: 'quiz', label: t.typeQuiz },
];

const levelOptions = [
  { value: '', label: t.allLevels, selected: activeLevel === null },
  ...LEVELS.map((lvl) => ({
    value: lvl,
    label: `${lvl} · ${levelLabels[lvl]}`,
    selected: activeLevel === lvl,
  })),
];

const typeOptions = TYPE_OPTIONS.map((opt) => ({
  value: opt.value,
  label: opt.label,
  selected: activeTipo === (opt.value || null),
}));

const sortOptions = [
  { value: 'recientes', label: t.sortRecientes, selected: orden === 'recientes' },
  { value: 'gustadas', label: t.sortGustadas, selected: orden === 'gustadas' },
  { value: 'vistas', label: t.sortVistas, selected: orden === 'vistas' },
];

/** One removable chip per active filter, in a fixed order. */
const chips: Array<{ key: keyof typeof activeFilterParams; label: string; href: string }> = [];
if (activeLevel) chips.push({ key: 'nivel', label: activeLevel, href: hrefWithoutFilter('nivel') });
if (activeTipo) {
  chips.push({
    key: 'tipo',
    label: activeTipo === 'worksheet' ? t.typeWorksheet : t.typeQuiz,
    href: hrefWithoutFilter('tipo'),
  });
}
if (orden !== 'recientes') {
  chips.push({
    key: 'orden',
    label: orden === 'gustadas' ? t.sortGustadas : t.sortVistas,
    href: hrefWithoutFilter('orden'),
  });
}
if (novistas) chips.push({ key: 'novistas', label: t.novistasChip, href: hrefWithoutFilter('novistas') });

/**
 * The window's red/yellow lights ("desktop" redesign, same pattern
 * `[id].astro`'s own header documents): the Inglés hub/desk for a
 * signed-in visitor, the ChuyoCode home for a guest.
 */
const closeHref = isGuest ? `/${lang}/` : `/${lang}/ingles`;

/**
 * The desk behind the window — SIGNED-IN visitors only, same loader/
 * component the hub and the practice window use. In production `isGuest`
 * is always `false` here (the middleware already redirects an anonymous
 * visitor away from every `ingles/**` route before this page ever runs),
 * so this branch exists only for parity with `[id].astro` and the TEMP
 * local-dev screenshot override.
 */
const desk = isGuest
  ? null
  : await loadDeskSceneData({ lang, user, geo: Astro.locals.netlify?.context?.geo });
const deskLabels = desk && {
  greetingQuestion: UI_LABELS[lang].english.hub.greetingQuestion,
  greetingSubtitle: UI_LABELS[lang].english.hub.greetingSubtitle,
  foldersLabel: UI_LABELS[lang].english.hub.foldersLabel,
  communityTitle: UI_LABELS[lang].english.hub.communityTitle,
  todayTitle: UI_LABELS[lang].english.hub.todayTitle,
  createActivityLabel: UI_LABELS[lang].activities.start.pageTitle,
  widgetsLabel: UI_LABELS[lang].english.hub.widgetsLabel,
  weatherUnavailable: UI_LABELS[lang].english.hub.weatherUnavailable,
  weatherAttribution: UI_LABELS[lang].english.hub.weatherAttribution,
  levelShortcutTitle: UI_LABELS[lang].english.hub.levelShortcutTitle,
};

/** Minimize-to-tray (`@lib/ui/minimizedWindows`): ONE stable id for this
 * window regardless of its current filters — re-minimizing it just moves
 * the same chip back to the front with its latest `href` (current path +
 * query), rather than stacking a separate chip per filter combination. */
const COMMUNITY_TRAY_ID = 'community-activities';

const createActivityLabel = UI_LABELS[lang].activities.start.pageTitle;
---

<BaseLayout lang={lang} title={t.pageTitle} description={t.pageDescription} theme="ingles" deskBehind={!isGuest}>
  {desk && deskLabels && (
    <DeskScene
      lang={lang}
      greetingLine1={desk.greetingLine1}
      activityCountLabel={desk.activityCountLabel}
      dailyPickHref={desk.dailyPickHref}
      dailyPickMeta={desk.dailyPickMeta}
      dailyPickPeek={desk.dailyPickPeek}
      weatherLat={desk.weatherLat}
      weatherLon={desk.weatherLon}
      weatherCity={desk.weatherCity}
      weatherLabel={desk.weatherLabel}
      playerLabels={desk.playerLabels}
      levelLabels={levelLabels}
      labels={deskLabels}
    />
  )}

  <DeskWindow
    lang={lang}
    title={UI_LABELS[lang].english.hub.communityTitle}
    closeHref={closeHref}
    closeLabel={t.windowClose}
    minimizeLabel={t.windowMinimize}
    fullScreenLabel={t.windowFullScreen}
    forceFullScreen={isGuest}
    trayId={isGuest ? null : COMMUNITY_TRAY_ID}
    slot="overlay"
  >
    <Fragment slot="actions">
      <SearchFilter
        mode="server"
        action={basePath}
        value={activeQuery ?? ''}
        label={t.searchLabel}
        preserve={activeFilterParams}
      />
      <CommunityFiltersPanel
        lang={lang}
        action={basePath}
        triggerLabel={t.filtersToggle}
        activeCount={chips.length}
        applyLabel={t.applyFilters}
        clearLabel={t.panelClear}
        clearHref={panelClearHref}
        levelSelectLabel={t.levelLabel}
        levelOptions={levelOptions}
        typeSelectLabel={t.typeLabel}
        typeOptions={typeOptions}
        sortSelectLabel={t.sortLabel}
        sortOptions={sortOptions}
        showNovistas={viewerId !== null}
        novistasChecked={novistas}
        novistasLabel={t.novistasLabel}
        query={activeQuery ?? ''}
      />
      {/* "+" (owner spec: a small create-activity shortcut right in this
          window's own title bar) — same folder-origin scale-in the hub's
          own "Crear actividad" tile uses (`data-desk-window-open="create"`,
          `@lib/ui/deskWindow.ts`'s opener wiring), so opening the creator
          FROM this window feels the same as opening it from the desk. */}
      <a
        href={`/${lang}/crear`}
        data-desk-window-open="create"
        data-testid="community-create-link"
        aria-label={createActivityLabel}
        aria-describedby="action-create-tooltip"
        class={ICON_TOOLTIP_TRIGGER_CLASS}
      >
        <PlusIcon aria-hidden="true" size={16} />
        <span role="tooltip" id="action-create-tooltip" class={ICON_TOOLTIP_BUBBLE_CLASS}>
          {createActivityLabel}
        </span>
      </a>
    </Fragment>

    {
      chips.length > 0 && (
        <ul
          class={`flex flex-none flex-wrap gap-2 border-b border-border ${ROW_PADDING_X} py-3`}
          data-testid="active-filter-chips"
        >
          {chips.map((chip) => (
            <li>
              <a
                href={chip.href}
                data-testid={`filter-chip-${chip.key}`}
                class="inline-flex items-center gap-1 rounded-full border border-border bg-surface-soft px-3 py-1 text-xs text-muted-foreground hover:border-accent-ink hover:text-accent-ink"
              >
                {chip.label} <span aria-hidden="true">&times;</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {/* The scrollable body — grid + pagination together, so pagination
        always sits at the bottom of whatever is currently on screen,
        never pinned outside the window's own scroll. */}
    <div class="flex-1 overflow-y-auto">
      <div class={`flex flex-col gap-6 ${ROW_PADDING_X} py-6`}>
        {
          activities.length === 0 && !(showDailyPick && dailyPick) ? (
            <div
              class="flex flex-col items-start gap-3 rounded-lg border border-border bg-surface-soft p-6 text-muted-foreground"
              data-testid="community-empty-state"
            >
              {/* Emoji sticker accent (visual-identity decision, 2026-10-04) — purely decorative, next to the empty message below. */}
              <Emoji name="llama" size={48} />
              <p>{anyFilterActive ? t.emptyFiltered : t.empty}</p>
              {anyFilterActive && (
                <a
                  href={basePath}
                  data-testid="community-clear-filters"
                  class="text-sm font-medium text-accent-ink hover:underline"
                >
                  {t.clearFilters}
                </a>
              )}
            </div>
          ) : (
            <>
              <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {/* The daily pick is the grid's first card, same size as the rest
                    (a full-width banner took too much room), and is not repeated
                    further down the list. */}
                {showDailyPick && dailyPick && (
                  <li>
                    <ActivityCard
                      lang={lang}
                      activity={dailyPick}
                      levelLabels={levelLabels}
                      noLevel={t.noLevel}
                      blockCountOne={t.blockCountOne}
                      blockCountMany={t.blockCountMany}
                      viewedLabel={t.viewedBadge}
                      highlighted
                      highlightLabel={t.dailyPickLabel}
                    />
                  </li>
                )}
                {activities.filter((activity) => !(showDailyPick && dailyPick && activity.id === dailyPick.id)).map((activity) => (
                  <li>
                    <ActivityCard
                      lang={lang}
                      activity={activity}
                      levelLabels={levelLabels}
                      noLevel={t.noLevel}
                      blockCountOne={t.blockCountOne}
                      blockCountMany={t.blockCountMany}
                      viewedLabel={t.viewedBadge}
                    />
                  </li>
                ))}
              </ul>

              {totalPages > 1 && (
                <nav class="flex items-center justify-between gap-4" aria-label={t.pagination}>
                  {currentPage > 1 ? (
                    <a href={buildHref({ page: currentPage - 1 })} class={buttonVariants({ variant: 'outline' })}>
                      {t.prevPage}
                    </a>
                  ) : (
                    <span class={buttonVariants({ variant: 'outline' })} aria-disabled="true">
                      {t.prevPage}
                    </span>
                  )}
                  <span class="text-sm text-muted-foreground tabular-nums">
                    {t.pageLabel} {currentPage} {t.ofLabel} {totalPages}
                  </span>
                  {currentPage < totalPages ? (
                    <a href={buildHref({ page: currentPage + 1 })} class={buttonVariants({ variant: 'outline' })}>
                      {t.nextPage}
                    </a>
                  ) : (
                    <span class={buttonVariants({ variant: 'outline' })} aria-disabled="true">
                      {t.nextPage}
                    </span>
                  )}
                </nav>
              )}
            </>
          )
        }
      </div>
    </div>
  </DeskWindow>
</BaseLayout>

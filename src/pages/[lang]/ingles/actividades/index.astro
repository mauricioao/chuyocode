---
/**
 * Public feed of community activities — `/[lang]/ingles/actividades` (SSR,
 * "Descubrir"/discovery). LIVE activities only (`visible`), filterable by
 * search (`?q=`), CEFR level (`?nivel=`), block type (`?tipo=`), and whether
 * the viewer has already seen them (`?novistas=1`), sortable by recency,
 * hearts, or views (`?orden=`), paginated 20/page.
 *
 * Under `ingles/**`, so this route is ALREADY gated and marked
 * private/no-store by the middleware (`@lib/access`'s `GATED_SECTIONS`,
 * `src/middleware.ts`'s own header comment) — no per-page gate or
 * `markPrivate` call is needed here, unlike `/[lang]/crear` or
 * `/[lang]/mis-actividades`, which sit OUTSIDE that section. `Astro.locals.user`
 * is therefore expected non-null (checked defensively anyway, same posture
 * as `[id].astro`'s own `canReport`/`canHeart`).
 *
 * UNIFIED SEARCH HEADER (community-search-unify pass): search now sits in
 * `PageTitle`'s `actions` slot, same spot/visual weight as Libros/Noticias'
 * own `SearchFilter` — the community list is a bigger, gated catalog with
 * MORE facets (level/type/sort/"no las he visto"), so it also gets a compact
 * `CommunityFiltersPanel` (funnel button + popover/sheet) right next to it,
 * instead of the old always-visible filter bar. ALL FILTERS STILL LIVE IN
 * THE URL, as plain GET forms plus plain links (pagination, chips, "Limpiar
 * filtros") — the whole page still works with scripting off, stays
 * deep-linkable, and survives a back-button press. The actual query building
 * (search escaping, sort columns, the `novistas` exclusion) lives in
 * `getPublishedActivities` (`@lib/activities/activities`) and
 * `discoveryQuery.ts`, never here.
 *
 * Active filters (nivel/tipo/orden!=default/novistas) are visible without
 * opening the panel: a row of small removable chips under the title, each a
 * plain link dropping just that one param.
 *
 * "Actividad del día": only on page 1 with NO filters active, a highlighted
 * card picked deterministically for the calendar day
 * (`pickDailyActivity`, `@lib/activities/dailyPick`) among the top 20 live
 * activities by heart count. Hidden entirely when there are no candidates.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import ActivityCard from '@components/ui/ActivityCard.astro';
import Emoji from '@components/ui/Emoji.astro';
import SearchFilter from '@components/ui/SearchFilter.astro';
import CommunityFiltersPanel from '@components/activities/CommunityFiltersPanel.astro';
import { buttonVariants } from '@components/ui/button';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { LEVELS, isLevel } from '@lib/exerciseTaxonomy';
import { getPublishedActivities, ACTIVITIES_PAGE_SIZE, type PublishedActivityCard } from '@lib/activities/activities';
import { isBlockTypeFilter, isSortOrder, type BlockTypeFilter, type SortOrder } from '@lib/activities/discoveryQuery';
import { pickDailyActivity } from '@lib/activities/dailyPick';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const t = UI_LABELS[lang].activities.explore;
const levelLabels = UI_LABELS[lang].english.levels;
const viewerId = Astro.locals.user?.id ?? null;

// Every filter defaults to "off"/"none" for an invalid or absent value — the
// same lenient posture the level filter already had: a bad URL shows the
// unfiltered feed rather than 404ing, because every one of these params is a
// plain link/form field a visitor can always get back to.
const nivelParam = Astro.url.searchParams.get('nivel');
const activeLevel = isLevel(nivelParam) ? nivelParam : null;

const tipoParam = Astro.url.searchParams.get('tipo');
const activeTipo: BlockTypeFilter | null = isBlockTypeFilter(tipoParam) ? tipoParam : null;

const ordenParam = Astro.url.searchParams.get('orden');
const orden: SortOrder = isSortOrder(ordenParam) ? ordenParam : 'recientes';

const rawQuery = Astro.url.searchParams.get('q');
const activeQuery = rawQuery && rawQuery.trim().length > 0 ? rawQuery.trim() : null;

const novistas = Astro.url.searchParams.get('novistas') === '1';

const pageParam = Number.parseInt(Astro.url.searchParams.get('page') ?? '1', 10);
const requestedPage = Number.isFinite(pageParam) && pageParam >= 1 ? pageParam : 1;

const anyFilterActive = activeLevel !== null || activeTipo !== null || activeQuery !== null || novistas;

const { activities, total } = await getPublishedActivities({
  level: activeLevel,
  page: requestedPage,
  q: activeQuery,
  tipo: activeTipo,
  orden,
  novistas,
  viewerId,
});
const totalPages = Math.max(1, Math.ceil(total / ACTIVITIES_PAGE_SIZE));
// A page beyond the last one still renders (empty grid + pagination back to
// the real range) rather than 404ing — the same "URL always answers" rule
// `/[lang]/ingles/index.astro` follows for an empty level.
const currentPage = Math.min(requestedPage, totalPages);

// "Actividad del día" candidates: the top 20 live activities by heart count
// — exactly `getPublishedActivities`' own page size under `orden=gustadas`,
// so no separate query shape is needed for it. Fetched (and shown) only on
// page 1 with nothing else filtering the feed.
const showDailyPick = currentPage === 1 && !anyFilterActive;
let dailyPick: PublishedActivityCard | null = null;
if (showDailyPick) {
  const candidates = await getPublishedActivities({ level: null, page: 1, orden: 'gustadas', viewerId });
  dailyPick = pickDailyActivity(candidates.activities, new Date());
}

const basePath = `/${lang}/ingles/actividades`;

/** Build `/[lang]/ingles/actividades` with the CURRENT filters plus `overrides`, omitting any param at its default. */
function buildHref(overrides: { page?: number } = {}): string {
  const params = new URLSearchParams();
  if (activeLevel) params.set('nivel', activeLevel);
  if (activeQuery) params.set('q', activeQuery);
  if (activeTipo) params.set('tipo', activeTipo);
  if (orden !== 'recientes') params.set('orden', orden);
  if (novistas) params.set('novistas', '1');
  const page = overrides.page ?? currentPage;
  if (page > 1) params.set('page', String(page));
  const qs = params.toString();
  return `${basePath}${qs ? `?${qs}` : ''}`;
}

/** nivel/tipo/orden(!=default)/novistas only — never q, never page. Shared by
 * SearchFilter's `preserve` prop, the filters panel's active count, and the
 * chip row's "drop just this one" hrefs. */
const activeFilterParams: Record<string, string> = {};
if (activeLevel) activeFilterParams.nivel = activeLevel;
if (activeTipo) activeFilterParams.tipo = activeTipo;
if (orden !== 'recientes') activeFilterParams.orden = orden;
if (novistas) activeFilterParams.novistas = '1';

/** `basePath` with the current `q` plus every active filter EXCEPT `omit` — one chip's own "remove me" link. */
function hrefWithoutFilter(omit: keyof typeof activeFilterParams): string {
  const params = new URLSearchParams();
  if (activeQuery) params.set('q', activeQuery);
  for (const [key, value] of Object.entries(activeFilterParams)) {
    if (key === omit) continue;
    params.set(key, value);
  }
  const qs = params.toString();
  return `${basePath}${qs ? `?${qs}` : ''}`;
}

// The panel's own "Limpiar": keeps `q`, drops every filter — plain link, no JS.
const panelClearHref = (() => {
  const params = new URLSearchParams();
  if (activeQuery) params.set('q', activeQuery);
  const qs = params.toString();
  return `${basePath}${qs ? `?${qs}` : ''}`;
})();

const TYPE_OPTIONS: Array<{ value: BlockTypeFilter | ''; label: string }> = [
  { value: '', label: t.typeAll },
  { value: 'worksheet', label: t.typeWorksheet },
  { value: 'quiz', label: t.typeQuiz },
];

const levelOptions = [
  { value: '', label: t.allLevels, selected: activeLevel === null },
  ...LEVELS.map((lvl) => ({
    value: lvl,
    label: `${lvl} · ${levelLabels[lvl]}`,
    selected: activeLevel === lvl,
  })),
];

const typeOptions = TYPE_OPTIONS.map((opt) => ({
  value: opt.value,
  label: opt.label,
  selected: activeTipo === (opt.value || null),
}));

const sortOptions = [
  { value: 'recientes', label: t.sortRecientes, selected: orden === 'recientes' },
  { value: 'gustadas', label: t.sortGustadas, selected: orden === 'gustadas' },
  { value: 'vistas', label: t.sortVistas, selected: orden === 'vistas' },
];

/** One removable chip per active filter, in a fixed order. */
const chips: Array<{ key: keyof typeof activeFilterParams; label: string; href: string }> = [];
if (activeLevel) chips.push({ key: 'nivel', label: activeLevel, href: hrefWithoutFilter('nivel') });
if (activeTipo) {
  chips.push({
    key: 'tipo',
    label: activeTipo === 'worksheet' ? t.typeWorksheet : t.typeQuiz,
    href: hrefWithoutFilter('tipo'),
  });
}
if (orden !== 'recientes') {
  chips.push({
    key: 'orden',
    label: orden === 'gustadas' ? t.sortGustadas : t.sortVistas,
    href: hrefWithoutFilter('orden'),
  });
}
if (novistas) chips.push({ key: 'novistas', label: t.novistasChip, href: hrefWithoutFilter('novistas') });
---

<BaseLayout lang={lang} title={t.pageTitle} description={t.pageDescription} theme="ingles">
  <section class="mx-auto flex w-full max-w-5xl flex-col gap-8 px-4 py-8 sm:py-12">
    <header class="flex flex-col gap-3">
      <PageTitle lang={lang} backHref={`/${lang}/ingles`}>
        {t.heading}
        <Fragment slot="actions">
          <div class="flex items-center gap-1">
            <SearchFilter
              mode="server"
              action={basePath}
              value={activeQuery ?? ''}
              label={t.searchLabel}
              preserve={activeFilterParams}
            />
            <CommunityFiltersPanel
              lang={lang}
              action={basePath}
              triggerLabel={t.filtersToggle}
              activeCount={chips.length}
              applyLabel={t.applyFilters}
              clearLabel={t.panelClear}
              clearHref={panelClearHref}
              levelSelectLabel={t.levelLabel}
              levelOptions={levelOptions}
              typeSelectLabel={t.typeLabel}
              typeOptions={typeOptions}
              sortSelectLabel={t.sortLabel}
              sortOptions={sortOptions}
              showNovistas={viewerId !== null}
              novistasChecked={novistas}
              novistasLabel={t.novistasLabel}
              query={activeQuery ?? ''}
            />
          </div>
        </Fragment>
      </PageTitle>

      {
        chips.length > 0 && (
          <ul class="flex flex-wrap gap-2" data-testid="active-filter-chips">
            {chips.map((chip) => (
              <li>
                <a
                  href={chip.href}
                  data-testid={`filter-chip-${chip.key}`}
                  class="inline-flex items-center gap-1 rounded-full border border-border bg-surface-soft px-3 py-1 text-xs text-zinc-300 hover:border-accent-ink hover:text-accent-ink"
                >
                  {chip.label} <span aria-hidden="true">&times;</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    {
      activities.length === 0 && !(showDailyPick && dailyPick) ? (
        <div class="flex flex-col items-start gap-3 rounded-lg border border-border bg-surface-soft p-6 text-zinc-300">
          {/* Emoji sticker accent (visual-identity decision, 2026-10-04) — purely decorative, next to the empty message below. */}
          <Emoji name="llama" size={48} />
          <p>{anyFilterActive ? t.emptyFiltered : t.empty}</p>
          {anyFilterActive && (
            <a href={basePath} class="text-sm font-medium text-accent-ink hover:underline">
              {t.clearFilters}
            </a>
          )}
        </div>
      ) : (
        <>
          <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {/* The daily pick is the grid's first card, same size as the rest
                (a full-width banner took too much room), and is not repeated
                further down the list. */}
            {showDailyPick && dailyPick && (
              <li>
                <ActivityCard
                  lang={lang}
                  activity={dailyPick}
                  levelLabels={levelLabels}
                  noLevel={t.noLevel}
                  blockCountOne={t.blockCountOne}
                  blockCountMany={t.blockCountMany}
                  viewedLabel={t.viewedBadge}
                  highlighted
                  highlightLabel={t.dailyPickLabel}
                />
              </li>
            )}
            {activities.filter((activity) => !(showDailyPick && dailyPick && activity.id === dailyPick.id)).map((activity) => (
              <li>
                <ActivityCard
                  lang={lang}
                  activity={activity}
                  levelLabels={levelLabels}
                  noLevel={t.noLevel}
                  blockCountOne={t.blockCountOne}
                  blockCountMany={t.blockCountMany}
                  viewedLabel={t.viewedBadge}
                />
              </li>
            ))}
          </ul>

          {totalPages > 1 && (
            <nav class="flex items-center justify-between gap-4" aria-label={t.pagination}>
              {currentPage > 1 ? (
                <a href={buildHref({ page: currentPage - 1 })} class={buttonVariants({ variant: 'outline' })}>
                  {t.prevPage}
                </a>
              ) : (
                <span class={buttonVariants({ variant: 'outline' })} aria-disabled="true">
                  {t.prevPage}
                </span>
              )}
              <span class="text-sm text-zinc-400 tabular-nums">
                {t.pageLabel} {currentPage} {t.ofLabel} {totalPages}
              </span>
              {currentPage < totalPages ? (
                <a href={buildHref({ page: currentPage + 1 })} class={buttonVariants({ variant: 'outline' })}>
                  {t.nextPage}
                </a>
              ) : (
                <span class={buttonVariants({ variant: 'outline' })} aria-disabled="true">
                  {t.nextPage}
                </span>
              )}
            </nav>
          )}
        </>
      )
    }
  </section>
</BaseLayout>

---
/**
 * Practice page — `/[lang]/ingles/actividades/[id]` (SSR, PR D "Activities
 * practice"; rebuilt as the "practice player" in the "practice player
 * redesign" pass). Loads the activity + its PUBLISHED revision in one round
 * trip (`getPublishedActivity`, `@lib/activities/activities`) and 404s for
 * anything not `visible` — including the AUTHOR'S OWN non-live activity:
 * this route is the public player, not a preview, and an author checking
 * their own draft/pending work already has the editor's own preview mode
 * (`WorksheetPlayer`'s creator-preview, unchanged from PR B) for that.
 *
 * Under `ingles/**`, so this route is marked private/no-store by the
 * middleware exactly like every other gated page — same posture as
 * `/[lang]/ingles/actividades/index.astro`'s own header, no per-page
 * `markPrivate` call needed here. It is NOT, however, sign-in gated anymore:
 * `@lib/access`'s `isPublicActivityRoute` carves this route (and its sibling
 * `presentar.astro`) out of the login wall for guest play (owner-approved —
 * a teacher's QR/WhatsApp link must not hit a login screen in class). The
 * `getPublishedActivity` 404 above is what actually protects a non-live
 * activity from an anonymous visitor — same 404 the author's own non-live
 * activity already gets, so there is nothing extra to gate here.
 *
 * ANONYMOUS VISITOR ("guest"): `user` below is `null`. `canHeart`/`canReport`/
 * `canDuplicate` were already `false` for a `null` user before this feature
 * (defensive, since the page used to be unreachable anonymously) — now that
 * they are reachable in practice, each one grows a GUEST fallback: a plain
 * link to sign-in (carrying `next` back to this exact page) instead of the
 * interactive island. `ActivityViewBadge` (the per-user "Ya lo viste" badge)
 * is skipped entirely for a guest — no island, no `visto` request — and a
 * short, friendly line invites them to create a free account.
 *
 * "DESKTOP" REDESIGN PART 6a (owner spec 2026-10-06, "la dirección cambia
 * por detrás, pero vos nunca salís del escritorio"): this page keeps its own
 * REAL url — QR codes, shared WhatsApp links, guest play, the sitemap and
 * the browser back button all depend on it staying a real route — but it now
 * RENDERS as a WINDOW over the desk (`DeskWindow.astro`). For a SIGNED-IN
 * visitor, the desk itself renders behind it (`DeskScene.astro`, the exact
 * same component/data the hub uses — `@lib/ingles/deskSceneData` — so a
 * direct visit shows a real desk, not a blank one) and is `inert` while the
 * window is open; `transition:persist`-ed (inside `DeskScene.astro` itself)
 * so a hub -> practice -> hub round trip via Astro's ClientRouter keeps its
 * DOM (widget positions, drag state) instead of discarding and re-rendering
 * it. For a GUEST — who cannot see the gated hub at all — no desk renders
 * behind the window; its red light goes to the ChuyoCode home instead of the
 * hub, since the hub would only ask them to sign in.
 *
 * The compact header row this page used to own (back button, title, level
 * meta, heart/report/etc. actions) is now the window's own title bar: the
 * three "traffic light" buttons replace the back button (close/minimize both
 * return to the desk), the title + a level chip sit beside them, and hearts +
 * every icon action move into the title bar's own `actions` slot. The level/
 * view-count meta line, the guest banner, and the "Basado en" credit line
 * stay as plain rows inside the window BODY, directly above the worksheet/
 * quiz tabs + canvas + footer (`ActivityPracticeIsland`, unchanged).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import DeskScene from '@components/ingles/DeskScene.astro';
import DeskWindow from '@components/ingles/DeskWindow.astro';
import ActivityPracticeIsland from '@components/islands/activities/ActivityPracticeIsland';
import ActivityViewBadge from '@components/islands/activities/ActivityViewBadge';
import ReportActivityButton from '@components/islands/activities/ReportActivityButton';
import HeartButton from '@components/islands/activities/HeartButton';
import DuplicateActivityButton from '@components/islands/activities/DuplicateActivityButton';
import ShareDialog from '@components/islands/ShareDialog';
import { HeartIcon } from '@phosphor-icons/react/dist/ssr/Heart';
import { PrinterIcon } from '@phosphor-icons/react/dist/ssr/Printer';
import { PresentationIcon } from '@phosphor-icons/react/dist/ssr/Presentation';
import { FlagIcon } from '@phosphor-icons/react/dist/ssr/Flag';
import { CopySimpleIcon } from '@phosphor-icons/react/dist/ssr/CopySimple';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getPublishedActivity } from '@lib/activities/activities';
import { hasPresentableContent } from '@lib/activities/presentationSlides';
import { ROW_PADDING_X } from '@lib/ui/layout';
import { hasHeartedActivity } from '@lib/activities/hearts';
import { qrSvg, shareUrl } from '@lib/qr';
import { ICON_TOOLTIP_BUBBLE_CLASS, ICON_TOOLTIP_TRIGGER_CLASS } from '@lib/ui/iconTooltip';
import { loadDeskSceneData } from '@lib/ingles/deskSceneData';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const activity = await getPublishedActivity(id);
if (!activity) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const t = UI_LABELS[lang].activities.practice;
const levelLabels = UI_LABELS[lang].english.levels;

// Hidden for the activity's own author, and for an anonymous visitor (now a
// real case, not just a defensive one — this route is guest-playable, see
// file header). The endpoint refuses both cases again server-side
// (`recordReport`'s header); this only decides whether the island is
// mounted at all. A `null` user gets its OWN fallback below (a sign-in
// link), separate from the author's read-only span.
const user = Astro.locals.user;
const isGuest = user === null;
const canReport = user !== null && user.id !== activity.authorId;
// Same gate as `canReport`: an author cannot heart their own activity
// either (`toggleActivityHeart`'s own header) — this decides whether the
// interactive island mounts at all; the read-only count badge covers the
// author, and a guest gets its own clickable fallback (below) instead.
const canHeart = user !== null && user.id !== activity.authorId;
// One extra indexed lookup (`activity_hearts`'s own primary key), in the
// same loader as the rest of this page's data — see `hasHeartedActivity`'s
// own header.
const hearted = canHeart ? await hasHeartedActivity(activity.id, user!.id) : false;

// "Duplicar y adaptar" (D7): every signed-in visitor, author included — see
// `DuplicateActivityButton`'s own header for why this gate differs from
// `canHeart`/`canReport` above. `!canDuplicate` is exactly "no user" here
// (never the author), so its fallback below is unconditionally the guest one.
const canDuplicate = user !== null;

/**
 * Guest play: where "sign in to do this" sends an anonymous visitor —
 * straight back to THIS exact page (`next`) once they are signed in. Built
 * from `Astro.url`, never from attacker-controlled input, so it skips the
 * `safeNextPath` guard `entrar.astro` applies to a query-string `next` — this
 * one is already a same-origin path by construction.
 */
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const guestSignInHref = `/${lang}/auth/entrar?next=${encodeURIComponent(currentPath)}`;
/** Same destination, preselecting sign-up — the guest banner's own CTA. */
const guestSignUpHref = `/${lang}/auth/entrar?mode=signup&next=${encodeURIComponent(currentPath)}`;

/**
 * The window's red/yellow lights ("desktop" redesign PART 6a): the Inglés
 * hub for a signed-in visitor, the ChuyoCode home for a guest — whose hub
 * would only ask them to sign in (see file header). `@lib/ui/deskWindow.ts`
 * decides client-side whether this becomes a plain navigation or a
 * `history.back()` (when the referrer is already exactly this path).
 */
const closeHref = isGuest ? `/${lang}/` : `/${lang}/ingles`;

/** "A2 · Básico", or the "no level" copy — the title bar's own chip always renders, never conditionally omitted (same two states the old meta line already had). */
const levelChip = activity.level ? `${activity.level} · ${levelLabels[activity.level]}` : t.noLevel;

/**
 * The desk behind the window — SIGNED-IN visitors only. A guest cannot see
 * the gated hub at all (`@lib/access#requiresLogin`), so no desk renders for
 * them; the window opens over a plain background instead (see file header).
 * Same loader, same data the hub itself uses — never a second, drifting copy.
 */
const desk = isGuest
  ? null
  : await loadDeskSceneData({ lang, user, geo: Astro.locals.netlify?.context?.geo });
const deskLabels = desk && {
  greetingQuestion: UI_LABELS[lang].english.hub.greetingQuestion,
  greetingSubtitle: UI_LABELS[lang].english.hub.greetingSubtitle,
  foldersLabel: UI_LABELS[lang].english.hub.foldersLabel,
  proposedTitle: UI_LABELS[lang].english.hub.proposedTitle,
  communityTitle: UI_LABELS[lang].english.hub.communityTitle,
  todayTitle: UI_LABELS[lang].english.hub.todayTitle,
  createActivityLabel: UI_LABELS[lang].activities.start.pageTitle,
  widgetsLabel: UI_LABELS[lang].english.hub.widgetsLabel,
  weatherUnavailable: UI_LABELS[lang].english.hub.weatherUnavailable,
  levelShortcutTitle: UI_LABELS[lang].english.hub.levelShortcutTitle,
};

/**
 * "Presentar": shown whenever the activity has anything presentation mode
 * can show — a quiz question OR a worksheet zone (`hasPresentableContent`,
 * shared with `presentar.astro`'s own defensive 404,
 * `@lib/activities/presentationSlides`; broadened from the quiz-only
 * `hasPresentableQuiz` sprint week 3's worksheet zoom tour) — the single
 * source of truth for that, so this button's visibility can never drift
 * from what the route itself would actually serve.
 */
const canPresent = hasPresentableContent(activity.blocks);

function heartsLabel(count: number): string {
  return `${count} ${count === 1 ? t.heartsOne : t.heartsMany}`;
}

/**
 * "Compartir" (D8): built on the server exactly like the curated exercise
 * page (`[slug].astro`'s own header) — `Astro.url` follows whatever host
 * actually served the page (production, a branch deploy, a Netlify
 * preview), and generating the QR here means the dialog needs no network at
 * all once it opens, and no third party ever learns which activities get
 * shared.
 */
const shareLink = shareUrl(Astro.url);
const shareQr = qrSvg(shareLink);
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${activity.title} ${shareLink}`)}`;

/**
 * The duplicate's own credit line (D7): "Basado en «original»", linking to
 * the source ONLY while it is still live — a source later unpublished or
 * removed keeps the title (honest about provenance) but stops being a dead
 * link. The ORIGINAL's own practice page shows nothing extra (task's own
 * "keep it simple" instruction) — this activity's `source` is `null` unless
 * IT is the duplicate.
 */
const sourceHref = activity.source?.visible ? `/${lang}/ingles/actividades/${activity.source.id}` : null;
---

<BaseLayout lang={lang} title={activity.title} description={t.pageDescription} theme="ingles" deskBehind={!isGuest}>
  {desk && deskLabels && (
    <DeskScene
      lang={lang}
      inert
      greetingLine1={desk.greetingLine1}
      exerciseCountLabel={desk.exerciseCountLabel}
      activityCountLabel={desk.activityCountLabel}
      dailyPickHref={desk.dailyPickHref}
      dailyPickMeta={desk.dailyPickMeta}
      dailyPickPeek={desk.dailyPickPeek}
      weatherLat={desk.weatherLat}
      weatherLon={desk.weatherLon}
      weatherCity={desk.weatherCity}
      weatherLabel={desk.weatherLabel}
      playerLabels={desk.playerLabels}
      levelLabels={levelLabels}
      labels={deskLabels}
    />
  )}

  <DeskWindow
    lang={lang}
    title={activity.title}
    levelChip={levelChip}
    closeHref={closeHref}
    closeLabel={t.windowClose}
    minimizeLabel={t.windowMinimize}
    fullScreenLabel={t.windowFullScreen}
    forceFullScreen={isGuest}
  >
    <Fragment slot="actions">
      {canHeart ? (
        <HeartButton client:load lang={lang} activityId={activity.id} heartCount={activity.heartCount} hearted={hearted} />
      ) : user ? (
        <span class="inline-flex items-center gap-1.5 text-sm text-muted-foreground" data-testid="activity-heart-readonly">
          <HeartIcon aria-hidden="true" />
          <span class="sr-only">{heartsLabel(activity.heartCount)}</span>
          <span class="tabular-nums" aria-hidden="true">{activity.heartCount}</span>
        </span>
      ) : (
        /* Guest: the count is visible, same as the author's read-only
           span, but clicking leads to sign-in (`next` back to this
           page) instead of doing nothing. */
        <a
          href={guestSignInHref}
          class="inline-flex items-center gap-1.5 text-sm text-muted-foreground transition-colors hover:text-foreground"
          data-testid="activity-heart-guest"
        >
          <HeartIcon aria-hidden="true" />
          <span class="sr-only">{heartsLabel(activity.heartCount)}</span>
          <span class="tabular-nums" aria-hidden="true">{activity.heartCount}</span>
        </a>
      )}
      {
        shareQr && (
          <ShareDialog
            client:idle
            url={shareLink}
            qr={shareQr}
            whatsappHref={whatsappHref}
            downloadFileName={`${activity.id}.svg`}
            iconOnly
            labels={{
              trigger: t.share,
              title: t.shareTitle,
              hint: t.shareHint,
              link: t.shareLink,
              copy: t.shareCopy,
              copied: t.shareCopied,
              linkCopiedToast: UI_LABELS[lang].common.toast.linkCopied,
              qrAlt: t.shareQrAlt,
              whatsapp: t.shareWhatsapp,
              downloadQr: t.shareDownloadQr,
              native: t.shareNative,
            }}
          />
        )
      }
      {canDuplicate ? (
        <DuplicateActivityButton client:load lang={lang} activityId={activity.id} />
      ) : (
        /* Guest: `canDuplicate` is exactly "no user" here (the author
           keeps the real button) — a plain link to sign-in instead. */
        <a
          href={guestSignInHref}
          data-testid="activity-duplicate-guest"
          aria-label={t.duplicate}
          aria-describedby="action-duplicate-guest-tooltip"
          class={ICON_TOOLTIP_TRIGGER_CLASS}
        >
          <CopySimpleIcon aria-hidden="true" size={16} />
          <span role="tooltip" id="action-duplicate-guest-tooltip" class={ICON_TOOLTIP_BUBBLE_CLASS}>
            {t.duplicate}
          </span>
        </a>
      )}
      {canReport ? (
        <ReportActivityButton client:load lang={lang} activityId={activity.id} />
      ) : (
        !user && (
          /* Guest: the author still sees nothing (cannot report their
             own activity) — only a `null` user gets this fallback. */
          <a
            href={guestSignInHref}
            data-testid="activity-report-guest"
            aria-label={UI_LABELS[lang].activities.report.button}
            aria-describedby="action-report-guest-tooltip"
            class={ICON_TOOLTIP_TRIGGER_CLASS}
          >
            <FlagIcon aria-hidden="true" size={16} />
            <span role="tooltip" id="action-report-guest-tooltip" class={ICON_TOOLTIP_BUBBLE_CLASS}>
              {UI_LABELS[lang].activities.report.button}
            </span>
          </a>
        )
      )}
      {/* "Presentar" (presentation mode v1): a plain link to the
          full-screen, projector-facing deck — same access rules as this
          page, and hidden entirely when there is nothing to present
          (`canPresent`, above). */}
      {canPresent && (
        <a
          href={`/${lang}/ingles/actividades/${activity.id}/presentar`}
          data-testid="activity-present-link"
          aria-label={t.present}
          aria-describedby="action-present-tooltip"
          class={ICON_TOOLTIP_TRIGGER_CLASS}
        >
          <PresentationIcon aria-hidden="true" size={16} />
          <span role="tooltip" id="action-present-tooltip" class={ICON_TOOLTIP_BUBBLE_CLASS}>
            {t.present}
          </span>
        </a>
      )}
      {/* "Imprimir" (D6): a plain, unconditional link to the print page
          — deliberately NOT exempted from the login wall (guest play is
          scoped to exactly this page and `presentar`, see file header),
          so a guest clicking this one still lands on sign-in, same as
          any other gated page. */}
      <a
        href={`/${lang}/ingles/actividades/${activity.id}/imprimir`}
        data-testid="activity-print-link"
        aria-label={t.print}
        aria-describedby="action-print-tooltip"
        class={ICON_TOOLTIP_TRIGGER_CLASS}
      >
        <PrinterIcon aria-hidden="true" size={16} />
        <span role="tooltip" id="action-print-tooltip" class={ICON_TOOLTIP_BUBBLE_CLASS}>
          {t.print}
        </span>
      </a>
    </Fragment>

    {/* Per-visitor view count + "Basado en" credit line — plain rows
        directly under the title bar, inside the window body (owner-approved
        design keeps these OFF the title bar itself, which only has room for
        lights/title/chip/actions). */}
    {user && (
      <p class={`flex-none border-b border-border text-xs text-muted-foreground ${ROW_PADDING_X} py-1.5`}>
        <ActivityViewBadge client:load lang={lang} activityId={activity.id} />
      </p>
    )}
    {activity.source && (
      <p class={`flex-none border-b border-border text-xs text-muted-foreground ${ROW_PADDING_X} py-1.5`} data-testid="activity-based-on">
        {sourceHref ? (
          <>
            {t.basedOnPrefix}<a href={sourceHref} class="text-accent-ink hover:underline">{activity.source.title}</a>{t.basedOnSuffix}
          </>
        ) : (
          <>{t.basedOnPrefix}{activity.source.title}{t.basedOnSuffix}</>
        )}
      </p>
    )}

    {/* Guest banner (owner-approved copy): a small, friendly line inviting
        an anonymous visitor to create a free account — shown only when
        there is no `user`, right below the header row. */}
    {!user && (
      <p
        data-testid="guest-banner"
        class={`flex-none border-b border-border bg-muted/30 text-xs text-muted-foreground ${ROW_PADDING_X} py-2`}
      >
        {t.guestBanner}{' '}
        <a href={guestSignUpHref} data-testid="guest-sign-up-link" class="font-medium text-accent-ink hover:underline">
          {t.guestSignUp}
        </a>
      </p>
    )}

    <ActivityPracticeIsland client:load lang={lang} blocks={activity.blocks} />
  </DeskWindow>
</BaseLayout>

---
/**
 * Practice page — `/[lang]/ingles/actividades/[id]` (SSR, PR D "Activities
 * practice"; rebuilt as the "practice player" in the "practice player
 * redesign" pass). Loads the activity + its PUBLISHED revision in one round
 * trip (`getPublishedActivity`, `@lib/activities/activities`) and 404s for
 * anything not `visible` — including the AUTHOR'S OWN non-live activity:
 * this route is the public player, not a preview, and an author checking
 * their own draft/pending work already has the editor's own preview mode
 * (`WorksheetPlayer`'s creator-preview, unchanged from PR B) for that.
 *
 * Under `ingles/**`, so this route is ALREADY gated and marked
 * private/no-store by the middleware — same posture as
 * `/[lang]/ingles/actividades/index.astro`'s own header, no per-page gate
 * or `markPrivate` call needed here.
 *
 * ONE FRAMED CARD, `<BaseLayout fullHeight>` (same shape the activity editor
 * already established — `src/pages/[lang]/crear/[id].astro`'s own header):
 * at `lg:` the card is `flex-1 min-h-0`, bordered/rounded, with the site's
 * own header/footer above/below it and NO page-level scroll; below `lg:` the
 * card keeps ordinary document flow. This file owns only the STATIC header
 * row inside the card (back button, title, the level/views meta line,
 * heart/report actions) — everything interactive (tabs, the active block's
 * body, the Comprobar/Reintentar footer) is `ActivityPracticeIsland`, which
 * fills the rest of the card. `ActivityViewBadge` records this view
 * (fire-and-forget, from the client, right after mount — see its own
 * header) and folds "Ya lo viste · N veces" / "Primera vez" into the SAME
 * meta line as the level, once the count comes back.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ActivityPracticeIsland from '@components/islands/activities/ActivityPracticeIsland';
import ActivityViewBadge from '@components/islands/activities/ActivityViewBadge';
import ReportActivityButton from '@components/islands/activities/ReportActivityButton';
import HeartButton from '@components/islands/activities/HeartButton';
import DuplicateActivityButton from '@components/islands/activities/DuplicateActivityButton';
import ShareDialog from '@components/islands/ShareDialog';
import { HeartIcon } from '@phosphor-icons/react/dist/ssr/Heart';
import { ArrowLeftIcon } from '@phosphor-icons/react/dist/ssr/ArrowLeft';
import { PrinterIcon } from '@phosphor-icons/react/dist/ssr/Printer';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getPublishedActivity } from '@lib/activities/activities';
import { hasHeartedActivity } from '@lib/activities/hearts';
import { qrSvg, shareUrl } from '@lib/qr';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const activity = await getPublishedActivity(id);
if (!activity) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const t = UI_LABELS[lang].activities.practice;
const levelLabels = UI_LABELS[lang].english.levels;

// Hidden for the activity's own author and for anonymous visitors (this
// route is already sign-in gated by the middleware, so `user` is expected
// non-null here — the check stays defensive rather than assumed). The
// endpoint refuses both cases again server-side (`recordReport`'s header);
// this only decides whether the island is mounted at all.
const user = Astro.locals.user;
const canReport = user !== null && user.id !== activity.authorId;
// Same gate as `canReport`: an author cannot heart their own activity
// either (`toggleActivityHeart`'s own header) — this decides whether the
// interactive island mounts at all; the read-only count badge covers the
// author (and the defensive anonymous case) instead.
const canHeart = user !== null && user.id !== activity.authorId;
// One extra indexed lookup (`activity_hearts`'s own primary key), in the
// same loader as the rest of this page's data — see `hasHeartedActivity`'s
// own header.
const hearted = canHeart ? await hasHeartedActivity(activity.id, user!.id) : false;

// "Duplicar y adaptar" (D7): every signed-in visitor, author included — see
// `DuplicateActivityButton`'s own header for why this gate differs from
// `canHeart`/`canReport` above.
const canDuplicate = user !== null;

function heartsLabel(count: number): string {
  return `${count} ${count === 1 ? t.heartsOne : t.heartsMany}`;
}

/**
 * "Compartir" (D8): built on the server exactly like the curated exercise
 * page (`[slug].astro`'s own header) — `Astro.url` follows whatever host
 * actually served the page (production, a branch deploy, a Netlify
 * preview), and generating the QR here means the dialog needs no network at
 * all once it opens, and no third party ever learns which activities get
 * shared.
 */
const shareLink = shareUrl(Astro.url);
const shareQr = qrSvg(shareLink);
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${activity.title} ${shareLink}`)}`;

/**
 * The duplicate's own credit line (D7): "Basado en «original»", linking to
 * the source ONLY while it is still live — a source later unpublished or
 * removed keeps the title (honest about provenance) but stops being a dead
 * link. The ORIGINAL's own practice page shows nothing extra (task's own
 * "keep it simple" instruction) — this activity's `source` is `null` unless
 * IT is the duplicate.
 */
const sourceHref = activity.source?.visible ? `/${lang}/ingles/actividades/${activity.source.id}` : null;
---

<BaseLayout lang={lang} title={activity.title} description={t.pageDescription} fullHeight>
  <section class="mx-auto flex w-full max-w-5xl flex-col px-4 py-4 sm:px-6 sm:py-6 lg:h-full lg:min-h-0 lg:py-6">
    {/* THE card: everything below is inside it, one bordered/rounded
        surface at `lg:` — same shape as the activity editor's own card
        (`ActivityEditorIsland.tsx`'s own header). `lg:min-h-0`/`lg:flex-1`
        are the actual "fits the screen, no page scroll" guarantee: this
        header row is `flex-none` (its own intrinsic height), the island
        below it is the only flexible area. */}
    <div
      data-testid="practice-card"
      class="relative flex min-h-0 flex-1 flex-col lg:overflow-hidden lg:rounded-lg lg:border lg:border-border lg:bg-card"
    >
      {/* Compact header row (owner-approved design: "back button, title,
          then a small muted meta line, heart/report on the right — a
          single row, wraps gracefully on narrow widths"). The back button
          here is a plain inline copy of `BackButton.astro`'s own markup
          (brand yellow, `data-back-button` for the site-wide
          `initBackButtons` history.back() enhancement) rather than that
          floating/sticky component: this row already lives INSIDE the
          card at every width, so it needs no gutter-floating behavior. */}
      <div class="flex flex-none flex-wrap items-center gap-3 rounded-lg border border-border p-3 lg:rounded-none lg:border-x-0 lg:border-t-0 lg:border-b">
        <a
          href={`/${lang}/ingles/actividades`}
          data-back-button
          aria-label={t.back}
          title={t.back}
          class="inline-flex h-9 w-9 flex-none items-center justify-center rounded-full bg-primary text-primary-foreground shadow-elevation-2 transition-colors hover:bg-primary/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
        >
          <ArrowLeftIcon size={20} aria-hidden="true" />
        </a>
        <div class="flex min-w-0 flex-1 flex-col">
          <h1 class="truncate text-base font-semibold text-foreground lg:text-lg">{activity.title}</h1>
          {/* The level + view-count meta line (owner-approved design:
              "fold the view badge text into this line"). `ActivityViewBadge`
              renders nothing until its own client fetch resolves, and bakes
              its own leading "· " separator in — see that component's own
              header. */}
          <p class="flex flex-wrap items-center gap-x-1 text-xs text-zinc-400">
            <span>{activity.level ? `${activity.level} · ${levelLabels[activity.level]}` : t.noLevel}</span>
            <ActivityViewBadge client:load lang={lang} activityId={activity.id} />
          </p>
          {/* "Duplicar y adaptar" credit line (D7) — only the DUPLICATE's own
              practice page shows this, once published; the original shows
              nothing extra. */}
          {activity.source && (
            <p class="text-xs text-zinc-400" data-testid="activity-based-on">
              {sourceHref ? (
                <>
                  {t.basedOnPrefix}<a href={sourceHref} class="text-accent hover:underline">{activity.source.title}</a>{t.basedOnSuffix}
                </>
              ) : (
                <>{t.basedOnPrefix}{activity.source.title}{t.basedOnSuffix}</>
              )}
            </p>
          )}
        </div>
        <div class="flex flex-none items-center gap-3">
          {canHeart ? (
            <HeartButton client:load lang={lang} activityId={activity.id} heartCount={activity.heartCount} hearted={hearted} />
          ) : (
            <span class="inline-flex items-center gap-1.5 text-sm text-zinc-400" data-testid="activity-heart-readonly">
              <HeartIcon aria-hidden="true" />
              <span class="sr-only">{heartsLabel(activity.heartCount)}</span>
              <span class="tabular-nums" aria-hidden="true">{activity.heartCount}</span>
            </span>
          )}
          {
            shareQr && (
              <ShareDialog
                client:idle
                url={shareLink}
                qr={shareQr}
                whatsappHref={whatsappHref}
                downloadFileName={`${activity.id}.svg`}
                labels={{
                  trigger: t.share,
                  title: t.shareTitle,
                  hint: t.shareHint,
                  link: t.shareLink,
                  copy: t.shareCopy,
                  copied: t.shareCopied,
                  qrAlt: t.shareQrAlt,
                  whatsapp: t.shareWhatsapp,
                  downloadQr: t.shareDownloadQr,
                  native: t.shareNative,
                  note: t.shareSignInNote,
                }}
              />
            )
          }
          {canDuplicate && <DuplicateActivityButton client:load lang={lang} activityId={activity.id} />}
          {canReport && <ReportActivityButton client:load lang={lang} activityId={activity.id} />}
          {/* "Imprimir" (D6): a plain link to the print-optimized page —
              same access rules as this page (private/no-store, 404 when not
              visible), so no extra gate is needed here either. */}
          <a
            href={`/${lang}/ingles/actividades/${activity.id}/imprimir`}
            data-testid="activity-print-link"
            class="inline-flex h-9 items-center gap-1.5 rounded-full border border-border px-3 text-sm font-medium text-foreground transition-colors hover:bg-muted"
          >
            <PrinterIcon aria-hidden="true" />
            {t.print}
          </a>
        </div>
      </div>

      <ActivityPracticeIsland client:load lang={lang} blocks={activity.blocks} />
    </div>
  </section>
</BaseLayout>

---
/**
 * Presentation page — `/[lang]/ingles/actividades/[id]/presentar`
 * (presentation mode; worksheet zoom tour added sprint week 3). Same access
 * rules as the practice page (`[id].astro`, two levels up):
 * `getPublishedActivity` 404s for anything not `visible`. Additionally 404s
 * when the activity has nothing presentable at all (`hasPresentableContent`,
 * `@lib/activities/presentationSlides` — a quiz question OR a worksheet
 * zone) — the SAME predicate the practice page's own "Presentar" link uses
 * to decide whether to show itself at all, so a direct visit can never
 * reach a stage with nothing to present just because the entry point
 * happened to be hidden.
 *
 * AUTHOR PREVIEW (R1, owner decision 2026-10-12): the author can present
 * their OWN non-live activity too — `getActivityForEdit` is the SAME
 * fallback the practice page falls back to (see its own header on
 * `isAuthorPreview`), tried only once `getPublishedActivity` returns `null`
 * AND a visitor is signed in. Everyone else (anonymous or any other
 * signed-in visitor) still 404s. The one thing this mode must never do is
 * hand out a REAL join QR — that link would 404 for a student, since the
 * activity genuinely is not public — so `qrSvg` is forced to `null` and
 * `PresentationIsland`'s own `qrBlockedMessage` takes over the toggle/"Q"
 * shortcut instead of ever opening the overlay.
 *
 * Under `ingles/**`, so this route is marked private/no-store by the
 * middleware like every other gated page — `markPrivate` is called here
 * anyway, explicitly, same reasoning as the print page (`imprimir.astro`,
 * one level up): this file also builds several early-return `Response`s of
 * its own (invalid lang, missing id, not found) that bypass
 * `Astro.response.headers` entirely and need their own header. It is NOT
 * sign-in gated, though: guest play (owner-approved) carves this route out
 * of the login wall too, alongside `[id].astro` — `@lib/access`'s
 * `isPublicActivityRoute`. The cover QR and Esc both already point at
 * `[id].astro`'s own (now also public) URL.
 *
 * BARE + LIGHT INGLÉS THEME: no site header/footer/nav — `BaseLayout`'s
 * `bare` prop (added for this feature) drops them — and `theme="ingles"`
 * for the warm, light palette the stage renders in (`PresentationIsland`'s
 * own header). `fullHeight` on top keeps the page itself from ever
 * scrolling, belt-and-suspenders alongside the island's own `fixed
 * inset-0` stage (which already covers the whole viewport on its own).
 *
 * EVERY BLOCK, IN AUTHORED ORDER, NOW REACHES THE ISLAND (sprint week 3):
 * the worksheet zoom tour needs a presentable worksheet's own image/zones
 * (answers included — revealing them to a projected class is the whole
 * point, same posture v1 already accepted for quiz answers) to walk its own
 * zones in order. `PresentationIsland`'s own deck builder
 * (`presentationSlides.ts`) is what actually decides which blocks
 * contribute a slide; this route just hands it the full list. Every prop
 * below stays plain, serializable data — see `src/astroIslandProps.test.ts`'s
 * own guard.
 *
 * The QR (D8's own `@lib/qr`, reused verbatim) encodes the activity's
 * PRACTICE page, not this presentation page itself — "scan to open on your
 * phone" means the ordinary player, built from the CURRENT request's own
 * origin exactly like `[id].astro`'s own share QR.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PresentationIsland from '@components/islands/activities/PresentationIsland';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getPublishedActivity, getActivityForEdit } from '@lib/activities/activities';
import { hasPresentableContent } from '@lib/activities/presentationSlides';
import { markPrivate } from '@lib/httpCache';
import { qrSvg, shareUrl } from '@lib/qr';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

markPrivate(Astro.response.headers);

const { id } = Astro.params;
if (!id) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

const user = Astro.locals.user;

let activity = await getPublishedActivity(id);

/**
 * Author preview (R1, owner decision 2026-10-12): same fallback as the
 * practice page (`[id].astro`, two levels up, see its own header) — tried
 * ONLY when `getPublishedActivity` found nothing AND a visitor is signed
 * in. The join QR must never be real for this activity (it would 404 for a
 * student), so `qrBlockedMessage` below replaces it with the owner's own
 * message instead — `isAuthorPreview` is what the markup checks for that.
 */
let isAuthorPreview = false;
let previewStatus: string | null = null;
if (!activity && user) {
  const preview = await getActivityForEdit(id, user.id);
  if (preview) {
    isAuthorPreview = true;
    previewStatus = preview.status;
    activity = {
      id: preview.id,
      title: preview.title,
      level: preview.level,
      blocks: preview.blocks,
      authorId: user.id,
      heartCount: 0,
      viewTotal: 0,
      source: preview.source,
    };
  }
}

if (!activity) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

if (!hasPresentableContent(activity.blocks)) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

const t = UI_LABELS[lang].activities.present;
const practiceUrl = `/${lang}/ingles/actividades/${activity.id}`;
const shareLink = shareUrl(new URL(practiceUrl, Astro.url));
const shareQr = qrSvg(shareLink);

/**
 * Author preview (R1): the real QR/code is never handed to the client at
 * all (`qrSvg={null}` below) — belt-and-suspenders alongside
 * `PresentationIsland`'s own `qrBlockedMessage` gate, same two messages the
 * practice page's own "Compartir" reuses (`[id].astro`'s own header),
 * chosen by the activity's own status.
 */
let qrBlockedMessage: string | undefined;
if (isAuthorPreview && previewStatus) {
  const practiceT = UI_LABELS[lang].activities.practice;
  qrBlockedMessage =
    previewStatus === 'pending_review' ? practiceT.authorPreviewSharePending : practiceT.authorPreviewShareUnpublished;
}

/**
 * "Otra actividad" (N7, next step at the end): the community catalog,
 * filtered by this activity's own level when it has one — SAME URL logic as
 * the practice page's own `nextActivityHref` (`[id].astro`'s own header,
 * build item N1) — kept in sync by hand, since the two routes share no
 * loader to factor it into.
 */
const nextActivityHref = activity.level
  ? `/${lang}/ingles/actividades?nivel=${activity.level}`
  : `/${lang}/ingles/actividades`;
---

<BaseLayout lang={lang} title={activity.title} description={t.pageDescription} theme="ingles" bare fullHeight>
  <PresentationIsland
    client:load
    lang={lang}
    title={activity.title}
    level={activity.level}
    practiceUrl={practiceUrl}
    qrSvg={isAuthorPreview ? null : shareQr}
    qrBlockedMessage={qrBlockedMessage}
    blocks={activity.blocks}
    nextActivityHref={nextActivityHref}
  />
</BaseLayout>

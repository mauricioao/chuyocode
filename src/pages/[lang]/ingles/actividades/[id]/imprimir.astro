---
/**
 * Print page — `/[lang]/ingles/actividades/[id]/imprimir` (SSR, D6
 * "Imprimir"). Same VISIBILITY rule as the practice page (`[id].astro`, one
 * level up): `getPublishedActivity` 404s for anything not `visible`,
 * including the author's own non-live activity — this route is the public
 * player's print view, not a preview.
 *
 * 🔴 UNLIKE `[id].astro`/`presentar.astro`, THIS ROUTE STAYS SIGN-IN GATED
 * (guest play, owner-approved, deliberately scoped to exactly those two
 * routes — `@lib/access`'s `isPublicActivityRoute` does not match
 * `imprimir`). The practice page's own "Imprimir" link is therefore a plain,
 * unconditional link for every visitor, guest included — clicking it as a
 * guest hits this route's own login wall, same as any other gated page.
 * Under `ingles/**`, so the middleware still gates it (sign-in required) —
 * `markPrivate` is called here anyway, explicitly, because this page also
 * builds several early-return `Response`s of its own (invalid lang, missing
 * id, not found) that bypass `Astro.response.headers` entirely and need
 * their own header.
 *
 * A DELIBERATELY BARE page — no `BaseLayout`: the task is "light theme for
 * paper, no site header/footer/nav", which is the opposite of what
 * `BaseLayout` gives (dark-only, site chrome always on). `@styles/global.css`
 * is still imported directly (this project's ONLY Tailwind entry point —
 * see that file's own header), but literal color utilities (`bg-white`,
 * `text-black`) are used throughout rather than the semantic
 * `bg-background`/`text-foreground` tokens: `:root` carries this site's DARK
 * values (`--background: #000000`), so a semantic token here would print
 * black paper with near-white ink.
 *
 * Every block renders in order: a worksheet's image at full width
 * (`break-inside: avoid` plus `break-before: page`, so each worksheet starts
 * its own page and is never split across two), a quiz block as a numbered
 * list (a blank marker becomes "________"; a pool-backed question's options
 * become "a) b) c)…", via {@link getSlotItems} — the exact renderer-free
 * summary `ModerationBlockPreview`'s own helpers already established).
 * `?respuestas=1` (a plain "Incluir respuestas" link, not a client toggle —
 * this page ships no interactive JS beyond the print button) appends an
 * answer key: each worksheet's zones in READING order
 * (`orderZonesForReading`, same helper the mobile per-zone sheet uses) with
 * their accepted answers, each quiz question's resolved answer, and every
 * explanation (D5) that was authored, reusing `zoneAnswerSummary`/
 * `quizSlotAnswerSummary` from `moderationPreview.ts` verbatim rather than
 * re-deriving them.
 */
import { markPrivate } from '@lib/httpCache';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getPublishedActivity } from '@lib/activities/activities';
import { imagePreviewUrl } from '@lib/activities/paths';
import { rotatedSize } from '@lib/activities/canvasViewport';
import { orderZonesForReading } from '@lib/activities/zoneGeometry';
import { zoneAnswerSummary, quizSlotAnswerSummary } from '@lib/activities/moderationPreview';
import { splitLabelAtBlank, getSlotItems, type Slot } from '@lib/exercisePayload';
import { deriveGroupSortGroups, groupSortPoolName, seedFromString, shuffleWithSeed } from '@lib/activities/gameModes';
import { deriveClozeGameSentences } from '@lib/activities/clozeSentences';
import type { Block } from '@lib/activities/blocks';
import '@styles/global.css';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

// Session-dependent on every exit path from here (the activity lookup below
// reads `getPublishedActivity`, which is visibility-gated the same way as
// the practice page) — see this file's own header for why this is explicit
// here despite `ingles/**` already being covered by the middleware.
markPrivate(Astro.response.headers);

const { id } = Astro.params;
if (!id) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

const activity = await getPublishedActivity(id);
if (!activity) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

const t = UI_LABELS[lang].activities.print;
const levelLabels = UI_LABELS[lang].english.levels;

const showAnswers = Astro.url.searchParams.get('respuestas') === '1';
const answersHref = `${Astro.url.pathname}?respuestas=1`;

/**
 * This block's own label — the author's own `block.name`, or a positional/
 * type default. Same rule `ActivityPracticeIsland`'s own `tabLabel` uses for
 * the practice tabs, plus `template === 'match'` (build item 5): "Básico"
 * would misname a pair list that has no Básico questions in it at all.
 */
function blockLabel(block: Block, worksheetPosition: number): string {
  if (block.name) return block.name;
  if (block.type === 'worksheet') return `${t.worksheetLabel} ${worksheetPosition + 1}`;
  if (block.template === 'match') return t.matchLabel;
  if (block.template === 'reorder') return t.reorderLabel;
  if (block.template === 'cloze') return t.clozeLabel;
  if (block.template === 'groupsort') return t.groupSortLabel;
  return t.quizLabel;
}

/** A groupsort item's resolved display text — same fallback chain `moderationPreview.ts`'s own helpers use (pool item text, then media, then the raw id). */
function groupSortItemText(block: Extract<Block, { type: 'quiz' }>, itemId: string): string {
  const poolName = groupSortPoolName(block.payload);
  const pool = poolName ? (block.payload.pools[poolName] ?? []) : [];
  const item = pool.find((candidate) => candidate.id === itemId);
  return item?.text ?? item?.media ?? itemId;
}

/** A deterministic word shuffle that is never the sentence's own order — same anti-identity rule the reorder game/presentation slide both follow. */
function shuffledWords(sentence: string, seed: number): string[] {
  const words = sentence.trim().split(/\s+/).filter(Boolean);
  if (words.length < 2) return words;
  let order = shuffleWithSeed(words, seed);
  if (order.every((word, i) => word === words[i])) {
    order = [...order];
    [order[0], order[1]] = [order[1]!, order[0]!];
  }
  return order;
}

interface LabeledBlock {
  block: Block;
  label: string;
}

// Computed once, shared by the main content AND the answer key below, so
// "Hoja 1"/"Hoja 2" numbering can never drift between the two sections.
const labeledBlocks: LabeledBlock[] = (() => {
  let worksheetPosition = -1;
  return activity.blocks.map((block) => {
    if (block.type === 'worksheet') worksheetPosition += 1;
    return { block, label: blockLabel(block, worksheetPosition) };
  });
})();

const LETTERS = 'abcdefghijklmnopqrstuvwxyz';

/** A quiz question's printed prompt: its blank marker (if any) becomes "________". */
function questionText(slot: Slot): string {
  const parts = splitLabelAtBlank(slot.label);
  if (parts) return `${parts.before}________${parts.after}`;
  return slot.label.length > 0 ? `${slot.label} ________` : '________';
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={t.pageDescription} />
    <title>{activity.title} — {t.print}</title>
    <style is:global>
      /* Print layout (D6). Scoped to this page only — it is never shared via
         a layout, so nothing here can leak onto another route. */
      .print-worksheet {
        break-inside: avoid;
        break-before: page;
      }
      .print-quiz {
        break-inside: avoid;
      }
      .print-answer-key {
        break-before: page;
      }
      @media print {
        .no-print {
          display: none !important;
        }
        /* No backgrounds on paper — ink only. */
        * {
          background: transparent !important;
          box-shadow: none !important;
        }
        /* Links without URLs: no author CSS anywhere on this page appends
           one, but this makes that explicit rather than incidental. */
        a[href]::after {
          content: '' !important;
        }
      }
      @page {
        /* A4/Letter-friendly margin — printers default the sheet size
           itself; this only sets the margin, which both share safely. */
        margin: 1.5cm;
      }
    </style>
  </head>
  <body class="bg-white text-black">
    <div class="mx-auto max-w-3xl px-6 py-8 print:px-0 print:py-0">
      <div data-testid="print-toolbar" class="no-print mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-black/20 pb-4">
        <a href={`/${lang}/ingles/actividades/${activity.id}`} data-testid="print-back-link" class="text-sm text-black underline">
          {UI_LABELS[lang].activities.practice.back}
        </a>
        <div class="flex items-center gap-4">
          {!showAnswers && (
            <a href={answersHref} data-testid="print-include-answers" class="text-sm text-black underline">
              {t.includeAnswers}
            </a>
          )}
          <button type="button" id="print-button" data-testid="print-button" class="rounded-md border border-black px-3 py-1.5 text-sm font-medium text-black">
            {t.print}
          </button>
        </div>
      </div>

      <header data-testid="print-header" class="mb-8">
        <h1 class="text-2xl font-bold text-black">{activity.title}</h1>
        <p class="text-sm text-black/70">
          {activity.level ? `${activity.level} · ${levelLabels[activity.level]}` : t.noLevel}
        </p>
      </header>

      <div class="flex flex-col gap-10">
        {labeledBlocks.map(({ block, label }) => {
          if (block.type === 'worksheet') {
            // A live activity's worksheet always has an image — `'submit'`
            // mode never parses one without it — this guard is only a
            // type-level one, never actually skipped in practice.
            if (!block.image) return null;
            const rotation = block.rotation ?? 0;
            const isQuarterTurn = rotation === 90 || rotation === 270;
            const displaySize = rotatedSize(block.image, rotation);
            return (
              <section data-testid={`print-block-${block.id}`} class="print-worksheet">
                <h2 class="mb-2 text-lg font-semibold text-black">{label}</h2>
                <div
                  class="relative w-full overflow-hidden"
                  style={`aspect-ratio: ${displaySize.width} / ${displaySize.height}`}
                >
                  <img
                    src={imagePreviewUrl(block.image.path)}
                    alt=""
                    class={isQuarterTurn ? undefined : 'absolute inset-0 h-full w-full object-contain'}
                    style={
                      isQuarterTurn
                        ? `position: absolute; top: 50%; left: 50%; height: ${(block.image.height / block.image.width) * 100}%; width: auto; max-width: none; transform: translate(-50%, -50%) rotate(${rotation}deg);`
                        : `transform: rotate(${rotation}deg);`
                    }
                  />
                </div>
              </section>
            );
          }

          // "Une las parejas" (build item 5, "Match in print"): a numbered
          // fill-in-the-blank list makes no sense for a pair list — this
          // prints a clean two-column worksheet instead, prompt on the
          // left and a blank line (to write the answer) on the right.
          if (block.template === 'match') {
            return (
              <section data-testid={`print-block-${block.id}`} class="print-quiz">
                <h2 class="mb-2 text-lg font-semibold text-black">{label}</h2>
                <div data-testid={`print-match-${block.id}`} class="flex flex-col gap-2 text-black">
                  {block.payload.slots.map((slot) => (
                    <div data-testid={`print-match-pair-${slot.id}`} class="flex items-baseline gap-4">
                      <span class="flex-1">{slot.label}</span>
                      <span class="flex-1 border-b border-black/40">&nbsp;</span>
                    </div>
                  ))}
                </div>
              </section>
            );
          }

          // "Reordenar" in print (Wordwall templates build): a numbered
          // fill-in-the-blank list makes no sense for a sentence list
          // either — each sentence prints as its own SCRAMBLED words plus a
          // blank writing line, same two-part shape `match` uses above.
          if (block.template === 'reorder') {
            return (
              <section data-testid={`print-block-${block.id}`} class="print-quiz">
                <h2 class="mb-2 text-lg font-semibold text-black">{label}</h2>
                <ol class="flex flex-col gap-3 text-black">
                  {block.payload.slots.map((slot, i) => {
                    const sentence = slot.answer[0] ?? slot.label;
                    const words = shuffledWords(sentence, seedFromString(`${block.id}:${slot.id}:print`));
                    return (
                      <li data-testid={`print-reorder-${slot.id}`}>
                        <p>{i + 1}. {words.join('  /  ')}</p>
                        <p class="mt-1 border-b border-black/40">&nbsp;</p>
                      </li>
                    );
                  })}
                </ol>
              </section>
            );
          }

          // "Completar la frase" in print: a numbered sentence list, each
          // blank printed as "________", plus one shared word bank below
          // (every blank word across the block's sentences, plus the
          // author's own distractors, shuffled) — same two-part shape
          // `match`/`reorder` use above, at sentence granularity.
          if (block.template === 'cloze') {
            const sentences = deriveClozeGameSentences(block.payload);
            const poolName = block.payload.slots.find((s) => s.input === 'drop')?.pool;
            const bank = poolName ? (block.payload.pools[poolName] ?? []) : [];
            const bankWords = shuffleWithSeed(
              bank.map((item) => item.text ?? item.id),
              seedFromString(`${block.id}:cloze-bank:print`),
            );
            return (
              <section data-testid={`print-block-${block.id}`} class="print-quiz">
                <h2 class="mb-2 text-lg font-semibold text-black">{label}</h2>
                <ol class="flex flex-col gap-2 text-black">
                  {sentences.map((sentence) => (
                    <li data-testid={`print-cloze-${sentence.seq}`}>
                      {sentence.seq + 1}.{' '}
                      {sentence.segments
                        .map((seg) => (seg.kind === 'text' ? seg.text : '________'))
                        .join('')}
                    </li>
                  ))}
                </ol>
                {bankWords.length > 0 && (
                  <p data-testid={`print-cloze-bank-${block.id}`} class="mt-2 text-sm italic">
                    {t.clozeBankLabel}: {bankWords.join('   ·   ')}
                  </p>
                )}
              </section>
            );
          }

          // "Ordenar por grupos" in print: the full item list (shuffled, so
          // it is not already sorted by group), plus one empty, numbered
          // writing column per group — a worksheet the student fills in by
          // hand, same "nothing to fill-in-the-blank about this" reasoning
          // `match`/`reorder`/`cloze` use above.
          if (block.template === 'groupsort') {
            const groups = deriveGroupSortGroups(block.payload);
            const allItemIds = shuffleWithSeed(
              groups.flatMap((group) => group.itemIds),
              seedFromString(`${block.id}:groupsort:print`),
            );
            return (
              <section data-testid={`print-block-${block.id}`} class="print-quiz">
                <h2 class="mb-2 text-lg font-semibold text-black">{label}</h2>
                {allItemIds.length > 0 && (
                  <p data-testid={`print-groupsort-items-${block.id}`} class="mb-3 text-black">
                    {t.groupSortItemsLabel}: {allItemIds.map((itemId) => groupSortItemText(block, itemId)).join('   ·   ')}
                  </p>
                )}
                <div data-testid={`print-groupsort-groups-${block.id}`} class="flex flex-wrap gap-6 text-black">
                  {groups.map((group) => (
                    <div data-testid={`print-groupsort-group-${group.id}`} class="flex min-w-40 flex-1 flex-col gap-1">
                      <p class="font-semibold">{group.label}</p>
                      <ol class="flex flex-col gap-2">
                        {group.itemIds.map((itemId, i) => (
                          <li data-testid={`print-groupsort-blank-${itemId}`} class="border-b border-black/40">
                            {i + 1}. &nbsp;
                          </li>
                        ))}
                      </ol>
                    </div>
                  ))}
                </div>
              </section>
            );
          }

          return (
            <section data-testid={`print-block-${block.id}`} class="print-quiz">
              <h2 class="mb-2 text-lg font-semibold text-black">{label}</h2>
              <ol class="flex flex-col gap-3 text-black">
                {block.payload.slots.map((slot, i) => {
                  const items = getSlotItems(block.payload, slot);
                  return (
                    <li data-testid={`print-question-${slot.id}`}>
                      <p>{i + 1}. {questionText(slot)}</p>
                      {items.length > 0 && (
                        <p class="ml-5 text-sm">
                          {items
                            .map((item, j) => `${LETTERS[j] ?? j}) ${item.text ?? item.media ?? item.id}`)
                            .join('   ')}
                        </p>
                      )}
                    </li>
                  );
                })}
              </ol>
            </section>
          );
        })}
      </div>

      {showAnswers && (
        <section data-testid="print-answer-key" class="print-answer-key mt-10 border-t border-black pt-6">
          <h2 class="mb-4 text-xl font-bold text-black">{t.answersHeading}</h2>
          <div class="flex flex-col gap-6">
            {labeledBlocks.map(({ block, label }) => (
              <div data-testid={`print-answers-${block.id}`}>
                <h3 class="mb-1 font-semibold text-black">{label}</h3>
                {block.type === 'worksheet' ? (
                  <ol class="flex flex-col gap-1 text-sm text-black">
                    {orderZonesForReading(block.zones).map((zone, i) => (
                      <li data-testid={`print-answer-zone-${zone.id}`}>
                        {i + 1}. {zoneAnswerSummary(zone)}
                        {zone.explanation && (
                          <span>
                            {' '}
                            — {t.explanationLabel}: {zone.explanation}
                          </span>
                        )}
                      </li>
                    ))}
                  </ol>
                ) : block.template === 'match' ? (
                  // Same clean two-column shape as the main content above,
                  // this time filled in: prompt | answer.
                  <div data-testid={`print-answers-match-${block.id}`} class="flex flex-col gap-1 text-sm text-black">
                    {block.payload.slots.map((slot) => (
                      <div data-testid={`print-answer-match-${slot.id}`} class="flex items-baseline gap-4">
                        <span class="flex-1">{slot.label}</span>
                        <span class="flex-1 font-medium">{quizSlotAnswerSummary(block.payload, slot)}</span>
                      </div>
                    ))}
                  </div>
                ) : block.template === 'reorder' ? (
                  <ol class="flex flex-col gap-1 text-sm text-black">
                    {block.payload.slots.map((slot, i) => (
                      <li data-testid={`print-answer-reorder-${slot.id}`}>
                        {i + 1}. {quizSlotAnswerSummary(block.payload, slot)}
                      </li>
                    ))}
                  </ol>
                ) : block.template === 'cloze' ? (
                  <ol class="flex flex-col gap-1 text-sm text-black">
                    {deriveClozeGameSentences(block.payload).map((sentence) => (
                      <li data-testid={`print-answer-cloze-${sentence.seq}`}>
                        {sentence.seq + 1}. {sentence.segments.map((seg) => seg.text).join('')}
                      </li>
                    ))}
                  </ol>
                ) : block.template === 'groupsort' ? (
                  <div data-testid={`print-answers-groupsort-${block.id}`} class="flex flex-col gap-1 text-sm text-black">
                    {deriveGroupSortGroups(block.payload).map((group) => (
                      <div data-testid={`print-answer-groupsort-${group.id}`}>
                        <span class="font-semibold">{group.label}:</span>{' '}
                        {group.itemIds.map((itemId) => groupSortItemText(block, itemId)).join(', ')}
                      </div>
                    ))}
                  </div>
                ) : (
                  <ol class="flex flex-col gap-1 text-sm text-black">
                    {block.payload.slots.map((slot, i) => (
                      <li data-testid={`print-answer-question-${slot.id}`}>
                        {i + 1}. {quizSlotAnswerSummary(block.payload, slot)}
                        {slot.explanation && (
                          <span>
                            {' '}
                            — {t.explanationLabel}: {slot.explanation}
                          </span>
                        )}
                      </li>
                    ))}
                  </ol>
                )}
              </div>
            ))}
          </div>
        </section>
      )}
    </div>

    <script is:inline>
      document.getElementById('print-button')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>

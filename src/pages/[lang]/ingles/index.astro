---
/**
 * English section HUB — `/[lang]/ingles` (SSR).
 *
 * `Header.astro` links here from every page of the site, in both locales, so
 * it keeps the previous entry screen's one hard requirement: it must always
 * answer, and the only 404 is an unsupported locale.
 *
 * This screen used to BE the curated-exercises level picker (search bar,
 * level chips, focus grid) with a single "Actividades de la comunidad" link
 * bolted on top — three different things on one page, none of them named.
 * It is now a plain choice between the two: "Ejercicios propuestos"
 * (`/[lang]/ingles/propuestos`, the former level picker, moved unchanged) and
 * "Actividades de la comunidad" (`/[lang]/ingles/actividades`, unchanged).
 *
 * VISUAL UPGRADE (premium redesign pass): the two `HubCard`s now carry a live
 * count ("12 ejercicios"/"34 actividades", `getExerciseCount`/
 * `getActivityCount` — cheap `head: true` count-only queries, fail-safe to
 * `null` so a query failure degrades to no number rather than a misleading
 * "0").
 *
 * Still ships no client-side JavaScript FRAMEWORK of its own: every control
 * here is a plain link, same posture as before.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import HubCard from '@components/ui/HubCard.astro';
import { BooksIcon } from '@phosphor-icons/react/dist/ssr/Books';
import { UsersThreeIcon } from '@phosphor-icons/react/dist/ssr/UsersThree';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getExerciseCount } from '@lib/exercises';
import { getActivityCount } from '@lib/activities/activities';

// Prefer the middleware-validated lang; fall back to the route param and 404
// if neither is supported (defensive — middleware normally sets it).
const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const t = UI_LABELS[lang].english.hub;

/** "12 ejercicios" / "1 ejercicio", or `null` when the count degraded (never "0 …"). */
function formatCount(count: number | null, one: string, many: string): string | null {
  if (count === null) return null;
  return `${count} ${count === 1 ? one : many}`;
}

// Two cheap count-only queries, in parallel.
const [exerciseCount, activityCount] = await Promise.all([getExerciseCount(), getActivityCount()]);

const exerciseCountLabel = formatCount(exerciseCount, t.exerciseCountOne, t.exerciseCountMany);
const activityCountLabel = formatCount(activityCount, t.activityCountOne, t.activityCountMany);
---

<BaseLayout lang={lang} title={t.title} description={t.description}>
  <section class="reveal mx-auto flex w-full max-w-5xl flex-col gap-10 px-4 py-8 sm:py-12">
    <header class="flex flex-col gap-3">
      <PageTitle lang={lang} backHref={`/${lang}`}>{t.title}</PageTitle>
      <p class="max-w-2xl text-lg text-zinc-300">{t.subtitle}</p>
    </header>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      <HubCard
        href={`/${lang}/ingles/propuestos`}
        title={t.proposedTitle}
        description={t.proposedDescription}
        count={exerciseCountLabel}
        tone="sky"
      >
        <BooksIcon slot="icon" weight="duotone" size={56} aria-hidden="true" />
      </HubCard>
      <HubCard
        href={`/${lang}/ingles/actividades`}
        title={t.communityTitle}
        description={t.communityDescription}
        count={activityCountLabel}
        tone="violet"
      >
        <UsersThreeIcon slot="icon" weight="duotone" size={56} aria-hidden="true" />
      </HubCard>
    </div>
  </section>
</BaseLayout>

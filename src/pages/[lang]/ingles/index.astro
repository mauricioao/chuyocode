---
/**
 * English section HUB — `/[lang]/ingles` (SSR).
 *
 * `Header.astro` links here from every page of the site, in both locales, so
 * it keeps the previous entry screen's one hard requirement: it must always
 * answer, and the only 404 is an unsupported locale.
 *
 * This screen used to BE the curated-exercises level picker (search bar,
 * level chips, focus grid) with a single "Actividades de la comunidad" link
 * bolted on top — three different things on one page, none of them named.
 * It is now a plain choice between the two: "Ejercicios propuestos"
 * (`/[lang]/ingles/propuestos`, the former level picker, moved unchanged) and
 * "Actividades de la comunidad" (`/[lang]/ingles/actividades`, unchanged).
 *
 * VISUAL UPGRADE (premium redesign pass): the two `HubCard`s now carry a live
 * count ("12 ejercicios"/"34 actividades", `getExerciseCount`/
 * `getActivityCount` — cheap `head: true` count-only queries, fail-safe to
 * `null` so a query failure degrades to no number rather than a misleading
 * "0"). Below them, a "Para ti hoy" strip highlights the community's daily
 * pick (`pickDailyActivity`, reused unchanged from the actividades page) and
 * the most-hearted activity of the week (`topActivityOfWeek`), both sharing
 * the SAME single `getPublishedActivities({ orden: 'gustadas' })` read so the
 * hub spends one extra round trip, not two. A row of CEFR pills below that
 * jumps straight into `/[lang]/ingles/propuestos?nivel=<level>`.
 *
 * Still ships no client-side JavaScript FRAMEWORK of its own: every control
 * here is a plain link, same posture as before.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import HubCard from '@components/ui/HubCard.astro';
import ActivityCard from '@components/ui/ActivityCard.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { badgeVariants } from '@components/ui/badge';
import { BooksIcon } from '@phosphor-icons/react/dist/ssr/Books';
import { UsersThreeIcon } from '@phosphor-icons/react/dist/ssr/UsersThree';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { LEVELS } from '@lib/exerciseTaxonomy';
import { getExerciseCount } from '@lib/exercises';
import { getActivityCount, getPublishedActivities } from '@lib/activities/activities';
import { pickDailyActivity } from '@lib/activities/dailyPick';
import { topActivityOfWeek } from '@lib/activities/topOfWeek';

// Prefer the middleware-validated lang; fall back to the route param and 404
// if neither is supported (defensive — middleware normally sets it).
const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const english = UI_LABELS[lang].english;
const t = english.hub;
const levelLabels = english.levels;
const activitiesT = UI_LABELS[lang].activities.explore;
const viewerId = Astro.locals.user?.id ?? null;

/** "12 ejercicios" / "1 ejercicio", or `null` when the count degraded (never "0 …"). */
function formatCount(count: number | null, one: string, many: string): string | null {
  if (count === null) return null;
  return `${count} ${count === 1 ? one : many}`;
}

// Two cheap counts plus ONE read of the top-hearted live activities — the
// same pool `pickDailyActivity` picks from and `topActivityOfWeek` scans —
// all in parallel, so the hub pays for one extra round trip total.
const [exerciseCount, activityCount, heartedPool] = await Promise.all([
  getExerciseCount(),
  getActivityCount(),
  getPublishedActivities({ level: null, page: 1, orden: 'gustadas', viewerId }),
]);

const exerciseCountLabel = formatCount(exerciseCount, t.exerciseCountOne, t.exerciseCountMany);
const activityCountLabel = formatCount(activityCount, t.activityCountOne, t.activityCountMany);

const dailyPick = pickDailyActivity(heartedPool.activities, new Date());
// Excludes the daily pick's own id so the strip never shows the same card
// twice when the pool is small.
const weeklyPick = topActivityOfWeek(
  heartedPool.activities.filter((activity) => activity.id !== dailyPick?.id),
  new Date(),
);
---

<BaseLayout lang={lang} title={t.title} description={t.description} theme="ingles">
  <section class="reveal mx-auto flex w-full max-w-5xl flex-col px-4 py-8 sm:py-12">
    <header class="flex flex-col gap-3">
      <PageTitle lang={lang} backHref={`/${lang}`}>{t.title}</PageTitle>
      <p class="max-w-2xl text-lg text-zinc-300">{t.subtitle}</p>
    </header>

    <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
      <HubCard
        href={`/${lang}/ingles/propuestos`}
        title={t.proposedTitle}
        description={t.proposedDescription}
        count={exerciseCountLabel}
        tone="sky"
      >
        <BooksIcon slot="icon" weight="duotone" size={56} aria-hidden="true" />
      </HubCard>
      <HubCard
        href={`/${lang}/ingles/actividades`}
        title={t.communityTitle}
        description={t.communityDescription}
        count={activityCountLabel}
        tone="violet"
      >
        <UsersThreeIcon slot="icon" weight="duotone" size={56} aria-hidden="true" />
      </HubCard>
    </div>

    {
      (dailyPick || weeklyPick) && (
        <section aria-labelledby="hub-today-heading">
          <SectionHeading id="hub-today-heading" title={t.todayTitle} />
          <div class="grid gap-4 sm:grid-cols-2">
            {dailyPick && (
              <ActivityCard
                lang={lang}
                activity={dailyPick}
                levelLabels={levelLabels}
                noLevel={activitiesT.noLevel}
                blockCountOne={activitiesT.blockCountOne}
                blockCountMany={activitiesT.blockCountMany}
                viewedLabel={activitiesT.viewedBadge}
                highlighted
                highlightLabel={activitiesT.dailyPickLabel}
                variant="compact"
              />
            )}
            {weeklyPick && (
              <ActivityCard
                lang={lang}
                activity={weeklyPick}
                levelLabels={levelLabels}
                noLevel={activitiesT.noLevel}
                blockCountOne={activitiesT.blockCountOne}
                blockCountMany={activitiesT.blockCountMany}
                viewedLabel={activitiesT.viewedBadge}
                highlighted
                highlightLabel={t.weeklyPickLabel}
                variant="compact"
              />
            )}
          </div>
        </section>
      )
    }

    <nav aria-label={t.levelShortcutTitle}>
      <SectionHeading title={t.levelShortcutTitle} />
      <ul class="flex gap-2 overflow-x-auto pb-1">
        {
          LEVELS.map((level) => (
            <li class="shrink-0">
              <a
                href={`/${lang}/ingles/propuestos?nivel=${level}`}
                class={[
                  badgeVariants({ variant: 'outline' }),
                  'h-auto gap-1 rounded-full bg-surface-soft px-4 py-2 text-sm hover:border-accent-ink hover:text-accent-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring',
                ].join(' ')}
              >
                {`${level} · ${levelLabels[level]}`}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </section>
</BaseLayout>

---
/**
 * English section HUB — `/[lang]/ingles` (SSR).
 *
 * "DESKTOP" REDESIGN, PART 3 (owner spec 2026-10-06, approved mockup
 * `ChuyoCode_others/propuestas/ingles-escritorio/index.html`): the hub
 * becomes "the desk" — a centred greeting, a right-edge column of
 * "desktop icon" folders, a bottom levels dock, and (this part) the
 * clock + calendar widgets top-left. PARTS 1-2 already shipped the
 * surrounding chrome (always-visible header/footer, scroll-snap, the
 * white-desk palette); this part replaces the hub's OWN content — the two
 * `HubCard`s, the "Para ti hoy"/"Lo más querido" strip and the CEFR pill
 * row are all gone, superseded by the folders/dock below.
 *
 * DROPPED FROM THIS PASS (owner-approved scope cut, reported back rather
 * than silently kept): the "top of the week" card. The mockup's "Para ti
 * hoy" folder covers today's daily pick only — `topActivityOfWeek` and its
 * query are no longer called from here.
 *
 * WIDGETS, PART 4 (owner spec 2026-10-06): the weather + "Frase del día"
 * player widgets land here, next to PART 3's clock/calendar. The widgets
 * zone becomes a real CSS grid on desktop (`160px 160px 320px` columns ×
 * 2 rows, 20px gaps, exactly the mockup's own `.widgets`) so weather can
 * span the first two columns on row 2 — PART 3's `desk:flex` row could not
 * express that second row at all.
 *
 * `DeskWeatherWidget` fetches its forecast client-side (`@lib/ui/deskWeather`)
 * against the location Netlify's own request geo resolves below, falling
 * back to Lima — see the `lat`/`lon`/`city` consts. `DeskPlayerWidget` is
 * this page's one REACT island (`client:load`) — see that component's own
 * header for why, unlike every other widget here, it is not plain
 * vanilla-JS DOM wiring.
 *
 * Still ships no client-side JavaScript FRAMEWORK for the clock/calendar/
 * weather widgets: every interactive bit there is a plain link, PLUS their
 * own small inline module script (`@lib/ui/deskWidgets`, `@lib/ui/deskWeather`,
 * `@lib/ui/deskDrag`) — no island, no React, except the player above.
 *
 * HELPER, PART 5 (owner spec 2026-10-06): a floating character ("desktop"
 * redesign's `.helper`/`.bubble`/`.who`) steps in from the bottom-left with
 * a grammar-tip speech bubble, hub-only — see `DeskHelper.astro`'s own
 * header for the fold/tip/lift behaviour. Plain Astro + `@lib/ui/deskHelper`,
 * same "no extra island" posture as every widget above except the player.
 *
 * WINDOWS, PART 6a (owner spec 2026-10-06): the desk itself and its own data
 * loading moved into `DeskScene.astro` / `@lib/ingles/deskSceneData` so the
 * practice page (`/[lang]/ingles/actividades/[id].astro`) can render the
 * SAME desk behind its own window — this file is now just this route's data
 * (via the shared loader) plus the parts still unique to the hub itself
 * (the floating helper, the folder-gradient-adjacent script wiring).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import DeskScene from '@components/ingles/DeskScene.astro';
import DeskHelper from '@components/ingles/DeskHelper.astro';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { loadDeskSceneData } from '@lib/ingles/deskSceneData';

// Prefer the middleware-validated lang; fall back to the route param and 404
// if neither is supported (defensive — middleware normally sets it).
const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const english = UI_LABELS[lang].english;
const t = english.hub;
const levelLabels = english.levels;
const createActivityLabel = UI_LABELS[lang].activities.start.pageTitle;

const desk = await loadDeskSceneData({
  lang,
  user: Astro.locals.user,
  geo: Astro.locals.netlify?.context?.geo,
});
---

<BaseLayout lang={lang} title={t.title} description={t.description} theme="ingles">
  <DeskScene
    lang={lang}
    greetingLine1={desk.greetingLine1}
    exerciseCountLabel={desk.exerciseCountLabel}
    activityCountLabel={desk.activityCountLabel}
    dailyPickHref={desk.dailyPickHref}
    dailyPickMeta={desk.dailyPickMeta}
    dailyPickPeek={desk.dailyPickPeek}
    weatherLat={desk.weatherLat}
    weatherLon={desk.weatherLon}
    weatherCity={desk.weatherCity}
    weatherLabel={desk.weatherLabel}
    playerLabels={desk.playerLabels}
    levelLabels={levelLabels}
    labels={{
      greetingQuestion: t.greetingQuestion,
      greetingSubtitle: t.greetingSubtitle,
      foldersLabel: t.foldersLabel,
      proposedTitle: t.proposedTitle,
      communityTitle: t.communityTitle,
      todayTitle: t.todayTitle,
      createActivityLabel,
      widgetsLabel: t.widgetsLabel,
      weatherUnavailable: t.weatherUnavailable,
      weatherAttribution: t.weatherAttribution,
      levelShortcutTitle: t.levelShortcutTitle,
      trayLabel: t.trayLabel,
      trayRemoveLabel: t.trayRemoveLabel,
      trayMoreLabel: t.trayMoreLabel,
    }}
  />

  {/* "Desktop" redesign PART 5 (owner spec 2026-10-06): the floating
      character helper, hub-only — practice/editor/presentation pages never
      render it. `position: fixed`, so its place in the DOM does not matter
      visually; kept as a sibling after the desk section itself. */}
  <DeskHelper
    lang={lang}
    landmarkLabel={t.helperLandmarkLabel}
    avatarLabelTemplate={t.helperAvatarLabel}
    otherTipLabel={t.helperOtherTip}
    closeLabel={t.helperClose}
  />

  <script>
    import { initDeskWidgets } from '@lib/ui/deskWidgets';
    import { initDeskWeather } from '@lib/ui/deskWeather';
    import { initDeskDrag } from '@lib/ui/deskDrag';
    import { initDeskHelper } from '@lib/ui/deskHelper';
    import { applyDeskWindowReturnFocus } from '@lib/ui/deskWindow';

    // Drag enhancement runs AFTER the widgets/weather shells exist (it reads
    // their current box with `getBoundingClientRect`), but does not need to
    // wait on the weather fetch itself — `void` is deliberate, same posture
    // as not awaiting `initDeskWeather` below.
    const run = () => {
      initDeskWidgets();
      void initDeskWeather();
      initDeskDrag();
      initDeskHelper();
      // "Desktop" redesign PART 6a: refocuses whichever folder opened a
      // practice window, once the visitor is back on the hub — a no-op
      // (idempotent) when nothing closed a window to get here.
      applyDeskWindowReturnFocus();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', run, { once: true });
    } else {
      run();
    }
    // Re-run after a client-side (View Transitions) navigation TO this page —
    // `astro:page-load` fires for the initial load too, so this alone covers
    // both; the plain listener above is kept as a belt-and-suspenders no-JS-
    // framework-surprise fallback and is a harmless no-op on the second call
    // (`initDeskWidgets`/`initDeskDrag` just re-query the same elements;
    // `initDeskWeather` re-fetches, cheap thanks to its own edge cache).
    document.addEventListener('astro:page-load', run);
  </script>
</BaseLayout>

---
/**
 * Curated-exercises level picker — `/[lang]/ingles/propuestos` (SSR).
 *
 * REMOVED (owner spec 2026-10-07, "ya no tendremos ejercicios propuestos
 * separados de actividades de la comunidad... todo será 'Actividades de la
 * comunidad'"): curated exercises folded into the community catalog, which
 * now opens as its own desk window (`/[lang]/ingles/actividades`'s own
 * header). This route is now a permanent redirect there, carrying over a
 * VALID `?nivel=` (the only filter this old picker ever had) so a bookmark
 * or an indexed link still lands on the right level instead of the
 * unfiltered feed. `isLevel` rejects anything else (an old `?nivel=` typo,
 * or none at all), same defensive posture the old picker's own `resolveLevel`
 * had.
 *
 * Never indexed to begin with (`@lib/seo.ts#isNoindexPath` noindexes all of
 * `ingles/**` except guest play), so there is nothing to update in the
 * sitemap either (`src/pages/sitemap.xml.ts` never listed this route).
 */
import { isValidLang, type Lang } from '@lib/i18n';
import { isLevel } from '@lib/exerciseTaxonomy';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const nivelParam = Astro.url.searchParams.get('nivel');
// 🔴 TESTED IN AN `if` BELOW, NOT INLINED INSIDE A RETURN'S EXPRESSION —
// `astro check` reports a FALSE `ts(6133)` against any binding whose only
// use sits inside the EXPRESSION of a `return` in `.astro` frontmatter
// (`src/pages/index.astro`'s own identical note); testing it in an `if`
// condition first — same technique `entrar.astro` uses for its own
// `signedInTarget` — keeps the checker able to see it used.
const validLevel = isLevel(nivelParam) ? nivelParam : null;

if (validLevel) {
  return Astro.redirect(`/${lang}/ingles/actividades?nivel=${validLevel}`, 301);
}
return Astro.redirect(`/${lang}/ingles/actividades`, 301);
---

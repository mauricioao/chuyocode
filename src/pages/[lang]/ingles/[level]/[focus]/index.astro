---
/**
 * Exercise listing — `/[lang]/ingles/[level]/[focus]` (SSR).
 *
 * REMOVED (owner spec 2026-10-07, same pass as `propuestos/index.astro`'s
 * own header): curated exercises folded into the community catalog. This
 * route is now a permanent redirect to `/[lang]/ingles/actividades`,
 * carrying over `?nivel=` when `level` is a real CEFR level — the community
 * list has no equivalent to `focus` (a language-point axis the discovery
 * feed never filtered by), so that segment is simply dropped. An
 * out-of-taxonomy `level` (the old 404 case) redirects to the unfiltered
 * feed instead — a never-indexed route disappearing is not worth a 404 of
 * its own; see `propuestos/index.astro`'s own note on the sitemap/noindex
 * posture this inherits unchanged.
 */
import { isValidLang, type Lang } from '@lib/i18n';
import { isLevel } from '@lib/exerciseTaxonomy';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const { level } = Astro.params;
// Tested in an `if` below, not inlined inside a `return`'s own expression —
// see `propuestos/index.astro`'s identical note on the false `ts(6133)`
// this avoids.
const validLevel = isLevel(level) ? level : null;

if (validLevel) {
  return Astro.redirect(`/${lang}/ingles/actividades?nivel=${validLevel}`, 301);
}
return Astro.redirect(`/${lang}/ingles/actividades`, 301);
---

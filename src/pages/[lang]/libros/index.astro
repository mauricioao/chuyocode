---
/**
 * Books catalog page (spec 2: Books Catalog; spec 5: localized routing).
 *
 * SSR-renders a grid of BookCard components from Sanity for the active locale.
 * Handles the empty catalog gracefully (spec 2: Empty catalog — localized
 * message, no broken layout).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import MediaCard from '@components/ui/MediaCard.astro';
import SearchFilter from '@components/ui/SearchFilter.astro';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getBooks } from '@lib/sanity';

// Prefer the middleware-validated lang; fall back to the route param and 404
// if neither is a supported language (defensive — middleware normally sets it).
const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const COPY = {
  es: {
    title: 'Libros',
    empty: 'No hay libros disponibles',
    search: 'Buscar por título o autor',
    noResults: 'No se encontraron resultados',
  },
  en: {
    title: 'Books',
    empty: 'No books available',
    search: 'Search by title or author',
    noResults: 'No results found',
  },
} as const;

const t = COPY[lang];
const books = await getBooks(lang);
---

<BaseLayout
  lang={lang}
  title={t.title}
  description={UI_LABELS[lang].meta.booksDescription}
>
  <section class="reveal mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-8 sm:py-12">
    <div class="flex items-center justify-between gap-4">
      <h1 class="text-3xl font-bold tracking-tight text-accent sm:text-4xl">
        {t.title}
      </h1>
      {
        books.length > 0 && (
          <SearchFilter
            targetSelector="[data-book-item]"
            emptyId="books-no-results"
            label={t.search}
          />
        )
      }
    </div>

    {
      books.length === 0 ? (
        <p class="py-16 text-center text-lg text-zinc-400">{t.empty}</p>
      ) : (
        <>
          {/* Client-side filter empty state (hidden until a query hides every
              card). aria-live announces the transition for screen readers. */}
          <p
            id="books-no-results"
            hidden
            aria-live="polite"
            class="py-16 text-center text-lg text-zinc-400"
          >
            {t.noResults}
          </p>
          <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
            {books.map((book) => (
              // Wrapper carries the filter haystack (title + author). The
              // canonical MediaCard is untouched so the filter stays decoupled
              // from the card component.
              <div data-book-item data-search={`${book.title} ${book.author ?? ''}`}>
                <MediaCard
                  variant="poster"
                  kind="book"
                  _id={book._id}
                  title={book.title}
                  author={book.author}
                  href={`/${lang}/libros/${book.slug}`}
                  asset={
                    book.coverUrl
                      ? {
                          url: book.coverUrl,
                          ...(book.coverLqip
                            ? { metadata: { lqip: book.coverLqip } }
                            : {}),
                        }
                      : null
                  }
                />
              </div>
            ))}
          </div>
        </>
      )
    }
  </section>
</BaseLayout>

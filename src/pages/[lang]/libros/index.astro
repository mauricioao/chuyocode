---
/**
 * Books catalog page (spec 2: Books Catalog; spec 5: localized routing).
 *
 * SSR-renders a grid of BookCard components from Sanity for the active locale.
 * Handles the empty catalog gracefully (spec 2: Empty catalog — localized
 * message, no broken layout).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import MediaCard from '@components/ui/MediaCard.astro';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getBooks } from '@lib/sanity';

// Prefer the middleware-validated lang; fall back to the route param and 404
// if neither is a supported language (defensive — middleware normally sets it).
const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const COPY = {
  es: { title: 'Libros', empty: 'No hay libros disponibles' },
  en: { title: 'Books', empty: 'No books available' },
} as const;

const t = COPY[lang];
const books = await getBooks(lang);
---

<BaseLayout
  lang={lang}
  title={t.title}
  description={UI_LABELS[lang].meta.booksDescription}
>
  <section class="reveal mx-auto flex w-full max-w-6xl flex-col gap-8 px-4 py-8 sm:py-12">
    <h1 class="text-3xl font-bold tracking-tight text-accent sm:text-4xl">
      {t.title}
    </h1>

    {
      books.length === 0 ? (
        <p class="py-16 text-center text-lg text-zinc-400">{t.empty}</p>
      ) : (
        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
          {books.map((book) => (
            // Canonical MediaCard (replaces the legacy BookCard): same cover +
            // title + author full-card link, but gains LQIP blur-up, responsive
            // srcset, and a native View Transition into the detail hero.
            <MediaCard
              variant="poster"
              kind="book"
              _id={book._id}
              title={book.title}
              author={book.author}
              href={`/${lang}/libros/${book.slug}`}
              asset={
                book.coverUrl
                  ? {
                      url: book.coverUrl,
                      ...(book.coverLqip
                        ? { metadata: { lqip: book.coverLqip } }
                        : {}),
                    }
                  : null
              }
            />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>

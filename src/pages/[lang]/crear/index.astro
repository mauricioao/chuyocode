---
/**
 * Activities creator start screen — `/[lang]/crear` (SSR, PR B "Activities
 * creator").
 *
 * REPURPOSED FROM the old curated-exercise authoring page, which moved to
 * `/[lang]/admin/ejercicios` (moderator-only) in this same PR — see that
 * route's header. This path is now open to any SIGNED-IN visitor: choosing
 * "Worksheet" here creates a brand-new activity and navigates to its editor
 * (`/[lang]/crear/[id]`); choosing "Preguntas/Questions" (PR C, "Preguntas
 * (quiz) block") does the same, seeding one empty quiz block first.
 *
 * SSR-GATED ON `Astro.locals.user`, same pattern the old page documented:
 * anonymous visitors are redirected to sign-in, `next` pointing back here,
 * before anything renders.
 *
 * 🔴 NETLIFY APPENDS THE ORIGINAL REQUEST'S QUERY STRING TO A 30x `Location`
 * THAT HAS NONE OF ITS OWN — the redirect below always carries its own
 * `?next=…`, so there is nothing query-less for Netlify to append to.
 *
 * 🔴 SESSION-DEPENDENT, NEVER PUBLICLY CACHEABLE: this page's HTML differs
 * by visitor (gated vs. redirect), so `markPrivate` runs unconditionally.
 *
 * "DESKTOP" REDESIGN PART 6b (owner spec 2026-10-06): this start screen now
 * renders as a WINDOW over the desk too — the same shell `crear/[id].astro`
 * (the actual editor) uses, opened by the hub's own "Crear actividad" icon
 * (`DeskScene.astro`'s `data-desk-window-open="create"`). The red light
 * replaces `PageTitle`'s old `backHref` (the hub). There is nothing to
 * minimize yet (no activity id exists until a type is picked —
 * `ActivityStartIsland`'s own `POST /api/actividades`), so no `trayId` is
 * passed here: the yellow light simply falls back to doing exactly what the
 * red one does (`@lib/ui/deskWindow.ts#initDeskWindow`'s own `minimize()`),
 * same as a GUEST's practice window. `closeOnEscape` stays at its default
 * (`true`) — this screen has no competing use for Escape, unlike the editor.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import DeskScene from '@components/ingles/DeskScene.astro';
import DeskWindow from '@components/ingles/DeskWindow.astro';
import ActivityStartIsland from '@components/islands/activities/ActivityStartIsland';
import { markPrivate } from '@lib/httpCache';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { loadDeskSceneData } from '@lib/ingles/deskSceneData';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// This response varies by `Astro.locals.user` and must never reach a shared
// cache — set BEFORE the gate, so neither exit path can ship without it.
markPrivate(Astro.response.headers);

const user = Astro.locals.user;
if (!user) {
  // NOT `Astro.redirect()`: it builds its OWN `Response`, discarding the
  // `markPrivate` mutation above.
  return new Response(null, {
    status: 303,
    headers: {
      Location: `/${lang}/auth/entrar?next=${encodeURIComponent(Astro.url.pathname)}`,
      'cache-control': 'private, no-store',
    },
  });
}

const t = UI_LABELS[lang].activities.start;
const editorT = UI_LABELS[lang].activities.editor;
const levelLabels = UI_LABELS[lang].english.levels;

/** The desk behind the window — same loader/component the hub, the
 * practice window, and the editor window all use. */
const desk = await loadDeskSceneData({ lang, user, geo: Astro.locals.netlify?.context?.geo });
const deskLabels = {
  greetingQuestion: UI_LABELS[lang].english.hub.greetingQuestion,
  greetingSubtitle: UI_LABELS[lang].english.hub.greetingSubtitle,
  foldersLabel: UI_LABELS[lang].english.hub.foldersLabel,
  proposedTitle: UI_LABELS[lang].english.hub.proposedTitle,
  communityTitle: UI_LABELS[lang].english.hub.communityTitle,
  todayTitle: UI_LABELS[lang].english.hub.todayTitle,
  createActivityLabel: UI_LABELS[lang].activities.start.pageTitle,
  widgetsLabel: UI_LABELS[lang].english.hub.widgetsLabel,
  weatherUnavailable: UI_LABELS[lang].english.hub.weatherUnavailable,
  weatherAttribution: UI_LABELS[lang].english.hub.weatherAttribution,
  levelShortcutTitle: UI_LABELS[lang].english.hub.levelShortcutTitle,
  trayLabel: UI_LABELS[lang].english.hub.trayLabel,
  trayRemoveLabel: UI_LABELS[lang].english.hub.trayRemoveLabel,
};
---

<BaseLayout lang={lang} title={t.pageTitle} description={t.pageDescription} theme="ingles" deskBehind>
  <DeskScene
    lang={lang}
    inert
    greetingLine1={desk.greetingLine1}
    exerciseCountLabel={desk.exerciseCountLabel}
    activityCountLabel={desk.activityCountLabel}
    dailyPickHref={desk.dailyPickHref}
    dailyPickMeta={desk.dailyPickMeta}
    dailyPickPeek={desk.dailyPickPeek}
    weatherLat={desk.weatherLat}
    weatherLon={desk.weatherLon}
    weatherCity={desk.weatherCity}
    weatherLabel={desk.weatherLabel}
    playerLabels={desk.playerLabels}
    levelLabels={levelLabels}
    labels={deskLabels}
  />

  <DeskWindow
    lang={lang}
    title={editorT.titleFallback}
    closeHref={`/${lang}/ingles`}
    closeLabel={editorT.windowClose}
    minimizeLabel={editorT.windowMinimize}
    fullScreenLabel={editorT.windowFullScreen}
    slot="overlay"
  >
    <section class="mx-auto flex w-full max-w-4xl flex-col gap-6 overflow-y-auto px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
      <ActivityStartIsland client:load lang={lang} />
    </section>
  </DeskWindow>
</BaseLayout>

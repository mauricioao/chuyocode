---
/**
 * Activity editor page — `/[lang]/crear/[id]` (SSR, PR B "Activities
 * creator").
 *
 * SSR-GATED exactly like `crear/index.astro`: anonymous redirects to
 * sign-in with `next`, before anything renders. Ownership is then
 * re-verified server-side, in the frontmatter, by calling
 * `getActivityForEdit(id, user.id)` (`src/lib/activities/activities.ts`) —
 * that call filters by BOTH `id` and `author_id` in the query itself, so
 * "does not exist" and "exists but is not yours" collapse to the identical
 * `null` and the identical 404 here. Neither confirms to a caller that some
 * OTHER author's activity id exists.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import BackButton from '@components/ui/BackButton.astro';
import ActivityEditorIsland from '@components/islands/activities/ActivityEditorIsland';
import { markPrivate } from '@lib/httpCache';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getActivityForEdit } from '@lib/activities/activities';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Session-dependent on every exit path — see index.astro's header.
markPrivate(Astro.response.headers);

const user = Astro.locals.user;
if (!user) {
  return new Response(null, {
    status: 303,
    headers: {
      Location: `/${lang}/auth/entrar?next=${encodeURIComponent(Astro.url.pathname)}`,
      'cache-control': 'private, no-store',
    },
  });
}

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const activity = await getActivityForEdit(id, user.id);
if (!activity) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

const t = UI_LABELS[lang].activities.editor;
---

<BaseLayout lang={lang} title={t.pageTitle} description={t.pageDescription}>
  {/*
    One-screen creator layout (desktop only), creator polish round 3: the
    editor is ONE framed card with real breathing room from the site header
    AND the footer — never glued to either. The back-button row below (site-
    wide navigation, PR "Navigation + Inglés hub") has NO page-level title to
    sit beside — the activity's own title is an editable field INSIDE
    `ActivityEditorIsland`'s card header, a different thing — so it renders
    as its own row above this section instead of inline with a `<h1>`.
    `lg:pt-6` (wrapper) + `lg:pb-6` (section) together are the same 1.5rem
    top + 1.5rem bottom margin this layout always had; the back-button row
    ADDS its own `h-9` + `mb-3` = `3rem` on top of that. `ActivityEditorIsland`'s
    own root sizes itself to `calc(100dvh - <site header height> - 3rem -
    3rem)` (the original margin, then the back-button row) — so THIS markup
    and that calc must change together (see its own comment). Horizontal
    padding is untouched; below `lg:` this keeps its normal padded,
    scrollable layout.
  */}
  <div class="mx-auto flex w-full max-w-6xl px-4 pt-8 sm:px-6 sm:pt-12 lg:px-8 lg:pt-6">
    <div class="mb-3 flex lg:mb-3">
      <BackButton lang={lang} href={`/${lang}/mis-actividades`} />
    </div>
  </div>
  <section class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 pb-8 sm:px-6 sm:pb-12 lg:gap-0 lg:px-8 lg:pb-6">
    <ActivityEditorIsland
      client:load
      lang={lang}
      activityId={activity.id}
      initialTitle={activity.title}
      initialLevel={activity.level}
      initialBlocks={activity.blocks}
      initialStatus={activity.status}
      initialReviewNote={activity.reviewNote}
    />
  </section>
</BaseLayout>

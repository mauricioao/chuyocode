---
/**
 * Activity editor page — `/[lang]/crear/[id]` (SSR, PR B "Activities
 * creator").
 *
 * SSR-GATED exactly like `crear/index.astro`: anonymous redirects to
 * sign-in with `next`, before anything renders. Ownership is then
 * re-verified server-side, in the frontmatter, by calling
 * `getActivityForEdit(id, user.id)` (`src/lib/activities/activities.ts`) —
 * that call filters by BOTH `id` and `author_id` in the query itself, so
 * "does not exist" and "exists but is not yours" collapse to the identical
 * `null` and the identical 404 here. Neither confirms to a caller that some
 * OTHER author's activity id exists.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import BackButton from '@components/ui/BackButton.astro';
import ActivityEditorIsland from '@components/islands/activities/ActivityEditorIsland';
import { markPrivate } from '@lib/httpCache';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getActivityForEdit } from '@lib/activities/activities';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Session-dependent on every exit path — see index.astro's header.
markPrivate(Astro.response.headers);

const user = Astro.locals.user;
if (!user) {
  return new Response(null, {
    status: 303,
    headers: {
      Location: `/${lang}/auth/entrar?next=${encodeURIComponent(Astro.url.pathname)}`,
      'cache-control': 'private, no-store',
    },
  });
}

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const activity = await getActivityForEdit(id, user.id);
if (!activity) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

const t = UI_LABELS[lang].activities.editor;

// "Duplicar y adaptar" credit line (D7) — `null` for an ordinary activity.
// `href` is `null` once the source is no longer live, same rule as the
// practice page's own credit line (`[id].astro` under `ingles/actividades`).
const sourceActivity = activity.source
  ? {
      title: activity.source.title,
      href: activity.source.visible ? `/${lang}/ingles/actividades/${activity.source.id}` : null,
    }
  : null;
---

<BaseLayout lang={lang} title={t.pageTitle} description={t.pageDescription} fullHeight>
  {/*
    One-screen creator layout (desktop only, `lg:`), NO PAGE-LEVEL SCROLL
    (floating side toolbar pass, owner request: the old dedicated
    back-button row above this section was empty dead space once the back
    button itself went floating/sticky — see `BackButton.astro`'s own
    header — so it is gone at `lg:`; only the editor's OWN interior areas
    (block list, properties panel) scroll, via `<BaseLayout fullHeight>`
    above). Below `lg:`, the dedicated back-button row above this section is
    ALSO gone now (mobile layout pass, owner request): `ActivityEditorIsland`
    renders its own `lg:hidden` copy of this SAME back button INLINE, left of
    the title, instead — see that component's own header on its title row.
  */}
  <section class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 pt-8 pb-8 sm:px-6 sm:pt-12 sm:pb-12 lg:h-full lg:min-h-0 lg:flex-row lg:items-start lg:gap-0 lg:px-8 lg:py-6">
    {/* `lg:`-only: the SAME `BackButton`, floating sticky in the left
        gutter (see its own header) — the first item of this row, so its
        normal-flow starting position lines up with the card's own top edge
        (`items-start` on the row). No reserved height of its own: it
        overlaps into the gutter via its own `-ml-12`, so the row's actual
        width is unaffected by its presence. */}
    <div class="hidden lg:flex lg:flex-none">
      <BackButton lang={lang} href={`/${lang}/mis-actividades`} />
    </div>
    <ActivityEditorIsland
      client:load
      lang={lang}
      activityId={activity.id}
      initialTitle={activity.title}
      initialLevel={activity.level}
      initialBlocks={activity.blocks}
      initialStatus={activity.status}
      initialReviewNote={activity.reviewNote}
      sourceActivity={sourceActivity}
    />
  </section>
</BaseLayout>

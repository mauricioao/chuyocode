---
/**
 * Activity editor page — `/[lang]/crear/[id]` (SSR, PR B "Activities
 * creator").
 *
 * SSR-GATED exactly like `crear/index.astro`: anonymous redirects to
 * sign-in with `next`, before anything renders. Ownership is then
 * re-verified server-side, in the frontmatter, by calling
 * `getActivityForEdit(id, user.id)` (`src/lib/activities/activities.ts`) —
 * that call filters by BOTH `id` and `author_id` in the query itself, so
 * "does not exist" and "exists but is not yours" collapse to the identical
 * `null` and the identical 404 here. Neither confirms to a caller that some
 * OTHER author's activity id exists.
 *
 * "DESKTOP" REDESIGN PART 6b (owner spec 2026-10-06, same "la dirección
 * cambia por detrás, pero vos nunca salís del escritorio" refinement PART 6a
 * already gave the practice page): the editor now renders as a WINDOW over
 * the SAME desk (`DeskScene.astro`) — always signed-in here (there is no
 * guest editor; the gate above already redirects), so, unlike the practice
 * window, there is no guest/no-desk branch to carry. The old back button
 * (both this file's own floating `lg:` `BackButton` AND
 * `ActivityEditorIsland`'s own mobile-inline copy) is GONE: the window's red
 * light replaces it, exactly like PART 6a's red light replaced the practice
 * page's own back button.
 *
 * The compact header row `ActivityEditorIsland` used to own (back button,
 * title, level, the review-status badge, "Ver como presentación", "Enviar a
 * revisión") is now the window's own title bar: the three traffic lights,
 * the EDITABLE title (falling back to `t.titleFallback` — "Nueva
 * actividad" — while empty), the level select and the review-status badge
 * sit beside them, the live autosave status right after, and the two action
 * buttons sit in the title bar's own `actions` slot — all via
 * `ActivityEditorIsland` itself (a `createPortal`/direct DOM sync onto the
 * window's own nodes — see that component's own header). Escape is the
 * editor's OWN shortcut here (deselecting the current zone), so
 * `closeOnEscape={false}` — only the red light (or the yellow one,
 * minimizing) ever closes this window.
 *
 * PART 6b polish (owner report: "se ve el marco de la ventana y encima el
 * marco de la tarjeta" — "double framing"): the window IS the frame now —
 * `ActivityEditorIsland`'s own old card lost its border/`bg-card` — so the
 * consistent horizontal inset (`ROW_PADDING_X`, the SAME token
 * `DeskWindow`'s own title bar already uses — `src/lib/ui/layout.ts`'s own
 * header on why every aligned row shares it) lives on THIS section instead,
 * edge to edge at every breakpoint, with the approved mockup's own light
 * desk-grey canvas (`bg-muted`) behind the (still white, `bg-card`) block
 * cards.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import DeskScene from '@components/ingles/DeskScene.astro';
import DeskWindow from '@components/ingles/DeskWindow.astro';
import ActivityEditorIsland from '@components/islands/activities/ActivityEditorIsland';
import { markPrivate } from '@lib/httpCache';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getActivityForEdit } from '@lib/activities/activities';
import { loadDeskSceneData } from '@lib/ingles/deskSceneData';
import { ROW_PADDING_X } from '@lib/ui/layout';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Session-dependent on every exit path — see index.astro's header.
markPrivate(Astro.response.headers);

const user = Astro.locals.user;
if (!user) {
  return new Response(null, {
    status: 303,
    headers: {
      Location: `/${lang}/auth/entrar?next=${encodeURIComponent(Astro.url.pathname)}`,
      'cache-control': 'private, no-store',
    },
  });
}

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const activity = await getActivityForEdit(id, user.id);
if (!activity) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

const t = UI_LABELS[lang].activities.editor;
const levelLabels = UI_LABELS[lang].english.levels;

// "Duplicar y adaptar" credit line (D7) — `null` for an ordinary activity.
// `href` is `null` once the source is no longer live, same rule as the
// practice page's own credit line (`[id].astro` under `ingles/actividades`).
const sourceActivity = activity.source
  ? {
      title: activity.source.title,
      href: activity.source.visible ? `/${lang}/ingles/actividades/${activity.source.id}` : null,
    }
  : null;

/**
 * The window's red/yellow lights (PART 6b polish, owner report: "el botón
 * de minimizar me lleva a mis actividades, no veo el chip en el
 * escritorio"): both now target the HUB, not `/mis-actividades` — the
 * MINIMIZE light navigates straight here so the tray chip it just left
 * behind is actually visible. PART 6c: the CLOSE light ALSO always
 * navigates straight here now — never `history.back()` to wherever the
 * author came from (the old `closeUsesTrackedPath` behaviour) — see
 * `@lib/ui/deskWindow.ts`'s own header.
 */
const closeHref = `/${lang}/ingles`;

/** The title bar's own `<b>` — falls back to `t.titleFallback` ("Nueva
 * actividad") for a brand-new, still-untitled activity. `ActivityEditorIsland`
 * keeps this in sync afterwards as the author types (see that component's
 * own header on `DESK_WINDOW_TITLE_ID`). */
const windowTitle = activity.title.trim() || t.titleFallback;

/** The desk behind the window — same loader/component the hub and the
 * practice window both use (`DeskScene.astro`'s own header). Always
 * rendered here (the gate above already requires a signed-in visitor). */
const desk = await loadDeskSceneData({ lang, user, geo: Astro.locals.netlify?.context?.geo });
const deskLabels = {
  greetingQuestion: UI_LABELS[lang].english.hub.greetingQuestion,
  greetingSubtitle: UI_LABELS[lang].english.hub.greetingSubtitle,
  foldersLabel: UI_LABELS[lang].english.hub.foldersLabel,
  proposedTitle: UI_LABELS[lang].english.hub.proposedTitle,
  communityTitle: UI_LABELS[lang].english.hub.communityTitle,
  todayTitle: UI_LABELS[lang].english.hub.todayTitle,
  createActivityLabel: UI_LABELS[lang].activities.start.pageTitle,
  widgetsLabel: UI_LABELS[lang].english.hub.widgetsLabel,
  weatherUnavailable: UI_LABELS[lang].english.hub.weatherUnavailable,
  weatherAttribution: UI_LABELS[lang].english.hub.weatherAttribution,
  levelShortcutTitle: UI_LABELS[lang].english.hub.levelShortcutTitle,
  trayLabel: UI_LABELS[lang].english.hub.trayLabel,
  trayRemoveLabel: UI_LABELS[lang].english.hub.trayRemoveLabel,
  trayMoreLabel: UI_LABELS[lang].english.hub.trayMoreLabel,
};
---

<BaseLayout lang={lang} title={t.pageTitle} description={t.pageDescription} theme="ingles" deskBehind>
  <DeskScene
    lang={lang}
    greetingLine1={desk.greetingLine1}
    exerciseCountLabel={desk.exerciseCountLabel}
    activityCountLabel={desk.activityCountLabel}
    dailyPickHref={desk.dailyPickHref}
    dailyPickMeta={desk.dailyPickMeta}
    dailyPickPeek={desk.dailyPickPeek}
    weatherLat={desk.weatherLat}
    weatherLon={desk.weatherLon}
    weatherCity={desk.weatherCity}
    weatherLabel={desk.weatherLabel}
    playerLabels={desk.playerLabels}
    levelLabels={levelLabels}
    labels={deskLabels}
  />

  <DeskWindow
    lang={lang}
    title={windowTitle}
    closeHref={closeHref}
    closeLabel={t.windowClose}
    minimizeLabel={t.windowMinimize}
    fullScreenLabel={t.windowFullScreen}
    trayId={activity.id}
    closeOnEscape={false}
    titleEditable
    status={t.titlebarSaved}
    slot="overlay"
  >
    {/* One-screen creator layout: NO page-level scroll — the window's own
        body slot (`flex min-h-0 flex-1 flex-col overflow-hidden`,
        `DeskWindow.astro`) is what bounds this section, not `BaseLayout`'s
        `fullHeight` (unused here, same as the practice window — see this
        file's own header). The OLD back-button row is gone (the red light
        replaces it — see this file's own header), so this section now has
        exactly one child, sized by `ActivityEditorIsland`'s own flex chain
        (root -> card -> body -> block list), unchanged since the floating
        side toolbar pass. Below `desk:` the window becomes a full-screen
        sheet (`DeskWindow`'s own mockup-matched mobile treatment); this
        section's own responsive classes keep today's stacked mobile
        layout.

        "Double framing" fix (PART 6b polish, owner report: "se ve el marco
        de la ventana y encima el marco de la tarjeta"): the window itself
        IS the frame now — `ActivityEditorIsland`'s own old card lost its
        `border`/`bg-card` (see that component's own header), so the
        consistent inset lives HERE instead, edge to edge at every
        breakpoint — `ROW_PADDING_X`, the SAME token `DeskWindow`'s own
        title bar already uses (`src/lib/ui/layout.ts`'s own header).
        `bg-muted` is the light desk-grey backdrop the approved mockup's own
        canvas uses — block cards keep their own `bg-card` (white) so they
        still read against it.

        "No side bands" polish (owner report: white bands on the left/right
        of the editor window with the grey canvas centred as a column):
        this section used to be `mx-auto max-w-6xl` — ONE surface now means
        `bg-muted` itself spans the window's FULL body width, with
        `ROW_PADDING_X` as the only inset either side, so the block cards'
        canvas gets the full width instead of being capped at 6xl with the
        window's own white body colour showing through on either side. */}
    <section class={`flex min-h-0 w-full flex-1 flex-col overflow-y-auto bg-muted ${ROW_PADDING_X} py-4 lg:min-h-0 lg:overflow-hidden`}>
      <ActivityEditorIsland
        client:load
        lang={lang}
        activityId={activity.id}
        initialTitle={activity.title}
        initialLevel={activity.level}
        initialBlocks={activity.blocks}
        initialStatus={activity.status}
        initialReviewNote={activity.reviewNote}
        sourceActivity={sourceActivity}
      />
    </section>
  </DeskWindow>
</BaseLayout>

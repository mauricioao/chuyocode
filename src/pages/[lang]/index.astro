---
/**
 * Image-first discovery home (frontend-v3 home-discovery; spec: home-page delta).
 *
 * Replaces the previous boxed storytelling hero + static ContentRows with an
 * image-first discovery layout composed of four sections IN ORDER (spec:
 * Section Order):
 *   1. HeroCarousel  — getHeroItems()  → auto-rotating featured billboard.
 *   2. EditorialRows — getRowsByTheme() → one titled row per themeTag, mixed
 *      books + news as poster MediaCards.
 *   3. Spotlight     — getSpotlight()  → single featured doc, wide cover + long
 *      synopsis + CTA.
 *   4. RankedRow     — getRanked()     → numbered "top books" rail.
 *
 * The AndeanPattern symbol and the boxed hero are REMOVED (spec: REMOVED
 * Requirement — AndeanPattern / Chakana Hero Symbol; product direction mandates
 * a neutral identity). The static "courses" and "english" teasers are kept
 * below the discovery sections since no Sanity source backs them yet.
 *
 * SSR fail-safe: every discovery query returns [] / null on error (design
 * decision #8), and each section renders nothing when its data is empty, so an
 * outage degrades individual sections instead of 500-ing the page — the page
 * always renders.
 *
 * All chrome copy is localized via `UI_LABELS[lang]`. Section headings for the
 * new Spotlight/RankedRow use neutral, general-audience labels.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroCarousel from '@components/ui/HeroCarousel.astro';
import EditorialRow from '@components/ui/EditorialRow.astro';
import Spotlight from '@components/ui/Spotlight.astro';
import RankedRow from '@components/ui/RankedRow.astro';
import ContentRow from '@components/ui/ContentRow.astro';
import ThemeToggle from '@components/islands/ThemeToggle';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import {
  getHeroItems,
  getRowsByTheme,
  getSpotlight,
  getRanked,
  type MediaItem,
} from '@lib/sanity';

// The middleware validates and injects `locals.lang`; fall back to the route
// param for safety, and 404 if somehow neither is a supported language.
const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const t = UI_LABELS[lang].home;
const coursesT = UI_LABELS[lang].courses.teaser;
const englishT = UI_LABELS[lang].english.teaser;
const description = UI_LABELS[lang].meta.siteDescription;

// SSR-fetch every discovery section in parallel. All helpers are fail-safe
// (return [] / null on error), so empty results simply collapse their section.
const [heroItems, editorialRows, spotlight, ranked] = await Promise.all([
  getHeroItems(lang, 6),
  getRowsByTheme(lang),
  getSpotlight(lang),
  getRanked(lang, 10),
]);

// Neutral, general-audience section labels (spec: neutral identity). Titles for
// editorial rows derive from the themeTag itself, capitalized for display.
const spotlightHeading = lang === 'en' ? 'Spotlight' : 'Destacado';
const spotlightCta = UI_LABELS[lang].news.readMore;
const rankedTitle = lang === 'en' ? 'Top books' : 'Libros destacados';
const rankedDescription =
  lang === 'en'
    ? 'A curated ranking of standout titles worth starting with.'
    : 'Una selección de títulos destacados para empezar.';

/** Turn a themeTag slug into a display title (e.g. "frontend" → "Frontend"). */
function rowTitle(tag: string): string {
  if (!tag) return '';
  return tag.charAt(0).toUpperCase() + tag.slice(1);
}
---

<BaseLayout lang={lang} title="ChuyoCode" description={description}>
  <ThemeToggle slot="theme-toggle" client:load lang={lang} />

  <div class="flex flex-col gap-16 py-8 sm:gap-20 sm:py-12">
    {/* --- 1. HeroCarousel — featured billboard (renders a placeholder when
        empty, so it always holds the top slot) ------------------------- */}
    <div class="reveal">
      <HeroCarousel items={heroItems} />
    </div>

    {/* --- 2. EditorialRows — one titled row per themeTag (mixed content).
        Each row self-hides when it has no items. --------------------- */}
    {
      editorialRows.map((row, i) => (
        <div class="reveal" style={`--reveal-delay:${(i + 1) * 40}ms`}>
          <EditorialRow title={rowTitle(row.themeTag)} items={row.items} />
        </div>
      ))
    }

    {/* --- 3. Spotlight — single featured doc (renders nothing when null) - */}
    {
      spotlight && (
        <div class="reveal" style="--reveal-delay:120ms">
          <Spotlight
            item={spotlight as MediaItem}
            heading={spotlightHeading}
            ctaLabel={spotlightCta}
          />
        </div>
      )
    }

    {/* --- 4. RankedRow — numbered top books (renders nothing when empty) - */}
    <div class="reveal" style="--reveal-delay:160ms">
      <RankedRow title={rankedTitle} items={ranked} description={rankedDescription} />
    </div>

    {/* --- Courses teaser (STATIC — no Sanity source yet) ---------------- */}
    <div class="reveal" style="--reveal-delay:200ms">
      <ContentRow title={t.rows.courses}>
        <article
          class="flex w-72 shrink-0 snap-start flex-col overflow-hidden rounded-lg ring-1 ring-white/5 shadow-elevation-1 bg-base-soft sm:w-80"
        >
          <div class="aspect-[16/9] w-full overflow-hidden bg-base-muted">
            <img
              src="/assets/placeholder-cursos.jpg"
              alt={coursesT.imageAlt}
              loading="lazy"
              class="h-full w-full object-cover"
            />
          </div>
          <div class="flex flex-col gap-2 p-5">
            <span
              class="w-fit rounded-full bg-accent-soft/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent"
            >
              {coursesT.badge}
            </span>
            <h3 class="font-display text-lg font-semibold text-zinc-100">
              {coursesT.title}
            </h3>
            <p class="text-sm text-zinc-400">{coursesT.description}</p>
          </div>
        </article>
      </ContentRow>
    </div>

    {/* --- English teaser (STATIC, disabled — independent section) ------ */}
    <section class="reveal" aria-labelledby="english-teaser-title">
      <div
        class="flex flex-col gap-6 overflow-hidden rounded-2xl ring-1 ring-white/5 shadow-elevation-1 bg-base-soft p-8 sm:flex-row sm:items-center sm:p-10"
      >
        <div
          class="aspect-[4/3] w-full shrink-0 overflow-hidden rounded-xl ring-1 ring-white/5 bg-base-muted sm:w-64"
        >
          <img
            src="/assets/placeholder-english.jpg"
            alt={englishT.imageAlt}
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </div>
        <div class="flex flex-col gap-3">
          <span
            class="w-fit rounded-full bg-accent-soft/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-accent"
          >
            {englishT.badge}
          </span>
          <h2
            id="english-teaser-title"
            class="font-display text-2xl font-semibold text-zinc-100 sm:text-3xl"
          >
            {englishT.title}
          </h2>
          <p class="max-w-2xl text-base text-zinc-300">
            {englishT.description}
          </p>
          <span
            aria-disabled="true"
            class="w-fit cursor-not-allowed rounded-md ring-1 ring-white/5 px-4 py-2 text-sm font-semibold text-zinc-500"
          >
            {coursesT.badge}
          </span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

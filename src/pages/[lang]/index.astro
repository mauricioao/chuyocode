---
/**
 * Image-first discovery home (frontend-v3 home-discovery; spec: home-page delta).
 *
 * Replaces the previous boxed storytelling hero + static ContentRows with an
 * image-first discovery layout composed of four sections IN ORDER (spec:
 * Section Order):
 *   1. HeroCarousel  — getHeroItems()  → auto-rotating featured billboard.
 *   2. EditorialRows — getRowsByTheme() → one titled row per themeTag, mixed
 *      books + news as poster MediaCards.
 *   3. Spotlight     — getSpotlight()  → single featured doc, wide cover + long
 *      synopsis + CTA.
 *   4. RankedRow     — getRanked()     → numbered "top books" rail.
 *
 * The AndeanPattern symbol and the boxed hero are REMOVED (spec: REMOVED
 * Requirement — AndeanPattern / Chakana Hero Symbol; product direction mandates
 * a neutral identity). The old static "courses" and "english" teasers are also
 * removed — the page is now purely the four image-first discovery sections.
 *
 * SSR fail-safe: every discovery query returns [] / null on error (design
 * decision #8), and each section renders nothing when its data is empty, so an
 * outage degrades individual sections instead of 500-ing the page — the page
 * always renders.
 *
 * All chrome copy is localized via `UI_LABELS[lang]`. Section headings for the
 * new Spotlight/RankedRow use neutral, general-audience labels.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroCarousel from '@components/ui/HeroCarousel.astro';
import EditorialRow from '@components/ui/EditorialRow.astro';
import Spotlight from '@components/ui/Spotlight.astro';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import {
  getHeroItems,
  getRowsByTheme,
  getSpotlight,
  themeTitle,
  RESERVED_THEMES,
  type EditorialRow as EditorialRowData,
  type MediaItem,
} from '@lib/sanity';

// The middleware validates and injects `locals.lang`; fall back to the route
// param for safety, and 404 if somehow neither is a supported language.
const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const description = UI_LABELS[lang].meta.siteDescription;

// SSR-fetch every discovery section in parallel. All helpers are fail-safe
// (return [] / null on error), so empty results simply collapse their section.
const [heroItems, editorialRows, spotlight] = await Promise.all([
  getHeroItems(lang, 6),
  getRowsByTheme(lang),
  getSpotlight(lang),
]);

const spotlightHeading = lang === 'en' ? 'Spotlight' : 'Destacado';
const spotlightCta = UI_LABELS[lang].news.readMore;

// Section ordering (spec: home section order). The reserved themes render
// FIRST, in RESERVED_THEMES order (mas-vistos, then recomendados), each with a
// curated title. Every OTHER theme renders below them as a dynamic row, in the
// first-seen order getRowsByTheme returned. A reserved theme with no content
// simply produces no row (find returns undefined → filtered out).
const rowByTheme = new Map(editorialRows.map((r) => [r.themeTag, r]));
const reservedRows: EditorialRowData[] = RESERVED_THEMES.map(
  (theme) => rowByTheme.get(theme),
).filter((r): r is EditorialRowData => r !== undefined);
const otherRows: EditorialRowData[] = editorialRows.filter(
  (r) => !RESERVED_THEMES.includes(r.themeTag as (typeof RESERVED_THEMES)[number]),
);
const orderedRows: EditorialRowData[] = [...reservedRows, ...otherRows];
---

<BaseLayout lang={lang} title="ChuyoCode" description={description}>
  <div class="flex flex-col">
    {/* --- 1. HeroCarousel — featured billboard, flush to the top so it fills
        below the navbar edge-to-edge and its bottom gradient fades into pure
        black (renders a placeholder when empty, so it always holds the top
        slot). ---------------------------------------------------------- */}
    <div class="reveal">
      <HeroCarousel items={heroItems} />
    </div>

    {/* --- Discovery rows — pulled UP with a strong negative margin so the
        FIRST row rides ~40% over the hero's tall bottom fade (the shademanga
        overlap look): the top of the first card sits above the hero's lower
        edge, so a sliver of the next section peeks over the fold to signal
        "there is more below". `relative z-10` keeps the rows/cards above the
        gradient overlay. `pointer-events-none` on the wrapper lets the
        transparent overlap band pass clicks through to the hero CTA
        underneath; each row child re-enables `pointer-events-auto` so cards
        stay fully interactive. --- */}
    <div class="pointer-events-none relative z-10 -mt-28 flex flex-col gap-12 py-8 [&>*]:pointer-events-auto sm:-mt-44 sm:gap-16 sm:py-12">
      {/* --- Editorial rows, ONE per theme, in the ordered sequence built in the
          frontmatter: the reserved themes first ("Más vistos", then "Libros
          Recomendados"), every other theme after. The FIRST row is the one that
          overlaps the hero. Each row's title comes from themeTitle() (override
          map + generic hyphen→space capitalize). Empty rows never reach here —
          getRowsByTheme only returns themes that have items. ------------- */}
      {
        orderedRows.map((row, i) => (
          <div class="reveal" style={`--reveal-delay:${(i + 1) * 40}ms`}>
            <EditorialRow title={themeTitle(row.themeTag)} items={row.items} />
          </div>
        ))
      }

      {/* --- Spotlight — single featured doc, closes the page (renders nothing
          when null). ---------------------------------------------------- */}
      {
        spotlight && (
          <div class="reveal" style="--reveal-delay:160ms">
            <Spotlight
              item={spotlight as MediaItem}
              heading={spotlightHeading}
              ctaLabel={spotlightCta}
            />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

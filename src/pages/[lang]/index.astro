---
/**
 * Image-first discovery home (frontend-v3 home-discovery; spec: home-page delta).
 *
 * Image-first discovery layout, sections IN ORDER:
 *   1. HeroCarousel   — getHeroItems()     → auto-rotating featured billboard.
 *   2. Reserved rows  — getRowsByTheme()   → the RESERVED_THEMES that have
 *      content (today "Libros Recomendados"); the FIRST one overlaps the hero.
 *   3. Más descargados — getMostDownloaded() → automatic numbered ranking by
 *      REAL download count (RankedRow). Self-hides until downloads exist.
 *   4. Other themes   — getRowsByTheme()   → one titled row per remaining theme,
 *      mixed books + news as poster MediaCards.
 *   5. Spotlight      — getSpotlight()     → single featured doc, wide cover +
 *      long synopsis + CTA.
 *
 * Themes are a free-text multi-select array (`themes`), so a document can appear
 * in several rows; titles come from themeTitle() (override map + generic
 * hyphen→space capitalize).
 *
 * SSR fail-safe: every discovery query returns [] / null on error (design
 * decision #8), and each section renders nothing when its data is empty, so an
 * outage degrades individual sections instead of 500-ing the page — the page
 * always renders.
 *
 * All chrome copy is localized via `UI_LABELS[lang]`.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroCarousel from '@components/ui/HeroCarousel.astro';
import EditorialRow from '@components/ui/EditorialRow.astro';
import RankedRow from '@components/ui/RankedRow.astro';
import SpotlightCarousel from '@components/ui/SpotlightCarousel.astro';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import {
  getHeroItems,
  getRowsByTheme,
  getSpotlights,
  themeTitle,
  RESERVED_THEMES,
  type EditorialRow as EditorialRowData,
} from '@lib/sanity';
import { getMostDownloaded } from '@lib/downloads';

// The middleware validates and injects `locals.lang`; fall back to the route
// param for safety, and 404 if somehow neither is a supported language.
const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const description = UI_LABELS[lang].meta.siteDescription;

// SSR-fetch every discovery section in parallel. All helpers are fail-safe
// (return [] / null on error), so empty results simply collapse their section.
// `mostDownloaded` reads Supabase + Sanity and returns [] until downloads exist
// or when the service-role key is unset, so the ranking self-hides gracefully.
const [heroItems, editorialRows, spotlights, mostDownloaded] = await Promise.all([
  getHeroItems(lang, 6),
  getRowsByTheme(lang),
  getSpotlights(lang),
  getMostDownloaded(lang, 10),
]);

const spotlightHeading = lang === 'en' ? 'Spotlight' : 'Destacado';
const spotlightCta = UI_LABELS[lang].news.readMore;

// "Más vistos" ranking labels. Product decision: in this product a "view"
// equals a download/read (users treat downloading as reading), so this ranking
// is fed by the SAME real download count (getMostDownloaded) and simply
// presented as "Más vistos" / "Most viewed" — no separate view counter.
const mostViewedTitle = lang === 'en' ? 'Most viewed' : 'Más vistos';
const mostViewedDescription =
  lang === 'en'
    ? 'The most viewed titles right now.'
    : 'Los títulos más vistos ahora mismo.';

// Section ordering (spec: home section order):
//   hero → "Libros Recomendados" (reserved theme, overlaps the hero)
//        → "Más descargados" (automatic ranking) → every OTHER theme → spotlight
// `reservedRows` are the RESERVED_THEMES that actually have content, in that
// exact order; `otherRows` are the remaining themes in first-seen order. A
// reserved theme with no content simply produces no row.
const rowByTheme = new Map(editorialRows.map((r) => [r.themeTag, r]));
const reservedRows: EditorialRowData[] = RESERVED_THEMES.map(
  (theme) => rowByTheme.get(theme),
).filter((r): r is EditorialRowData => r !== undefined);
const otherRows: EditorialRowData[] = editorialRows.filter(
  (r) => !RESERVED_THEMES.includes(r.themeTag as (typeof RESERVED_THEMES)[number]),
);
---

<BaseLayout lang={lang} title="ChuyoCode" description={description}>
  <div class="flex flex-col">
    {/* --- 1. HeroCarousel — featured billboard, flush to the top so it fills
        below the navbar edge-to-edge and its bottom gradient fades into pure
        black (renders a placeholder when empty, so it always holds the top
        slot). ---------------------------------------------------------- */}
    <div class="reveal">
      <HeroCarousel items={heroItems} />
    </div>

    {/* --- Discovery rows — pulled UP with a strong negative margin so the
        FIRST row rides ~40% over the hero's tall bottom fade (the shademanga
        overlap look): the top of the first card sits above the hero's lower
        edge, so a sliver of the next section peeks over the fold to signal
        "there is more below". `relative z-10` keeps the rows/cards above the
        gradient overlay. `pointer-events-none` on the wrapper lets the
        transparent overlap band pass clicks through to the hero CTA
        underneath; each row child re-enables `pointer-events-auto` so cards
        stay fully interactive. --- */}
    <div class="pointer-events-none relative z-10 -mt-28 flex flex-col gap-12 pt-8 [&>*]:pointer-events-auto sm:-mt-44 sm:gap-16 sm:pt-12">
      {/* --- Reserved editorial rows FIRST ("Libros Recomendados"). The first
          one is the row that overlaps the hero. Title via themeTitle() (override
          map + generic hyphen→space capitalize). Empty reserved themes never
          reach here — getRowsByTheme only returns themes that have items. -- */}
      {
        reservedRows.map((row, i) => (
          <div class="reveal" style={`--reveal-delay:${(i + 1) * 40}ms`}>
            <EditorialRow title={themeTitle(row.themeTag)} items={row.items} />
          </div>
        ))
      }

      {/* --- "Más vistos" — automatic numbered "top 10" chart by real download
          count (RankedRow, framed showcase box with thicker side padding).
          "View" == download/read in this product, so it reuses getMostDownloaded.
          Self-hides when there are no downloads yet or the service-role key is
          unset (mostDownloaded === []). -------------------------------- */}
      <div class="reveal" style="--reveal-delay:120ms">
        <RankedRow
          title={mostViewedTitle}
          items={mostDownloaded}
          description={mostViewedDescription}
        />
      </div>

      {/* --- Every OTHER theme, as dynamic editorial rows in first-seen order.
          Each row's title comes from themeTitle(). -------------------------- */}
      {
        otherRows.map((row, i) => (
          <div class="reveal" style={`--reveal-delay:${(i + 2) * 40}ms`}>
            <EditorialRow title={themeTitle(row.themeTag)} items={row.items} />
          </div>
        ))
      }

      {/* --- Destacados — featured carousel, closes the page. Rotates through
          ALL featured docs (getSpotlights) as wide 16/9 slides so the art never
          distorts. Renders nothing when there are none. ------------------ */}
      {
        spotlights.length > 0 && (
          <div class="reveal" style="--reveal-delay:160ms">
            <SpotlightCarousel
              items={spotlights}
              heading={spotlightHeading}
              ctaLabel={spotlightCta}
            />
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

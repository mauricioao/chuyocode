---
/**
 * Legal page (design decision #9 / File Changes; spec 5: localized routing).
 *
 * A single dynamic route backs all three legal documents the Footer links to:
 *   - `/[lang]/legal/terms`      -> Terms & Conditions       (TermsContent)
 *   - `/[lang]/legal/privacy`    -> Privacy Policy + Cookies (PrivacyContent)
 *   - `/[lang]/legal/reembolsos` -> Refund Policy            (RefundsContent)
 *
 * The `[page]` segment is validated against a small allow-list; anything else
 * 404s (SSR mode — see astro.config.mjs). The real localized copy lives in the
 * `@components/legal/*` components; titles/labels still come from
 * `UI_LABELS[lang].legal` (spec 5: no hardcoded UI strings).
 *
 * Owner identity (name/RUC/city/email) is read from env (LEGAL_OWNER_*) so the
 * personal data required on the page by Ley 29733 renders publicly WITHOUT being
 * hardcoded into source control. Every field is optional and fails safe: an unset
 * value falls back to a neutral label ("ChuyoCode") so the page never breaks.
 *
 * Public edge cache: content depends only on `lang` (and the env-sourced
 * owner identity), never on `Astro.locals.user` — see `publicCachePolicy()`
 * below, same policy as the home and Premium pages.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import TermsContent from '@components/legal/TermsContent.astro';
import PrivacyContent from '@components/legal/PrivacyContent.astro';
import RefundsContent from '@components/legal/RefundsContent.astro';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { loadEnv } from '@lib/env';
import { publicCachePolicy } from '@lib/cache';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

/**
 * Legal documents this route serves. Segment -> UI_LABELS.legal.titles key.
 *
 * `reembolsos` (Refund Policy) deliberately keeps its Spanish slug in BOTH
 * languages — same convention every other page segment under `[lang]`
 * already follows (`/libros`, `/noticias`, `/ingles`, `/mis-actividades`...):
 * the `[lang]` segment is the only thing that switches between locales, page
 * SEGMENTS never do.
 */
const LEGAL_PAGES = ['terms', 'privacy', 'reembolsos'] as const;
type LegalPage = (typeof LEGAL_PAGES)[number];

const page = Astro.params.page;
if (!page || !LEGAL_PAGES.includes(page as LegalPage)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
const legalPage = page as LegalPage;

const legal = UI_LABELS[lang].legal;
const title = legal.titles[legalPage];

// Owner identity from env (fail-safe: fall back to a neutral label so the page
// always renders even before the LEGAL_OWNER_* vars are configured).
const env = loadEnv();
const ownerName = env.LEGAL_OWNER_NAME || 'ChuyoCode';
const ownerRuc = env.LEGAL_OWNER_RUC;
const ownerCity = env.LEGAL_OWNER_CITY;
const ownerEmail = env.LEGAL_OWNER_EMAIL;

/**
 * Fixed "last updated" date per legal document (SEO basics pass). This used
 * to be `new Date()` at render time, which silently advanced the displayed
 * date every single day even when the document's actual text had not
 * changed — a dishonest "last updated" for both readers and search engines.
 * Bump a document's entry BY HAND exactly when its copy in
 * `TermsContent.astro` / `PrivacyContent.astro` actually changes; this value
 * must never auto-advance again.
 */
const LAST_UPDATED: Record<LegalPage, string> = {
  terms: '2026-10-04',
  privacy: '2026-10-04',
  reembolsos: '2026-10-04',
};

// Localized, same display format as before — only the underlying date is
// now a fixed constant instead of the render-time clock. `timeZone: 'UTC'`
// is NOT optional here: without it, `toLocaleDateString` formats in the
// SERVER's local timezone, and `LAST_UPDATED`'s date-only string parses as
// UTC midnight — any timezone behind UTC (Peru included, this very page's
// own `es-PE` audience) would then display the day BEFORE the one written
// above. Pinning UTC makes the fixed date render identically everywhere.
const updated = new Date(`${LAST_UPDATED[legalPage]}T00:00:00Z`).toLocaleDateString(
  lang === 'en' ? 'en-US' : 'es-PE',
  { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' },
);

// Public edge cache: every legal document is byte-identical for every
// visitor of a given `lang` (content depends only on `lang` and the env-
// sourced owner identity, never on `Astro.locals.user`) — same policy as the
// home and Premium pages (`publicCachePolicy`, `@lib/cache.ts`).
const cacheHeaders = publicCachePolicy();
for (const [name, value] of Object.entries(cacheHeaders)) {
  Astro.response.headers.set(name, value);
}
---

<BaseLayout lang={lang} title={title}>
  <section class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-4 py-8 sm:py-12">
    <PageTitle lang={lang} backHref={`/${lang}`}>{title}</PageTitle>

    {
      legalPage === 'terms' ? (
        <TermsContent
          lang={lang}
          ownerName={ownerName}
          ownerRuc={ownerRuc}
          ownerCity={ownerCity}
          ownerEmail={ownerEmail}
          updated={updated}
        />
      ) : legalPage === 'privacy' ? (
        <PrivacyContent
          lang={lang}
          ownerName={ownerName}
          ownerRuc={ownerRuc}
          ownerCity={ownerCity}
          ownerEmail={ownerEmail}
          updated={updated}
        />
      ) : (
        <RefundsContent
          lang={lang}
          ownerName={ownerName}
          ownerRuc={ownerRuc}
          ownerCity={ownerCity}
          ownerEmail={ownerEmail}
          updated={updated}
        />
      )
    }
  </section>
</BaseLayout>

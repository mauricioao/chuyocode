---
/**
 * Legal page (design decision #9 / File Changes; spec 5: localized routing).
 *
 * A single dynamic route backs both legal documents the Footer links to:
 *   - `/[lang]/legal/terms`   -> Terms and conditions
 *   - `/[lang]/legal/privacy` -> Privacy policy
 *
 * The `[page]` segment is validated against a small allow-list; anything else
 * 404s (SSR mode — see astro.config.mjs). Content is intentionally a localized
 * placeholder ("Legal content pending" + a short generic privacy note) until
 * the real legal copy is authored. All strings come from `UI_LABELS[lang].legal`
 * (spec 5: no hardcoded UI strings).
 *
 * ThemeToggle is forwarded into the Header masthead via BaseLayout's slot.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ThemeToggle from '@components/islands/ThemeToggle';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

/** Legal documents this route serves. Segment -> UI_LABELS.legal.titles key. */
const LEGAL_PAGES = ['terms', 'privacy'] as const;
type LegalPage = (typeof LEGAL_PAGES)[number];

const page = Astro.params.page;
if (!page || !LEGAL_PAGES.includes(page as LegalPage)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
const legalPage = page as LegalPage;

const legal = UI_LABELS[lang].legal;
const title = legal.titles[legalPage];
---

<BaseLayout lang={lang} title={title}>
  <ThemeToggle slot="theme-toggle" client:load lang={lang} />
  <section class="mx-auto flex w-full max-w-3xl flex-col gap-6 px-4">
    <h1 class="font-display text-3xl font-bold tracking-tight text-accent sm:text-4xl">
      {title}
    </h1>
    <p class="text-lg text-zinc-400">{legal.pending}</p>
    <p class="leading-relaxed text-zinc-300">{legal.privacyNote}</p>
  </section>
</BaseLayout>

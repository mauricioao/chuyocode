---
/**
 * Localized sign-in page (design §1 route table; slice 4 of
 * `openspec/changes/user-authored-exercises/tasks.md`; extended for Login
 * step 1 — email + password, Google, and the magic link kept as a secondary
 * option).
 *
 * For an anonymous visitor this renders, in order: a plain Google button
 * (its own `<form>`, no island — see below), then `AuthPanel` (email +
 * password; the magic-link option is hidden for now, see that component's
 * file header) — plus whatever the redirect markers on the URL say:
 *  - `?auth=link-invalid` — the confirm route's failure marker
 *    (`AUTH_ERROR_LINK_INVALID` in `@lib/authRedirect`): the visitor's link
 *    expired, was already used, or arrived in a browser with no PKCE
 *    verifier. Shown as an alert above the form.
 *  - `?auth=signed-in` — the confirm route's SUCCESS marker
 *    (`AUTH_SIGNED_IN`). Optional per the task, shown as a quiet confirmation
 *    when a visitor lands here right after signing in (e.g. `next` pointed
 *    back at this page).
 *  - `?auth=google-unavailable` — `/api/auth/google`'s degrade marker
 *    (`AUTH_ERROR_GOOGLE_UNAVAILABLE`): Google is not configured on this
 *    Supabase project, or it was unreachable. Shown as an alert inviting the
 *    visitor to use email and password instead.
 *  - `?mode=signup` — a hint from the header's "Crear cuenta"/"Sign up"
 *    button (`UserMenu`): preselects `AuthPanel`/`PasswordAuthForm`'s
 *    sign-up mode instead of the sign-in default.
 *
 * 🔴 THE GOOGLE BUTTON IS A PLAIN `<form method="POST">`, NOT AN ISLAND.
 * `signInWithOAuth` with `skipBrowserRedirect: true` returns a provider URL
 * rather than redirecting itself; `/api/auth/google` turns that into a real
 * 303 the browser follows on a plain form submit, so no client JS is needed
 * for this control at all — same zero-JS posture `ingles/index.astro`'s
 * header argues for wherever a control needs no request state of its own.
 *
 * 🔴 THIS PAGE IS SESSION-DEPENDENT AND MUST NEVER BE PUBLICLY CACHED.
 * It reads `Astro.locals.user` to decide whether to render the form at all,
 * so its HTML (and, for a signed-in visitor, its very status code) differs
 * by visitor — the exact hazard `src/lib/httpCache.ts` exists to close
 * (design §2 / T7). `markPrivate` runs unconditionally, before either
 * branch, so neither one can ship without it.
 *
 * 🔴 A SIGNED-IN VISITOR IS NEVER SHOWN THIS PAGE. Landing an authenticated
 * visitor on their own sign-in form used to render a broken-looking
 * "already signed in" screen; now the page 303s straight to `next` (or
 * `/<lang>/`) instead, reusing `withAuthSuccess` so the `Location` always
 * carries its own query — same Netlify-appended-query defeat
 * `src/lib/authRedirect.ts`'s header documents for the confirm route. Sign-
 * out lives in the header's user menu (`UserMenu`), not here.
 *
 * NOT wired into the shared `Header`/`BaseLayout` chrome (assumption, see the
 * apply report): `Header` currently takes no session-dependent prop, and
 * `/[lang]/index.astro` applies `publicCachePolicy()` to the HOME page on the
 * assumption its markup is byte-identical for every visitor. Threading
 * `Astro.locals.user` into `Header` would make that no longer true and
 * silently break that public-cache guarantee sitewide. That is a real design
 * decision (e.g. a client-only auth chip), not a copy-paste omission, so it is
 * left out of this slice rather than done unsafely.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageTitle from '@components/ui/PageTitle.astro';
import AuthPanel from '@components/islands/AuthPanel';
import { SpinnerGapIcon } from '@phosphor-icons/react/dist/ssr/SpinnerGap';
import { markPrivate } from '@lib/httpCache';
import { windowAuthBounceResponse } from '@lib/windowAuthBounce';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import {
  AUTH_ERROR_PARAM,
  AUTH_ERROR_LINK_INVALID,
  AUTH_ERROR_GOOGLE_UNAVAILABLE,
  AUTH_SIGNED_IN,
  safeNextPath,
  withAuthSuccess,
} from '@lib/authRedirect';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

/**
 * Fool-proofing a chrome-less frame (robustness pass, owner report): a
 * session that expires WHILE a desk window's own iframe is open makes the
 * middleware's login gate 303 straight to THIS page — inside that same
 * iframe (`Sec-Fetch-Dest: iframe` survives a redirect fetched from within
 * it, same signal `@lib/ui/embeddedWindow#isEmbeddedWindowRequest` already
 * relies on). Rendering the normal sign-in form there would cram it into a
 * tiny window with no traffic lights to close it, and signing back in would
 * leave the visitor stranded on this bare page instead of back on the desk.
 *
 * Instead: a minimal, chrome-less shell whose only job is to bounce the
 * REAL browser tab (`window.top`) to this exact page — a genuine top-level
 * navigation, so it renders its full normal chrome — with `next` set to
 * `window.top`'s own path (the host page the iframe sits inside, e.g. the
 * hub or the activity it was showing). That is client-side-only information
 * (the server never sees the parent frame's URL), hence a script rather than
 * a server-computed redirect; the plain `<a target="_top">` is the
 * no-JS/script-blocked fallback. The shell lives in `@lib/windowAuthBounce`.
 */
const inWindowFrame = Astro.request.headers.get('sec-fetch-dest') === 'iframe';
if (inWindowFrame) {
  Astro.response.headers.append('Vary', 'Sec-Fetch-Dest');
  markPrivate(Astro.response.headers);
  // `Astro.response.headers` (NOT a fresh `Headers` object): the `Vary` and
  // `markPrivate` mutations above only land on the actual response when this
  // exact object is the one handed to `Response` — same `Astro.redirect()`
  // pitfall this file's own header documents for the signed-in 303 below.
  Astro.response.headers.set('content-type', 'text/html; charset=utf-8');
}
// Built outside the `if` on purpose: `astro check` reports a false `ts(6133)`
// for an import whose only use is a value returned from an `if` block.
const windowBounce = inWindowFrame
  ? windowAuthBounceResponse(
      lang,
      {
        title: UI_LABELS[lang].auth.title,
        redirecting: UI_LABELS[lang].auth.windowRedirecting,
        continueLabel: UI_LABELS[lang].auth.windowRedirectingContinue,
      },
      Astro.response.headers,
    )
  : null;
if (windowBounce) {
  return windowBounce;
}

// See the file header: this response varies by `Astro.locals.user` and must
// never reach a shared cache.
markPrivate(Astro.response.headers);

const authParam = Astro.url.searchParams.get(AUTH_ERROR_PARAM);
const linkInvalid = authParam === AUTH_ERROR_LINK_INVALID;
const justSignedIn = authParam === AUTH_SIGNED_IN;
const googleUnavailable = authParam === AUTH_ERROR_GOOGLE_UNAVAILABLE;

// `next`, when present, rides through to `/api/auth/signin` and to the
// sign-out form unchanged. Both routes re-validate it with the same
// `safeNextPath` guard the confirm route uses, so running it here too costs
// nothing extra in safety — it only saves this page from ever handing an
// attacker-supplied string straight into a hidden form field.
const rawNext = Astro.url.searchParams.get('next');
const next = rawNext ? safeNextPath(rawNext) : undefined;

const user = Astro.locals.user;

// A signed-in visitor is never shown this page — see the file header. Built
// from `next` (not `Astro.url.pathname`), which is already `safeNextPath`-
// validated above and, by that guard's default, can never itself point back
// at an auth page — so this cannot loop.
//
// 🔴 COMPUTED HERE, NOT INLINE INSIDE THE `return` BELOW. `astro check`
// reports a FALSE `ts(6133)` against any binding whose only use sits inside
// a `Response(...)` literal returned from an `if` in `.astro` frontmatter
// (see `admin/ejercicios/index.astro`'s identical note) — `withAuthSuccess`
// itself, called directly there, was the case that triggered it. Assigning
// the call's result to a plain top-level const first keeps the checker able
// to see the import as used.
const signedInTarget = user ? withAuthSuccess(next ?? `/${lang}/`) : null;

if (signedInTarget) {
  return new Response(null, {
    status: 303,
    statusText: 'See Other',
    headers: {
      Location: signedInTarget,
      'cache-control': 'private, no-store',
    },
  });
}

// Hint from the header's "Crear cuenta"/"Sign up" button (`UserMenu`):
// preselects `AuthPanel`/`PasswordAuthForm`'s sign-up mode.
const initialMode: 'signin' | 'signup' | undefined =
  Astro.url.searchParams.get('mode') === 'signup' ? 'signup' : undefined;

const t = UI_LABELS[lang].auth;
---

<BaseLayout lang={lang} title={t.title} description={t.description}>
  <section class="mx-auto flex w-full max-w-md flex-col gap-6 px-4 py-12 sm:py-16">
    <PageTitle lang={lang} backHref={`/${lang}`}>{t.title}</PageTitle>

    {
      linkInvalid && (
        <p
          role="alert"
          data-testid="auth-link-invalid"
          class="rounded-md border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive"
        >
          {t.linkInvalid}
        </p>
      )
    }

    {
      justSignedIn && !linkInvalid && (
        <p
          role="status"
          data-testid="auth-signed-in-marker"
          class="rounded-md border border-border bg-background/60 px-4 py-3 text-sm text-muted-foreground"
        >
          {t.signedIn}
        </p>
      )
    }

    {
      googleUnavailable && !linkInvalid && (
        <p
          role="alert"
          data-testid="auth-google-unavailable"
          class="rounded-md border border-destructive/40 bg-destructive/10 px-4 py-3 text-sm text-destructive"
        >
          {t.googleUnavailable}
        </p>
      )
    }

    <div class="flex flex-col gap-6">
      {/* Plain form, no island — see the file header for why. Fields
          ride as hidden inputs because there is no client JS here to
          build a JSON body from. */}
      <form method="POST" action="/api/auth/google" data-testid="google-signin-form" data-astro-reload id="google-signin-form">
        <input type="hidden" name="lang" value={lang} />
        {next && <input type="hidden" name="next" value={next} />}
        {/* No island hydrates this page (see the file header), so the
            loading feedback below is a tiny inert script element — NOT React's
            `Button` — toggling the exact same visual contract that
            component's own `loading` prop gives everywhere else: a spinner
            over the stable-width label, the label itself kept (just
            invisible, not removed), `disabled` + `aria-busy` set. It only
            covers the moment before the browser actually leaves this page
            for the 303 `/api/auth/google` answers with; a FAILURE still
            comes back as a fresh page load (the `?auth=google-unavailable`
            alert above, already rendered server-side), not a client error
            this inert form could catch — so there is no toast to show here. */}
        <button
          type="submit"
          id="google-signin-submit"
          class="relative inline-flex w-full items-center justify-center gap-2 rounded-lg border border-border bg-background px-3 py-2 text-sm font-medium text-foreground hover:bg-muted disabled:pointer-events-none disabled:opacity-50"
        >
          <span
            id="google-signin-spinner"
            class="absolute inset-0 hidden items-center justify-center"
          >
            <SpinnerGapIcon aria-hidden="true" size={18} className="animate-spin" />
          </span>
          <span id="google-signin-label" class="inline-flex items-center gap-2">
            {/* Official multicolor Google "G" mark, ~18px. `aria-hidden` on the
                svg itself: the button's own text label is the accessible name. */}
            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 48 48"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                fill="#4285F4"
                d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"
              />
              <path
                fill="#34A853"
                d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"
              />
              <path
                fill="#FBBC05"
                d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"
              />
              <path
                fill="#EA4335"
                d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"
              />
            </svg>
            <span>{t.google}</span>
          </span>
        </button>
      </form>
      <script>
        // Progressive enhancement only — the form above works identically
        // with this script absent/blocked (see the file header's zero-JS
        // posture). Runs once per page load; `data-astro-reload` always
        // gives this page a real navigation, so there is no View
        // Transitions persistence concern to worry about here.
        const form = document.getElementById('google-signin-form');
        const button = document.getElementById('google-signin-submit') as HTMLButtonElement | null;
        const spinner = document.getElementById('google-signin-spinner');
        const label = document.getElementById('google-signin-label');
        form?.addEventListener('submit', () => {
          if (button) {
            button.disabled = true;
            button.setAttribute('aria-busy', 'true');
          }
          spinner?.classList.remove('hidden');
          spinner?.classList.add('flex');
          label?.classList.add('invisible');
        });
      </script>

      <div class="flex items-center gap-3 text-xs text-muted-foreground" aria-hidden="true">
        <span class="h-px flex-1 bg-border"></span>
        <span>{t.orDivider}</span>
        <span class="h-px flex-1 bg-border"></span>
      </div>

      <AuthPanel client:load lang={lang} next={next} initialMode={initialMode} />
    </div>
  </section>
</BaseLayout>

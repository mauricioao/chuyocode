---
/**
 * Edit curated-exercise page — `/[lang]/admin/ejercicios/[id]` (SSR).
 *
 * MOVED from `/[lang]/crear/[id]` (PR B, "Activities creator") — see
 * `index.astro`'s header for why this surface is now moderator-gated and
 * lives under `/admin/ejercicios`.
 *
 * Gate order: anonymous -> sign-in redirect (`next` back here); signed in but
 * not a moderator -> 404 (never a 403 — `requireRole`'s own "don't confirm
 * the surface exists" posture); moderator -> ownership re-verified
 * server-side exactly as before, by calling
 * `getExerciseForEdit(id, user.id)` (`src/lib/exercises.ts`), which filters
 * by BOTH `id` and `author_id` in the query itself, so "does not exist" and
 * "exists but is not yours" collapse to the identical `null` and the
 * identical 404 here.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import ExercisePublishFlow from '@components/islands/authoring/ExercisePublishFlow';
import { payloadToDraft } from '@lib/authoringDraft';
import { markPrivate } from '@lib/httpCache';
import { isValidLang, UI_LABELS, type Lang } from '@lib/i18n';
import { getExerciseForEdit } from '@lib/exercises';
import { requireRole } from '@lib/roles';

const routeLang = Astro.params.lang;
const lang: Lang | undefined =
  Astro.locals.lang ?? (isValidLang(routeLang) ? routeLang : undefined);

if (!lang) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Session-dependent on every exit path — see index.astro's header.
markPrivate(Astro.response.headers);

const user = Astro.locals.user;
if (!user) {
  // NOT `Astro.redirect()` — see `index.astro`'s matching comment: it builds
  // its own `Response` and would discard the `markPrivate` mutation above.
  return new Response(null, {
    status: 303,
    headers: {
      Location: `/${lang}/auth/entrar?next=${encodeURIComponent(Astro.url.pathname)}`,
      'cache-control': 'private, no-store',
    },
  });
}

const moderator = await requireRole(user, 'moderator');
if (!moderator) {
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

const { id } = Astro.params;
if (!id) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// OWNERSHIP CHECK, IN THE FRONTMATTER, SERVER-SIDE — independent of any UI
// state the caller might have forged. See the file header.
const exercise = await getExerciseForEdit(id, user.id);
if (!exercise) {
  // Also explicitly private: WHICH id 404s depends on `user.id` (someone
  // else's exercise 404s for this caller, not for its real owner), so this
  // response is exactly as session-dependent as the redirect above.
  return new Response(null, {
    status: 404,
    statusText: 'Not Found',
    headers: { 'cache-control': 'private, no-store' },
  });
}

const t = UI_LABELS[lang].authoring;
---

<BaseLayout lang={lang} title={t.editTitle} description={t.editDescription}>
  <section class="mx-auto flex w-full max-w-6xl flex-col gap-6 px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
    <h1 class="font-display text-3xl font-bold tracking-tight text-accent">
      {t.editTitle}
    </h1>
    <ExercisePublishFlow
      client:load
      lang={lang}
      exerciseId={exercise.id}
      initialDraft={payloadToDraft(exercise.payload)}
    />
  </section>
</BaseLayout>

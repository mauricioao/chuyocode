---
/**
 * BaseLayout — wraps every page (spec 7: BaseLayout requirement).
 *
 * Responsibilities:
 *  - `<html lang>` driven by the `lang` prop (i18n, defaults to "es").
 *  - Global Tailwind styles are injected by `@astrojs/tailwind`
 *    (`applyBaseStyles: true` in astro.config.mjs), so no manual CSS import.
 *  - A `<slot name="head">` for page-specific meta/title/link tags.
 *  - The default `<slot>` for body content, wrapped by Header + Footer.
 *  - Dark mode is HARDCODED: `<html class="dark">` ships on every page and the
 *    site is dark-only (no theme toggle, no persistence, no no-flash script),
 *    EXCEPT the Inglés product (visual-theme pass, "dark brand, light
 *    product"): passing `theme="ingles"` swaps `<html>` to the light scope
 *    instead (`data-theme="ingles"`, no `dark` class) — see the `theme` prop
 *    below. `src/styles/global.css` carries both scopes' token values; there
 *    is still no toggle, no persistence and no no-flash script, because the
 *    scope is a per-ROUTE prop, decided at render time, never a visitor
 *    preference.
 *  - SEO/social meta + a11y polish (design decision #7, PR 5): optional
 *    `description` / `ogImage` props feed the meta description and Open Graph /
 *    Twitter card tags; a skip-to-content link is the FIRST body element and
 *    targets `<main id="content">`; the favicon is an inline SVG data-URI (no
 *    binary asset).
 *  - Scroll-reveal motion (design decision #6, PR 5): an inline module script
 *    runs `initReveals()` on `DOMContentLoaded` and again after Astro View
 *    Transitions swaps (`astro:after-swap`) so `.reveal` elements fade up.
 *  - Opt-in FULL-HEIGHT mode (`fullHeight` prop, floating side toolbar pass,
 *    owner request): every page defaults to normal document flow
 *    (`min-h-screen` — the page grows with its content and the WHOLE
 *    document scrolls). A page that passes `fullHeight` additionally gets,
 *    at `lg:` only, `body` pinned to exactly one viewport tall
 *    (`lg:h-dvh lg:overflow-hidden`) and `<main>` bounded to the remaining
 *    space after the header/footer (`lg:min-h-0 lg:overflow-hidden`, on top
 *    of its own already-unconditional `flex-1`) — so the PAGE never scrolls
 *    at `lg:`, and it is entirely up to that page's own content to decide
 *    what (if anything) scrolls internally. Below `lg:`, `fullHeight` is a
 *    complete no-op: every page, including one that passes it, keeps
 *    ordinary scrolling on a narrow screen. The activity editor
 *    (`src/pages/[lang]/crear/[id].astro`) is the first user of this.
 *  - "Smart" header/footer visibility (chrome-visibility feature):
 *    `src/lib/chromeVisibility.ts` owns every rule (scroll-direction header,
 *    reveal-at-the-bottom footer, the stricter "immersive" behavior on
 *    Inglés pages); this file only provides the two things that MUST run
 *    server-side / before first paint:
 *      1. A tiny classic (non-module) `is:inline` script, early in `<head>`,
 *         that reads the `data-theme` attribute already on `<html>` (see
 *         `isIngles` below) and tags `<html>` with the SAME attributes
 *         `initChromeVisibility` keeps in sync afterwards — so an Inglés
 *         page's header/footer start hidden with NO flash of them being
 *         visible first. It is deliberately NOT the real module (which
 *         would defer past first paint); the few lines it duplicates are
 *         kept intentionally tiny so there is almost nothing to drift.
 *      2. `data-full-height` on `<html>`, mirroring the `fullHeight` prop:
 *         `global.css` uses it to keep TODAY's behavior (chrome always
 *         visible) at `lg:` and up on a `fullHeight` page, where the page
 *         itself never scrolls and the header/footer already bound
 *         `<main>` — see that file's own comment (owner decision).
 *      3. `data-chrome-hub` on `<html>` ("desktop" redesign PART 1 scope
 *         extension, owner spec 2026-10-06, item C): true only for the
 *         Inglés hub (`isInglesHubPath`, `@lib/backNavigation` — the SAME
 *         check the back button uses, computed server-side here instead of
 *         re-derived from the URL twice). The hub's header starts visible
 *         with no flash (see the inline script below); `global.css` keys its
 *         scroll-snap rules off this same attribute directly, with no JS
 *         dependency at all.
 *    `initChromeVisibility()` (the body script element below) does the rest:
 *    every page gets `data-chrome-js` once it runs, which is what gates the
 *    new CSS on — no JS / JS failed means the header/footer stay fully
 *    visible exactly as before this feature.
 */
import { ClientRouter, fade } from 'astro:transitions';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import NavProgressBar from '@components/layout/NavProgressBar.astro';
import MinimizedWindowsTray from '@components/ingles/MinimizedWindowsTray.astro';
import ScrollToTop from '@components/islands/ScrollToTop';
import Toaster from '@components/islands/Toaster';
// Visual-identity styles (PR 2). `fonts.css` self-hosts Raleway Variable
// (font-display: swap baked into the @font-face blocks); `global.css` applies
// the display-font heading rule, the Andean pattern mask, and the skip-link
// helper. Astro bundles these once and injects them into every page's <head>.
import '@styles/fonts.css';
import '@styles/global.css';
import { UI_LABELS, SUPPORTED_LANGS, type Lang } from '@lib/i18n';
import {
  canonicalUrl,
  hreflangAlternates,
  defaultHreflangAlternate,
  isNoindexPath,
} from '@lib/seo';
import { isInglesHubPath } from '@lib/backNavigation';
import { getWebAnalyticsBeaconPayload } from '@lib/webAnalytics';

interface Props {
  /** Active locale for the `<html lang>` attribute. */
  lang?: Lang;
  /** Optional document title. */
  title?: string;
  /**
   * Optional meta description for SEO / social cards (decision #7). Falls back
   * to the localized site description when omitted.
   */
  description?: string;
  /** Optional absolute/relative image URL for `og:image` + Twitter card. */
  ogImage?: string;
  /** Opt-in, `lg:`-only non-scrolling body — see the file header. Defaults to `false` (normal document flow) for every existing page. */
  fullHeight?: boolean;
  /**
   * Opt-in light visual scope (visual-theme pass, "dark brand, light
   * product"). Omitted (every existing page): `<html>` keeps today's
   * `class="dark"`, unchanged. `'ingles'`: `<html>` gets
   * `data-theme="ingles"` instead and drops the `dark` class, so
   * `src/styles/global.css`'s `[data-theme="ingles"]` scope takes over —
   * see that file's own header for the token table. The header, footer, nav
   * progress bar and global scroll-to-top button are NOT part of this swap:
   * they render inside their own `[data-theme="brand"]` + `class="dark"`
   * wrapper below, unconditionally, so the site's chrome stays exactly as
   * today even on a `theme="ingles"` page.
   */
  theme?: 'ingles';
  /**
   * Opt-in BARE mode (presentation mode v1, "Preguntas"): drops the four
   * chrome wrappers described above — nav progress bar, header, footer and
   * the global scroll-to-top button — so the page is exactly its own
   * `<main>` content, full-bleed. Defaults to `false` (every existing page,
   * unchanged). The skip-link, SEO/social meta, favicon, `ClientRouter` and
   * scroll-reveal init all stay — only the four CHROME wrappers are
   * conditional. The one current caller
   * (`[lang]/ingles/actividades/[id]/presentar.astro`) also passes
   * `theme="ingles"` and `fullHeight`, but `bare` itself does not require
   * either — it only ever touches the chrome, never the theme scope or the
   * `fullHeight` body/main classes.
   */
  bare?: boolean;
  /**
   * "Desktop" redesign PART 6a (owner spec 2026-10-06): true on a page that
   * renders the Inglés desk (`DeskScene.astro`) BEHIND something else — so
   * far, only the practice page's window, for a signed-in visitor. Widens
   * the existing hub-only `html[data-chrome-hub] main { view-transition-
   * name: none; }` rule (`global.css`) to this page too: without it, the
   * desk widgets' frosted glass (`.ingles-glass`) would show the greeting
   * SHARP through them instead of blurred, same Chrome quirk that rule's own
   * comment documents for the hub. Defaults to `false` (every existing
   * page, including the hub itself, which already matches via
   * `data-chrome-hub`).
   */
  deskBehind?: boolean;
  /**
   * EMBEDDED mode (window-manager architecture, replacing the
   * one-SSR-route-per-window model — `@lib/deskWindowsState`'s own header on
   * WHY: opening a window used to navigate the desk route away, resetting
   * the helper's tip bubble). True when a window route's own frontmatter
   * decided the request is for its window CONTENT, loaded inside the host's
   * `<iframe>` (`@lib/ui/embeddedWindow#isEmbeddedWindowRequest`) — never
   * set directly by a page; every window route derives it the same way.
   *
   * Implies `bare` (no nav progress bar/header/footer/global scroll-to-top —
   * the host page owns all of that) PLUS three things `bare` alone does not:
   * no `ClientRouter` (so in-window navigations stay real iframe
   * navigations, which is what keeps `Sec-Fetch-Dest: iframe` — and
   * therefore embedded mode itself — "sticky" across them with no extra
   * wiring), no `MinimizedWindowsTray` (the host renders ONE live tray from
   * its own window-manager state, not a per-page one reading
   * `sessionStorage`), and no analytics beacon (an iframe's own page view is
   * not a visit in its own right). `data-desk-window-embedded` is also set
   * on `<html>` — `deskWindow.ts`/`deskWindowDrag.ts` read it client-side to
   * `postMessage` the host instead of navigating/translating locally.
   */
  embedded?: boolean;
  /**
   * True when the `overlay` slot holds the window-manager's own container
   * (`DeskWindowManager.astro`, window-manager architecture) rather than a
   * single always-open `DeskWindow` (the model still used by an EMBEDDED
   * page — see `embedded`'s own doc above — and by the unchanged guest
   * path). The manager's own window count changes dynamically, client-side,
   * with no new page load, so this file cannot decide body-scroll-lock or
   * the tray's mobile-hide rule from slot presence alone the way it always
   * has — the manager owns both itself instead, toggling them once at
   * least one of its OWN windows is actually open (non-minimized) — see
   * `deskWindowManager.ts`'s own header. Defaults to `false` — the
   * embedded/guest single-window path keeps today's STATIC behavior,
   * unchanged.
   */
  windowManager?: boolean;
}

const {
  lang = 'es',
  title = 'ChuyoCode',
  description,
  ogImage,
  fullHeight = false,
  theme,
  bare = false,
  deskBehind = false,
  embedded = false,
  windowManager = false,
} = Astro.props;

// Every chrome wrapper `bare` already drops stays dropped for an embedded
// window too — see the `embedded` prop's own doc above for the three EXTRA
// things embedded mode drops on top of that (ClientRouter, the tray, analytics).
const effectiveBare = bare || embedded;

const isIngles = theme === 'ingles';

/**
 * "Desktop" redesign (owner spec 2026-10-07, "prescindir del header
 * normal"): true for every desk HOST page — the hub, and every window
 * route's host shell for a SIGNED-IN visitor (`windowManager`/`deskBehind`
 * are only ever both true together, only ever for that exact case — see
 * each page's own frontmatter). Those pages drop the site `<Header>`
 * entirely; `DeskHost.astro` renders its own desk-integrated logo/account
 * row instead (`DeskChrome.astro`). The one Inglés page this does NOT cover
 * is a GUEST's window (`hostMode` false there) — its header keeps rendering
 * exactly as before, simply hidden behind that window's own full-screen
 * veil (owner instruction: "keep that exactly as is").
 */
const isDeskHost = isIngles && (windowManager || deskBehind);

/**
 * Does this page pass anything into the `overlay` slot below — the
 * practice/creator pages' own `DeskWindow`, rendered with `slot="overlay"`
 * (`[id].astro`'s own header) rather than the default slot, so it paints
 * OUTSIDE `<main>` and after the footer (see that slot's own comment).
 *
 * Two things key off this, both PART 6c (owner spec 2026-10-07) now that the
 * window is a non-modal FLOATING window rather than a full-viewport modal:
 * the `<body>` below locks page scroll while it is true (the window handles
 * its own internal scrolling — nothing behind it should also scroll), and
 * `MinimizedWindowsTray.astro` hides itself below the `desk:` breakpoint
 * while it is true (a window there is still full screen and would have its
 * own bottom action bar covered by the tray). The header/footer are no
 * longer `inert` here — PART 6a-6b's modal window made them unreachable
 * while a window was open; the desk and the header both stay fully usable
 * now.
 */
const hasOverlay = Astro.slots.has('overlay');
// See the `windowManager` prop's own doc above — the manager owns the
// scroll-lock/tray-hide decision dynamically once it exists; this file only
// ever applies it STATICALLY for the single-always-open-window model.
const staticOverlayLock = hasOverlay && !windowManager;

// "Desktop" redesign PART 1 scope extension (owner spec 2026-10-06, item C):
// the hub is the ONE Inglés page whose header stays always visible and
// whose footer gets scroll-snap — `chromeVisibility.ts`/`global.css` key off
// this attribute (set server-side here, the same way `data-theme` already
// is, rather than re-deriving it from the URL client-side). Reuses the SAME
// hub-path check `backNavigation.ts` uses for the back button.
const isInglesHub = isIngles && isInglesHubPath(Astro.url.pathname);

// Localized fallback description keeps every page indexable even when a page
// forgets to pass its own (decision #7: meta description always present).
const metaDescription = description ?? UI_LABELS[lang].meta.siteDescription;

// SEO basics pass: canonical/hreflang/robots derive from `site`
// (astro.config.mjs) + the current path, never from the request's own host —
// so a Netlify branch deploy or preview URL is never canonicalized to ITSELF.
// `alternates`/`defaultAlternate` are `[]`/`undefined` for the few routes this
// layout never renders for anyway (`/sitemap.xml`, `/robots.txt`, `/api/*`).
const canonical = canonicalUrl(Astro.site, Astro.url.pathname);
const alternates = hreflangAlternates(Astro.url.pathname, Astro.site);
const defaultAlternate = defaultHreflangAlternate(alternates);
// Gated sections (admin/auth/crear/mis-actividades/cursos, and `ingles/**`
// except the two guest-play activity routes) are rendered but excluded from
// search results — see `@lib/seo.ts#isNoindexPath` for the exact rule.
const noindex = isNoindexPath(Astro.url.pathname);

// Cloudflare Web Analytics (cookieless page views, launch "must"): `null`
// while PUBLIC_CF_WEB_ANALYTICS_TOKEN is unset, same inert-by-construction
// posture as Turnstile/Sentry in this repo — see `@lib/webAnalytics`'s own
// header. No script element renders, and no Cloudflare origin appears in
// the page at all, until it is set at build time.
const webAnalyticsBeacon = getWebAnalyticsBeaconPayload();

/** `og:locale` per language (Facebook's `xx_YY` format). `es_PE`/`en_US`
 * mirror the locale strings this codebase already formats dates with
 * elsewhere (`legal/[page].astro`, `noticias/[slug].astro`). */
const OG_LOCALE: Record<Lang, string> = { es: 'es_PE', en: 'en_US' };

// Computed here (server-side) so the global `ScrollToTop` — hydrated on
// EVERY page — only ever receives the one string it needs as a plain prop,
// never the full `UI_LABELS` dictionary. See that component's own props doc.
const scrollToTopLabels = { scrollToTop: UI_LABELS[lang].common.scrollToTop };

// SVG favicon from public/chuyocode.svg (decision #7: no binary asset).
// Served at the root URL so the browser can cache it across pages.
const faviconSvg =
  "/chuyocode.svg";
---

<!doctype html>
<html
  lang={lang}
  data-theme={isIngles ? 'ingles' : undefined}
  data-full-height={fullHeight ? '' : undefined}
  data-chrome-hub={isInglesHub ? '' : undefined}
  data-desk-behind={deskBehind ? '' : undefined}
  data-desk-window-embedded={embedded ? '' : undefined}
  class:list={['scroll-smooth', !isIngles && 'dark']}
>
  <head>
    <meta charset="utf-8" />
    {/* Chrome-visibility no-flash gate (see this file's own header): a
        classic, synchronous script element — NOT a module, which would
        defer past first paint — so an Inglés page's header/footer are
        already tagged hidden before the browser paints anything. Mirrors
        `createInitialChromeState`/`initChromeVisibility` in
        `src/lib/chromeVisibility.ts`, which re-derive and keep these same
        attributes in sync from here on (including across View Transitions
        navigations) — this element's only job is the very first paint. */}
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var ingles = html.getAttribute('data-theme') === 'ingles';
        // The hub's own attribute is already server-rendered above (same
        // spot `data-theme` itself is set) — read it rather than
        // re-deriving it from the URL here, so there is only ONE place that
        // decides "is this the hub" (`isInglesHubPath`, `backNavigation.ts`).
        var hub = html.hasAttribute('data-chrome-hub');
        // PART 6c bugfix (owner spec 2026-10-07, defect #1): a page that
        // renders the desk BEHIND an open `DeskWindow` (`data-desk-behind`,
        // server-rendered by this same file's own `deskBehind` prop) must
        // look exactly like the hub around that window — same header,
        // always visible, never collapsed — see `chromeVisibility.ts`'s own
        // matching `headerAlwaysVisible` for why.
        var deskBehind = html.hasAttribute('data-desk-behind');
        html.setAttribute('data-chrome-js', '');
        html.setAttribute('data-chrome-mode', ingles ? 'ingles' : 'site');
        // "Desktop" redesign PART 1, item C: the hub's header starts
        // visible immediately — no flash of it being hidden first. Same for
        // a desk-behind page now (defect #1 above).
        html.setAttribute('data-header-visible', ingles ? (hub || deskBehind ? 'true' : 'false') : 'true');
        html.setAttribute('data-footer-visible', 'false');
      })();
    </script>
    {/* Recursion guard (window-manager architecture): a HOST page (one that
        was NOT rendered embedded — no `data-desk-window-embedded` above)
        must never itself end up running INSIDE an iframe. The one way that
        could happen here is the window manager's own `<iframe>` loading a
        plain in-window link that, for whatever reason, did not carry
        `Sec-Fetch-Dest: iframe` (an older browser — this header is the
        PRIMARY signal, see `@lib/ui/embeddedWindow`'s own header) — this is
        the fallback net under that primary signal, not a replacement for it.
        `location.replace` (never a plain navigation) so the detour never
        enters this tab's own history. Classic/`is:inline`, same reasoning as
        the script above: must run before first paint, so a host page never
        flashes its own full chrome inside the iframe first.

        BUG FIX (owner report, verified in a real browser): NEVER retries
        once `?ventana=1` is already on the URL — a page whose own
        frontmatter never calls `isEmbeddedWindowRequest` at all (`404.astro`
        is the one that actually reproduced this) never sets
        `data-desk-window-embedded` no matter how many times it reloads with
        that param present, so the old unconditional retry replaced the
        frame's own location with the SAME url forever: an infinite reload
        loop that never let the frame's own `load` event settle, which is
        what the host's own chrome-less fallback bar
        (`@lib/ui/deskWindowManager.ts`) needs to ever show at all. This exact
        decision is also a tested, pure function
        (`@lib/ui/embeddedWindow#shouldRetryAsEmbeddedFrame`) — duplicated
        here rather than imported, since a classic `is:inline` script has no
        module system to import one with. */}
    <script is:inline>
      (function () {
        if (document.documentElement.hasAttribute('data-desk-window-embedded')) return;
        try {
          if (window.self === window.top) return;
          var url = new URL(window.location.href);
          if (url.searchParams.get('ventana') === '1') return;
          url.searchParams.set('ventana', '1');
          window.location.replace(url.toString());
        } catch (e) {
          // Same-origin by construction (the window manager only ever opens
          // routes on this site) — a thrown `window.top` access would mean
          // something unexpected embedded this page; nothing safe to do
          // about that here.
        }
      })();
    </script>
    {/* Click-race bugfix (robustness pass, owner report): right after a
        window loads, a fast click on a `[data-desk-open-window]` link (an
        `ActivityCard`, the community window's own "+" shortcut) could
        navigate the IFRAME IN PLACE instead of asking the host to open a new
        window — `@lib/ui/deskWindow.ts#initDeskOpenWindowLinks` wires its own
        capture-phase listener from a `type="module"` script
        (`DeskWindow.astro`'s own), which is deferred past first paint, so
        there was always a small window where a click could land before it
        ever ran. This is the SAME interception, duplicated here (same
        reasoning as the recursion-guard script above) as a plain classic
        `is:inline` script — parsed and run synchronously, before the browser
        can dispatch any click at all. It sets the exact same
        `data-desk-open-window-links-ready` marker that module function
        checks, so once THIS has wired the listener, the later module import
        is a harmless no-op rather than a second listener. */}
    <script is:inline>
      (function () {
        var html = document.documentElement;
        if (!html.hasAttribute('data-desk-window-embedded')) return;
        if (html.dataset.deskOpenWindowLinksReady === 'true') return;
        html.dataset.deskOpenWindowLinksReady = 'true';

        document.addEventListener(
          'click',
          function (event) {
            if (event.defaultPrevented || event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            var target = event.target;
            if (!(target instanceof Element)) return;
            var opener = target.closest('[data-desk-open-window]');
            if (!opener || opener.tagName !== 'A') return;
            var href = opener.getAttribute('href');
            if (!href) return;

            event.preventDefault();
            var ariaLabel = (opener.getAttribute('aria-label') || '').trim();
            var text = (opener.textContent || '').trim();
            var title = ariaLabel || text;
            try {
              var parent = window.parent;
              if (!parent || parent === window) return;
              parent.postMessage(
                { source: 'desk-window', type: 'open-window', href: href, title: title || null },
                window.location.origin,
              );
            } catch (e) {
              // Best-effort — a sandboxed or otherwise unusual embedding
              // context just loses this one message, same posture as
              // `deskWindowMessaging.ts#postDeskWindowMessage`.
            }
          },
          true,
        );
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    {/* SEO + social meta (decision #7). Description falls back to the localized
        site description; OG/Twitter tags let shared links render rich cards. */}
    <meta name="description" content={metaDescription} />
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />

    {/* Canonical + hreflang (SEO basics pass): every page in this layout
        gets a canonical link; a lang-prefixed page additionally gets an
        alternate per supported language plus `x-default` -> es. */}
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    {defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
    )}
    {/* Gated sections stay rendered (the gate itself decides who sees them)
        but excluded from search results — see the `noindex` const above. */}
    {noindex && <meta name="robots" content="noindex" />}

    {/* SPA-feel navigation via native View Transitions (frontend-v3 PR3.5).
        reveal.ts already re-runs on astro:after-swap, so scroll reveals keep
        working across client-side navigations. EMBEDDED (window-manager
        architecture): dropped entirely — a `ClientRouter`-driven swap would
        intercept a plain in-window link client-side instead of letting it be
        a REAL iframe navigation, which is exactly what keeps
        `Sec-Fetch-Dest: iframe` (and therefore embedded mode itself) sticky
        across filters/pagination/cards with no extra wiring — see
        `@lib/ui/embeddedWindow`'s own header. */}
    {!embedded && <ClientRouter />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {SUPPORTED_LANGS.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <slot name="head" />

    {/* Cloudflare Web Analytics (cookieless page views, launch "must"):
        rendered LAST in <head> — Cloudflare's own docs ask for this element
        immediately before the closing head tag, which is only guaranteed by
        placing it after `slot name="head"`, since a page can add its own
        content there. `is:inline` keeps the element exactly as Cloudflare
        documents it, untouched by Astro's own script processing/bundling —
        same reasoning as the chrome-visibility script element above.

        Rendered UNCONDITIONALLY, including on a `bare` presentation page
        (see the `bare` prop doc above): this beacon has no dependency on
        the chrome `bare` strips, and coupling page-view tracking to that
        prop would add a second switch to reason about for no behavioral
        gain. `webAnalyticsBeacon` is `null` (see `@lib/webAnalytics`) —
        and this renders nothing at all, on EVERY page — until the owner
        sets PUBLIC_CF_WEB_ANALYTICS_TOKEN at build time.

        EMBEDDED is the one exception (window-manager architecture): an
        iframe loading a window's own content is not a visit in its own
        right — the HOST page (already rendering this same beacon, non-
        embedded) is what actually counts as the page view. */}
    {!embedded && webAnalyticsBeacon && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={webAnalyticsBeacon}
      ></script>
    )}
  </head>
  <body
    class:list={[
      'flex min-h-screen flex-col bg-surface text-foreground antialiased transition-theme duration-theme dark:bg-surface',
      fullHeight && 'lg:h-dvh lg:overflow-hidden',
      // PART 6c (owner spec 2026-10-07): the floating desk window handles its
      // own internal scrolling (`DeskWindow.astro`'s own body slot) — lock
      // the page itself so the desk behind a NON-MODAL window can never
      // scroll independently of it (it would otherwise drift out from under
      // a window that stays `fixed` to the viewport).
      staticOverlayLock && 'overflow-hidden h-dvh',
    ]}
  >
    {/* Navigation progress bar (navigation-without-flicker PR): fixed at the
        very top, ahead of everything else in the body so it is never
        obscured. Hidden by default; `NavProgressBar.astro`'s own script
        drives it from ClientRouter events.

        `data-theme="brand"` + `class="dark"` (visual-theme pass): this is
        site CHROME, not product content, so it stays dark even on a
        `theme="ingles"` page — see `global.css`'s own header for the scope.
        `contents` keeps the wrapper out of layout entirely (it generates no
        box of its own), so it is transparent to `NavProgressBar`'s `fixed`
        positioning. BARE mode (presentation mode v1) drops this wrapper
        along with the other three chrome pieces below — see `bare`'s own
        prop doc above. EMBEDDED implies `bare` — see that prop's own doc. */}
    {!effectiveBare && (
      <div data-theme="brand" class="dark contents">
        <NavProgressBar />
      </div>
    )}

    {/* Skip-to-content link — FIRST focusable body element (decision #7 / a11y).
        Off-screen until focused (`.skip-link` in global.css), then jumps keyboard
        and screen-reader users straight to <main id="content">. */}
    <a href="#content" class="skip-link">
      {lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}
    </a>
    {/* Brand chrome (visual-theme pass) — see the note on the progress bar
        above. `contents` keeps `Header`'s own `sticky top-0` working exactly
        as if this wrapper were not there. BARE mode drops it.

        INGLÉS (owner spec 2026-10-05): the header/footer stop being forced
        dark brand chrome here — they render INSIDE the page's own light
        `[data-theme="ingles"]` scope instead (no wrapper at all), so
        `Header`'s `ingles` branch picks up the light palette via the same
        semantic tokens every other Inglés surface already uses. Every other
        page is completely unaffected — this branch only ever runs when
        `isIngles` is true. */}
    {!effectiveBare && !isDeskHost &&
      (isIngles ? <Header lang={lang} ingles /> : (
        <div data-theme="brand" class="dark contents">
          <Header lang={lang} />
        </div>
      ))}
    {/* Cleaner transitions (navigation-without-flicker PR): ONLY the main
        content cross-fades on navigation, a quick ~150ms — matches
        `Header`/`Footer` being excluded (persisted / `animate="none"`), so
        there is never a double-content cross-fade of the whole page. */}
    <main
      id="content"
      class:list={['w-full flex-1', fullHeight && 'lg:min-h-0 lg:overflow-hidden']}
      transition:animate={fade({ duration: 150 })}
    >
      <slot />
    </main>
    {/* Brand chrome (visual-theme pass) — see the nav progress bar's own
        note above. BARE mode drops it. INGLÉS: same unwrapped treatment as
        the header above — see that block's own comment. */}
    {!effectiveBare &&
      (isIngles ? <Footer lang={lang} ingles /> : (
        <div data-theme="brand" class="dark contents">
          <Footer lang={lang} />
        </div>
      ))}

    {/* Global "back to top" button (site-wide). `client:load` like
        `UserMenu` — always-relevant chrome, not below-the-fold content —
        and, same as that island, its SSR markup depends only on `lang`
        (never per-visitor data), so it stays safe on publicly cached pages
        (home, libros, noticias).

        Brand chrome (visual-theme pass): only THIS global instance — the
        SCOPED instance the activity editor mounts for its own block list
        renders straight into the page's own (possibly light) content and
        must NOT be forced dark, which is why this wrapper lives here and not
        inside `ScrollToTop.tsx` itself. BARE mode drops it — a presentation
        stage has no page scroll to return from.

        HUB EXCLUDED ("desktop" redesign PART 4, owner feedback): the hub is
        one screen plus the footer (scroll-snap between the two, PART 1),
        and the floating button overlapped the levels dock on phones — with
        no long page to scroll back up FROM, it has no job to do there
        either. Every other Inglés page (and every non-Inglés page) keeps
        it unchanged. */}
    {!effectiveBare && !isInglesHub && (
      <div data-theme="brand" class="dark contents">
        <ScrollToTop client:load labels={scrollToTopLabels} />
      </div>
    )}

    {/* Toast host (PR 1 premium design system): one Toaster per page, backing
        every `toast()` call across features (autosave error, share-link
        copied, submitted for review, duplicated, report sent). Its own SSR
        markup renders nothing visible until a toast is pushed, so it is safe
        on publicly cached pages just like `ScrollToTop`. */}
    <Toaster client:load />

    {/* Scroll-reveal init (decision #6). A module script so we can import
        `initReveals`; runs on first load and again after every Astro View
        Transitions swap so `.reveal` elements on the incoming page animate. */}
    <script>
      import { initReveals } from '@lib/reveal';
      import { initBackButtons, trackPageVisit } from '@lib/backNavigation';
      import { initChromeVisibility } from '@lib/chromeVisibility';
      import { initDeskSceneWidgets } from '@lib/ui/deskScene';
      import { isEmbeddedWindowDom } from '@lib/ui/deskWindowMessaging';

      // EMBEDDED (window-manager architecture): none of this site-chrome
      // wiring has anything to do inside a window's own iframe — no reveal
      // animations worth running behind a window that fills the whole
      // viewport, no header/footer to show/hide, no desk/helper. Self-
      // guarded here (rather than dropping the whole script element) — same
      // low-risk posture as every other desk script's own double-wiring
      // guard.
      if (!isEmbeddedWindowDom(document)) {

      const run = () => initReveals();

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run, { once: true });
      } else {
        run();
      }

      // Re-run after client-side navigations (View Transitions safety).
      document.addEventListener('astro:after-swap', run);

      // Back-navigation bugfix (2026-10-06, `@lib/backNavigation.ts`'s own
      // header): records "the screen this visitor actually just saw" in
      // `sessionStorage`, since `document.referrer` goes permanently stale
      // after this tab's first client-side navigation. Runs on first load
      // AND every `astro:page-load` (unlike `initBackButtons` below, this
      // one must re-run per page — it is per-VISIT state, not a one-time
      // listener bind).
      const trackVisit = () => trackPageVisit(`${window.location.pathname}${window.location.search}`);
      trackVisit();
      document.addEventListener('astro:page-load', trackVisit);

      // `BackButton`'s progressive enhancement: ONE delegated listener for
      // the whole session — `document` survives View Transitions swaps, so
      // (unlike reveals) this needs no re-init on `astro:after-swap`.
      initBackButtons();

      // Smart header/footer visibility (chrome-visibility feature): binds
      // its own listeners exactly once and re-picks the mode on every page
      // entry (including View Transitions) internally — see that module's
      // own header.
      initChromeVisibility();

      // BUGFIX (owner report 2026-10-07): the desk's clock/calendar/weather
      // widgets and its drag-to-rearrange used to be wired ONLY from the hub
      // page's own script (`[lang]/ingles/index.astro`) — a direct load of a
      // page that renders the SAME desk BEHIND a window (`deskBehind`:
      // practice/community/create/editor) never ran it at all, leaving a
      // hand-less clock and a date-less calendar. Site-wide and here
      // instead, same "self-guards on a page with no desk" posture as
      // `initBackButtons` above — see `@lib/ui/deskScene`'s own
      // header. Runs on first load AND every `astro:page-load` (a desk
      // behind a window, or the hub itself, reached by a client-side
      // navigation from another such page).
      const runDeskSceneWidgets = () => initDeskSceneWidgets();
      runDeskSceneWidgets();
      document.addEventListener('astro:page-load', runDeskSceneWidgets);

      } // isEmbeddedWindowDom guard
    </script>

    {/* Overlay slot (PART 6a bugfix, 2026-10-06) — after the footer and
        every other chrome piece above, outside `<main>` entirely. Today's
        callers are the practice/creator pages' own `DeskWindow`
        (`slot="overlay"`): rendering it here instead of in the default slot
        is what stops the footer from painting OVER the window (see
        `global.css`'s own `.ingles-window` comment for the stacking-context
        mechanics). Nothing else currently uses this slot, so it is a no-op
        everywhere else. */}
    <slot name="overlay" />

    {/* Minimized-windows tray (PART 6c) — mounted on every Inglés HOST page
        (never an embedded window's own iframe — the host renders ONE live
        tray from its own window-manager state, not a per-page one reading
        `sessionStorage`; see `embedded`'s own prop doc above), AFTER the
        overlay slot, so it stays above an open window
        (`MinimizedWindowsTray.astro`'s own header on the stacking/`z-index`
        reasoning). A no-op render (an empty, `hidden` tray) on a page with
        nothing minimized, same posture as every other desk script. */}
    {isIngles && !embedded && <MinimizedWindowsTray lang={lang} hasOverlay={staticOverlayLock} />}
  </body>
</html>

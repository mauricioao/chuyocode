---
/**
 * BaseLayout — wraps every page (spec 7: BaseLayout requirement).
 *
 * Responsibilities:
 *  - `<html lang>` driven by the `lang` prop (i18n, defaults to "es").
 *  - Global Tailwind styles are injected by `@astrojs/tailwind`
 *    (`applyBaseStyles: true` in astro.config.mjs), so no manual CSS import.
 *  - A `<slot name="head">` for page-specific meta/title/link tags.
 *  - The default `<slot>` for body content, wrapped by Header + Footer.
 *  - Dark mode is HARDCODED: `<html class="dark">` ships on every page and the
 *    site is dark-only (no theme toggle, no persistence, no no-flash script),
 *    EXCEPT the Inglés product (visual-theme pass, "dark brand, light
 *    product"): passing `theme="ingles"` swaps `<html>` to the light scope
 *    instead (`data-theme="ingles"`, no `dark` class) — see the `theme` prop
 *    below. `src/styles/global.css` carries both scopes' token values; there
 *    is still no toggle, no persistence and no no-flash script, because the
 *    scope is a per-ROUTE prop, decided at render time, never a visitor
 *    preference.
 *  - SEO/social meta + a11y polish (design decision #7, PR 5): optional
 *    `description` / `ogImage` props feed the meta description and Open Graph /
 *    Twitter card tags; a skip-to-content link is the FIRST body element and
 *    targets `<main id="content">`; the favicon is an inline SVG data-URI (no
 *    binary asset).
 *  - Scroll-reveal motion (design decision #6, PR 5): an inline module script
 *    runs `initReveals()` on `DOMContentLoaded` and again after Astro View
 *    Transitions swaps (`astro:after-swap`) so `.reveal` elements fade up.
 *  - Opt-in FULL-HEIGHT mode (`fullHeight` prop, floating side toolbar pass,
 *    owner request): every page defaults to normal document flow
 *    (`min-h-screen` — the page grows with its content and the WHOLE
 *    document scrolls). A page that passes `fullHeight` additionally gets,
 *    at `lg:` only, `body` pinned to exactly one viewport tall
 *    (`lg:h-dvh lg:overflow-hidden`) and `<main>` bounded to the remaining
 *    space after the header/footer (`lg:min-h-0 lg:overflow-hidden`, on top
 *    of its own already-unconditional `flex-1`) — so the PAGE never scrolls
 *    at `lg:`, and it is entirely up to that page's own content to decide
 *    what (if anything) scrolls internally. Below `lg:`, `fullHeight` is a
 *    complete no-op: every page, including one that passes it, keeps
 *    ordinary scrolling on a narrow screen. The activity editor
 *    (`src/pages/[lang]/crear/[id].astro`) is the first user of this.
 *  - "Smart" header/footer visibility (chrome-visibility feature):
 *    `src/lib/chromeVisibility.ts` owns every rule (scroll-direction header,
 *    reveal-at-the-bottom footer, the stricter "immersive" behavior on
 *    Inglés pages); this file only provides the two things that MUST run
 *    server-side / before first paint:
 *      1. A tiny classic (non-module) `is:inline` script, early in `<head>`,
 *         that reads the `data-theme` attribute already on `<html>` (see
 *         `isIngles` below) and tags `<html>` with the SAME attributes
 *         `initChromeVisibility` keeps in sync afterwards — so an Inglés
 *         page's header/footer start hidden with NO flash of them being
 *         visible first. It is deliberately NOT the real module (which
 *         would defer past first paint); the few lines it duplicates are
 *         kept intentionally tiny so there is almost nothing to drift.
 *      2. `data-full-height` on `<html>`, mirroring the `fullHeight` prop:
 *         `global.css` uses it to keep TODAY's behavior (chrome always
 *         visible) at `lg:` and up on a `fullHeight` page, where the page
 *         itself never scrolls and the header/footer already bound
 *         `<main>` — see that file's own comment (owner decision).
 *      3. `data-chrome-hub` on `<html>` ("desktop" redesign PART 1 scope
 *         extension, owner spec 2026-10-06, item C): true only for the
 *         Inglés hub (`isInglesHubPath`, `@lib/backNavigation` — the SAME
 *         check the back button uses, computed server-side here instead of
 *         re-derived from the URL twice). The hub's header starts visible
 *         with no flash (see the inline script below); `global.css` keys its
 *         scroll-snap rules off this same attribute directly, with no JS
 *         dependency at all.
 *    `initChromeVisibility()` (the body script element below) does the rest:
 *    every page gets `data-chrome-js` once it runs, which is what gates the
 *    new CSS on — no JS / JS failed means the header/footer stay fully
 *    visible exactly as before this feature.
 */
import { ClientRouter, fade } from 'astro:transitions';
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import NavProgressBar from '@components/layout/NavProgressBar.astro';
import ScrollToTop from '@components/islands/ScrollToTop';
import Toaster from '@components/islands/Toaster';
// Visual-identity styles (PR 2). `fonts.css` self-hosts Raleway Variable
// (font-display: swap baked into the @font-face blocks); `global.css` applies
// the display-font heading rule, the Andean pattern mask, and the skip-link
// helper. Astro bundles these once and injects them into every page's <head>.
import '@styles/fonts.css';
import '@styles/global.css';
import { UI_LABELS, SUPPORTED_LANGS, type Lang } from '@lib/i18n';
import {
  canonicalUrl,
  hreflangAlternates,
  defaultHreflangAlternate,
  isNoindexPath,
} from '@lib/seo';
import { isInglesHubPath } from '@lib/backNavigation';

interface Props {
  /** Active locale for the `<html lang>` attribute. */
  lang?: Lang;
  /** Optional document title. */
  title?: string;
  /**
   * Optional meta description for SEO / social cards (decision #7). Falls back
   * to the localized site description when omitted.
   */
  description?: string;
  /** Optional absolute/relative image URL for `og:image` + Twitter card. */
  ogImage?: string;
  /** Opt-in, `lg:`-only non-scrolling body — see the file header. Defaults to `false` (normal document flow) for every existing page. */
  fullHeight?: boolean;
  /**
   * Opt-in light visual scope (visual-theme pass, "dark brand, light
   * product"). Omitted (every existing page): `<html>` keeps today's
   * `class="dark"`, unchanged. `'ingles'`: `<html>` gets
   * `data-theme="ingles"` instead and drops the `dark` class, so
   * `src/styles/global.css`'s `[data-theme="ingles"]` scope takes over —
   * see that file's own header for the token table. The header, footer, nav
   * progress bar and global scroll-to-top button are NOT part of this swap:
   * they render inside their own `[data-theme="brand"]` + `class="dark"`
   * wrapper below, unconditionally, so the site's chrome stays exactly as
   * today even on a `theme="ingles"` page.
   */
  theme?: 'ingles';
  /**
   * Opt-in BARE mode (presentation mode v1, "Preguntas"): drops the four
   * chrome wrappers described above — nav progress bar, header, footer and
   * the global scroll-to-top button — so the page is exactly its own
   * `<main>` content, full-bleed. Defaults to `false` (every existing page,
   * unchanged). The skip-link, SEO/social meta, favicon, `ClientRouter` and
   * scroll-reveal init all stay — only the four CHROME wrappers are
   * conditional. The one current caller
   * (`[lang]/ingles/actividades/[id]/presentar.astro`) also passes
   * `theme="ingles"` and `fullHeight`, but `bare` itself does not require
   * either — it only ever touches the chrome, never the theme scope or the
   * `fullHeight` body/main classes.
   */
  bare?: boolean;
  /**
   * "Desktop" redesign PART 6a (owner spec 2026-10-06): true on a page that
   * renders the Inglés desk (`DeskScene.astro`) BEHIND something else — so
   * far, only the practice page's window, for a signed-in visitor. Widens
   * the existing hub-only `html[data-chrome-hub] main { view-transition-
   * name: none; }` rule (`global.css`) to this page too: without it, the
   * desk widgets' frosted glass (`.ingles-glass`) would show the greeting
   * SHARP through them instead of blurred, same Chrome quirk that rule's own
   * comment documents for the hub. Defaults to `false` (every existing
   * page, including the hub itself, which already matches via
   * `data-chrome-hub`).
   */
  deskBehind?: boolean;
}

const {
  lang = 'es',
  title = 'ChuyoCode',
  description,
  ogImage,
  fullHeight = false,
  theme,
  bare = false,
  deskBehind = false,
} = Astro.props;

const isIngles = theme === 'ingles';

/**
 * PART 6a bugfix (owner spec 2026-10-06): does this page pass anything into
 * the `overlay` slot below — the practice page's own `DeskWindow`, rendered
 * with `slot="overlay"` (`[id].astro`'s own header) rather than the default
 * slot, so it paints OUTSIDE `<main>` and after the footer (see that slot's
 * own comment). While it does, the header/footer sit BEHIND the window's own
 * veil and must be `inert` — unreachable by keyboard/AT, same posture
 * `DeskScene.astro`'s own `inert` prop already gives the desk.
 */
const hasOverlay = Astro.slots.has('overlay');

// "Desktop" redesign PART 1 scope extension (owner spec 2026-10-06, item C):
// the hub is the ONE Inglés page whose header stays always visible and
// whose footer gets scroll-snap — `chromeVisibility.ts`/`global.css` key off
// this attribute (set server-side here, the same way `data-theme` already
// is, rather than re-deriving it from the URL client-side). Reuses the SAME
// hub-path check `backNavigation.ts` uses for the back button.
const isInglesHub = isIngles && isInglesHubPath(Astro.url.pathname);

// Localized fallback description keeps every page indexable even when a page
// forgets to pass its own (decision #7: meta description always present).
const metaDescription = description ?? UI_LABELS[lang].meta.siteDescription;

// SEO basics pass: canonical/hreflang/robots derive from `site`
// (astro.config.mjs) + the current path, never from the request's own host —
// so a Netlify branch deploy or preview URL is never canonicalized to ITSELF.
// `alternates`/`defaultAlternate` are `[]`/`undefined` for the few routes this
// layout never renders for anyway (`/sitemap.xml`, `/robots.txt`, `/api/*`).
const canonical = canonicalUrl(Astro.site, Astro.url.pathname);
const alternates = hreflangAlternates(Astro.url.pathname, Astro.site);
const defaultAlternate = defaultHreflangAlternate(alternates);
// Gated sections (admin/auth/crear/mis-actividades/cursos, and `ingles/**`
// except the two guest-play activity routes) are rendered but excluded from
// search results — see `@lib/seo.ts#isNoindexPath` for the exact rule.
const noindex = isNoindexPath(Astro.url.pathname);

/** `og:locale` per language (Facebook's `xx_YY` format). `es_PE`/`en_US`
 * mirror the locale strings this codebase already formats dates with
 * elsewhere (`legal/[page].astro`, `noticias/[slug].astro`). */
const OG_LOCALE: Record<Lang, string> = { es: 'es_PE', en: 'en_US' };

// Computed here (server-side) so the global `ScrollToTop` — hydrated on
// EVERY page — only ever receives the one string it needs as a plain prop,
// never the full `UI_LABELS` dictionary. See that component's own props doc.
const scrollToTopLabels = { scrollToTop: UI_LABELS[lang].common.scrollToTop };

// SVG favicon from public/chuyocode.svg (decision #7: no binary asset).
// Served at the root URL so the browser can cache it across pages.
const faviconSvg =
  "/chuyocode.svg";
---

<!doctype html>
<html
  lang={lang}
  data-theme={isIngles ? 'ingles' : undefined}
  data-full-height={fullHeight ? '' : undefined}
  data-chrome-hub={isInglesHub ? '' : undefined}
  data-desk-behind={deskBehind ? '' : undefined}
  class:list={['scroll-smooth', !isIngles && 'dark']}
>
  <head>
    <meta charset="utf-8" />
    {/* Chrome-visibility no-flash gate (see this file's own header): a
        classic, synchronous script element — NOT a module, which would
        defer past first paint — so an Inglés page's header/footer are
        already tagged hidden before the browser paints anything. Mirrors
        `createInitialChromeState`/`initChromeVisibility` in
        `src/lib/chromeVisibility.ts`, which re-derive and keep these same
        attributes in sync from here on (including across View Transitions
        navigations) — this element's only job is the very first paint. */}
    <script is:inline>
      (function () {
        var html = document.documentElement;
        var ingles = html.getAttribute('data-theme') === 'ingles';
        // The hub's own attribute is already server-rendered above (same
        // spot `data-theme` itself is set) — read it rather than
        // re-deriving it from the URL here, so there is only ONE place that
        // decides "is this the hub" (`isInglesHubPath`, `backNavigation.ts`).
        var hub = html.hasAttribute('data-chrome-hub');
        html.setAttribute('data-chrome-js', '');
        html.setAttribute('data-chrome-mode', ingles ? 'ingles' : 'site');
        // "Desktop" redesign PART 1, item C: the hub's header starts
        // visible immediately — no flash of it being hidden first.
        html.setAttribute('data-header-visible', ingles ? (hub ? 'true' : 'false') : 'true');
        html.setAttribute('data-footer-visible', 'false');
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>

    {/* SEO + social meta (decision #7). Description falls back to the localized
        site description; OG/Twitter tags let shared links render rich cards. */}
    <meta name="description" content={metaDescription} />
    <link rel="icon" href={faviconSvg} type="image/svg+xml" />

    {/* Canonical + hreflang (SEO basics pass): every page in this layout
        gets a canonical link; a lang-prefixed page additionally gets an
        alternate per supported language plus `x-default` -> es. */}
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.lang} href={alt.href} />
    ))}
    {defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
    )}
    {/* Gated sections stay rendered (the gate itself decides who sees them)
        but excluded from search results — see the `noindex` const above. */}
    {noindex && <meta name="robots" content="noindex" />}

    {/* SPA-feel navigation via native View Transitions (frontend-v3 PR3.5).
        reveal.ts already re-runs on astro:after-swap, so scroll reveals keep
        working across client-side navigations. */}
    <ClientRouter />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    {SUPPORTED_LANGS.filter((l) => l !== lang).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    {ogImage && <meta property="og:image" content={ogImage} />}

    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <slot name="head" />
  </head>
  <body
    class:list={[
      'flex min-h-screen flex-col bg-surface text-foreground antialiased transition-theme duration-theme dark:bg-surface',
      fullHeight && 'lg:h-dvh lg:overflow-hidden',
    ]}
  >
    {/* Navigation progress bar (navigation-without-flicker PR): fixed at the
        very top, ahead of everything else in the body so it is never
        obscured. Hidden by default; `NavProgressBar.astro`'s own script
        drives it from ClientRouter events.

        `data-theme="brand"` + `class="dark"` (visual-theme pass): this is
        site CHROME, not product content, so it stays dark even on a
        `theme="ingles"` page — see `global.css`'s own header for the scope.
        `contents` keeps the wrapper out of layout entirely (it generates no
        box of its own), so it is transparent to `NavProgressBar`'s `fixed`
        positioning. BARE mode (presentation mode v1) drops this wrapper
        along with the other three chrome pieces below — see `bare`'s own
        prop doc above. */}
    {!bare && (
      <div data-theme="brand" class="dark contents">
        <NavProgressBar />
      </div>
    )}

    {/* Skip-to-content link — FIRST focusable body element (decision #7 / a11y).
        Off-screen until focused (`.skip-link` in global.css), then jumps keyboard
        and screen-reader users straight to <main id="content">. */}
    <a href="#content" class="skip-link">
      {lang === 'en' ? 'Skip to content' : 'Saltar al contenido'}
    </a>
    {/* Brand chrome (visual-theme pass) — see the note on the progress bar
        above. `contents` keeps `Header`'s own `sticky top-0` working exactly
        as if this wrapper were not there. BARE mode drops it.

        INGLÉS (owner spec 2026-10-05): the header/footer stop being forced
        dark brand chrome here — they render INSIDE the page's own light
        `[data-theme="ingles"]` scope instead (no wrapper at all), so
        `Header`'s `ingles` branch picks up the light palette via the same
        semantic tokens every other Inglés surface already uses. Every other
        page is completely unaffected — this branch only ever runs when
        `isIngles` is true. */}
    {!bare &&
      (isIngles ? <Header lang={lang} ingles inert={hasOverlay} /> : (
        <div data-theme="brand" class="dark contents">
          <Header lang={lang} inert={hasOverlay} />
        </div>
      ))}
    {/* Cleaner transitions (navigation-without-flicker PR): ONLY the main
        content cross-fades on navigation, a quick ~150ms — matches
        `Header`/`Footer` being excluded (persisted / `animate="none"`), so
        there is never a double-content cross-fade of the whole page. */}
    <main
      id="content"
      class:list={['w-full flex-1', fullHeight && 'lg:min-h-0 lg:overflow-hidden']}
      transition:animate={fade({ duration: 150 })}
    >
      <slot />
    </main>
    {/* Brand chrome (visual-theme pass) — see the nav progress bar's own
        note above. BARE mode drops it. INGLÉS: same unwrapped treatment as
        the header above — see that block's own comment. */}
    {!bare &&
      (isIngles ? <Footer lang={lang} ingles inert={hasOverlay} /> : (
        <div data-theme="brand" class="dark contents">
          <Footer lang={lang} inert={hasOverlay} />
        </div>
      ))}

    {/* Global "back to top" button (site-wide). `client:load` like
        `UserMenu` — always-relevant chrome, not below-the-fold content —
        and, same as that island, its SSR markup depends only on `lang`
        (never per-visitor data), so it stays safe on publicly cached pages
        (home, libros, noticias).

        Brand chrome (visual-theme pass): only THIS global instance — the
        SCOPED instance the activity editor mounts for its own block list
        renders straight into the page's own (possibly light) content and
        must NOT be forced dark, which is why this wrapper lives here and not
        inside `ScrollToTop.tsx` itself. BARE mode drops it — a presentation
        stage has no page scroll to return from.

        HUB EXCLUDED ("desktop" redesign PART 4, owner feedback): the hub is
        one screen plus the footer (scroll-snap between the two, PART 1),
        and the floating button overlapped the levels dock on phones — with
        no long page to scroll back up FROM, it has no job to do there
        either. Every other Inglés page (and every non-Inglés page) keeps
        it unchanged. */}
    {!bare && !isInglesHub && (
      <div data-theme="brand" class="dark contents">
        <ScrollToTop client:load labels={scrollToTopLabels} />
      </div>
    )}

    {/* Toast host (PR 1 premium design system): one Toaster per page, backing
        every `toast()` call across features (autosave error, share-link
        copied, submitted for review, duplicated, report sent). Its own SSR
        markup renders nothing visible until a toast is pushed, so it is safe
        on publicly cached pages just like `ScrollToTop`. */}
    <Toaster client:load />

    {/* Scroll-reveal init (decision #6). A module script so we can import
        `initReveals`; runs on first load and again after every Astro View
        Transitions swap so `.reveal` elements on the incoming page animate. */}
    <script>
      import { initReveals } from '@lib/reveal';
      import { initBackButtons } from '@lib/backNavigation';
      import { initChromeVisibility } from '@lib/chromeVisibility';
      import { initDeskWindowOpeners } from '@lib/ui/deskWindow';

      const run = () => initReveals();

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run, { once: true });
      } else {
        run();
      }

      // Re-run after client-side navigations (View Transitions safety).
      document.addEventListener('astro:after-swap', run);

      // `BackButton`'s progressive enhancement: ONE delegated listener for
      // the whole session — `document` survives View Transitions swaps, so
      // (unlike reveals) this needs no re-init on `astro:after-swap`.
      initBackButtons();

      // "Desktop" redesign PART 6a: captures a `[data-desk-window-open]`
      // folder's own rect just before navigation, for the practice window's
      // scale-in — site-wide (like `initBackButtons`) since the desk only
      // ever renders under Inglés, and the attribute selector simply never
      // matches elsewhere. Self-guards against double-wiring on its own
      // (`@lib/ui/deskWindow.ts`'s own header), so it is safe to call here
      // unconditionally, once per session.
      initDeskWindowOpeners();

      // Smart header/footer visibility (chrome-visibility feature): binds
      // its own listeners exactly once and re-picks the mode on every page
      // entry (including View Transitions) internally — see that module's
      // own header.
      initChromeVisibility();
    </script>

    {/* Overlay slot (PART 6a bugfix, 2026-10-06) — the LAST thing in
        `<body>`, after the footer and every other chrome piece above,
        outside `<main>` entirely. Today's one caller is the practice page's
        own `DeskWindow` (`[id].astro`, `slot="overlay"`): rendering it here
        instead of in the default slot is what stops the footer from
        painting OVER the window (see `global.css`'s own
        `.ingles-window-veil` comment for the stacking-context mechanics).
        Nothing else currently uses this slot, so it is a no-op everywhere
        else. */}
    <slot name="overlay" />
  </body>
</html>

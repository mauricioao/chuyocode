---
/**
 * LangToggle — iOS-style sliding language switch (🇵🇪 ES / 🇺🇸 EN).
 *
 * A pill track with two centered flags and a sliding knob that highlights the
 * active language. Clicking the inactive side animates the knob across, then
 * navigates to that language's version of the current page.
 *
 * The knob position is server-rendered from `lang` (data-lang on the root), so
 * there is no flash: on load the knob is already on the correct side. The
 * click handler adds the slide animation before navigating for a smooth feel.
 *
 * Zero framework — pure CSS transition + a tiny inline script. Accessible:
 * the root is a group with an aria-label; each side is a real link.
 */
import { UI_LABELS, type Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
  esPath: string;
  enPath: string;
}

const { lang, esPath, enPath } = Astro.props;
const switchLabel = UI_LABELS[lang].nav.switchTo;
---

<div class="lang-toggle" data-lang={lang} role="group" aria-label={switchLabel}>
  <span class="lang-toggle__knob" aria-hidden="true"></span>
  <a
    href={esPath}
    class="lang-toggle__side"
    data-target="es"
    aria-current={lang === 'es' ? 'page' : undefined}
    title="Español (Perú)"
  >
    <span class="lang-toggle__flag">🇵🇪</span>
  </a>
  <a
    href={enPath}
    class="lang-toggle__side"
    data-target="en"
    aria-current={lang === 'en' ? 'page' : undefined}
    title="English (US)"
  >
    <span class="lang-toggle__flag">🇺🇸</span>
  </a>
</div>

<style>
  .lang-toggle {
    position: relative;
    display: inline-flex;
    align-items: center;
    width: 4.75rem;
    height: 2.1rem;
    padding: 0.2rem;
    border-radius: 9999px;
    border: 1px solid theme('colors.base.muted');
    background: theme('colors.base.soft');
    /* Apple-style inset depth */
    box-shadow:
      inset 0 1px 2px rgba(0, 0, 0, 0.35),
      0 1px 0 rgba(255, 255, 255, 0.04);
    user-select: none;
  }

  /* Sliding knob — sits UNDER the flags and highlights the active side. */
  .lang-toggle__knob {
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: calc(50% - 0.2rem);
    height: calc(100% - 0.4rem);
    border-radius: 9999px;
    background: theme('colors.accent.DEFAULT');
    box-shadow:
      0 1px 2px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.25);
    transition: transform 280ms cubic-bezier(0.4, 0.15, 0.2, 1);
    will-change: transform;
  }

  .lang-toggle[data-lang='en'] .lang-toggle__knob {
    transform: translateX(100%);
  }

  .lang-toggle__side {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1 1 50%;
    align-items: center;
    justify-content: center;
    height: 100%;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .lang-toggle__flag {
    display: block;
    font-size: 1.05rem;
    line-height: 1;
    transition: transform 200ms ease;
  }

  /* Slight grayscale/dim on the inactive flag for contrast. */
  .lang-toggle[data-lang='es'] .lang-toggle__side[data-target='en'] .lang-toggle__flag,
  .lang-toggle[data-lang='en'] .lang-toggle__side[data-target='es'] .lang-toggle__flag {
    filter: grayscale(0.5);
    opacity: 0.75;
  }

  .lang-toggle__side:hover .lang-toggle__flag {
    transform: scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .lang-toggle__knob,
    .lang-toggle__flag {
      transition: none;
    }
  }
</style>

<script>
  // Slide-then-navigate: on clicking the inactive side, flip data-lang so the
  // knob animates across, then follow the link once the transition finishes.
  function initLangToggles() {
    document.querySelectorAll<HTMLElement>('.lang-toggle').forEach((toggle) => {
      if (toggle.dataset.bound === '1') return;
      toggle.dataset.bound = '1';

      toggle.querySelectorAll<HTMLAnchorElement>('.lang-toggle__side').forEach((side) => {
        side.addEventListener('click', (event) => {
          const target = side.dataset.target;
          if (!target || toggle.dataset.lang === target) return; // already active

          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (reduce) return; // let the browser navigate normally

          event.preventDefault();
          toggle.dataset.lang = target; // triggers the knob slide
          const href = side.getAttribute('href');
          window.setTimeout(() => {
            if (href) window.location.href = href;
          }, 280);
        });
      });
    });
  }

  initLangToggles();
  document.addEventListener('astro:after-swap', initLangToggles);
</script>

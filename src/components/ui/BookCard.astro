---
/**
 * BookCard — book catalog card (spec 7: UI Components / BookCard scenario).
 *
 * Displays the cover image, title, and author, and links the whole card to
 * `href`. Alt text is derived from the title so covers are accessible.
 * Tailwind-only styling, typed props, no inline styles.
 */
interface Props {
  title: string;
  coverUrl: string;
  author: string;
  href: string;
}

const { title, coverUrl, author, href } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-lg border border-base-muted bg-base-soft transition-theme duration-theme hover:border-accent"
>
  <div class="aspect-[3/4] w-full overflow-hidden bg-base-muted">
    <img
      src={coverUrl}
      alt={`Portada de ${title}`}
      loading="lazy"
      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="flex flex-col gap-1 p-4">
    <h3 class="line-clamp-2 text-base font-semibold text-zinc-100 group-hover:text-accent">
      {title}
    </h3>
    <p class="text-sm text-zinc-400">{author}</p>
  </div>
</a>

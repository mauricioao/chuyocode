---
/**
 * Emoji — a small Fluent Emoji 3D "sticker" accent (visual-identity decision,
 * 2026-10-04). Plain Astro component for any server-rendered page/component;
 * `Emoji.tsx` is the React twin for islands — both read the same slug list
 * (`@lib/emoji.ts`) so they can never drift apart. See that module's own
 * header for the asset pipeline and the `x` density-descriptor reasoning.
 *
 * Decorative by default (`alt=""` + `aria-hidden="true"`): every current call
 * site already has its own visible/accessible text next to it (a score line,
 * an empty-state sentence, a slide title) — the emoji is flourish, not new
 * information. Pass `label` only for a future call site with no such text.
 */
import { emojiSrcSet, emojiFallbackSrc, type EmojiName } from '@lib/emoji';

interface Props {
  name: EmojiName;
  /** CSS pixel size (square) — keep this a small sticker accent, 32-64px. */
  size?: number;
  /** Accessible label. Omitted (default): decorative, `alt=""` + `aria-hidden`. */
  label?: string;
  class?: string;
  'data-testid'?: string;
}

const { name, size = 48, label, class: className, 'data-testid': testId } = Astro.props;
---

<picture class:list={['inline-block align-middle', className]} data-testid={testId}>
  <source type="image/avif" srcset={emojiSrcSet(name, 'avif')} />
  <source type="image/webp" srcset={emojiSrcSet(name, 'webp')} />
  <img
    src={emojiFallbackSrc(name)}
    width={size}
    height={size}
    alt={label ?? ''}
    aria-hidden={label ? undefined : 'true'}
    loading="lazy"
    decoding="async"
  />
</picture>

---
/**
 * MediaCard — image-first content card (spec: media-card, design decision #3/#4).
 *
 * Renders a full-bleed cover image with an ALWAYS-VISIBLE caption BELOW the
 * image carrying the title and, when present, the author. The caption is a
 * permanent block (not an overlay, not hover-gated), so every card is legible
 * at rest on every pointer type. A small, high-contrast TYPE TAG floats over
 * the top-left corner of the image to differentiate content kinds (book →
 * "Libro", news → "Noticia"); it is only rendered when `kind` is provided.
 *
 * A single `<a>` wrapper is the only focus target (`focus-visible:ring`), so
 * keyboard users get one clean tab stop. Screen readers derive the accessible
 * name from the anchor's `aria-label` (the title), matching the visual title.
 *
 * The cover is delivered through {@link buildImage} (PR1): responsive
 * `srcset`/`sizes` plus an LQIP blur-up placeholder, so no raw full-resolution
 * Sanity CDN URL is shipped. When `lqip` is present it paints as a blurred
 * `background-image` behind the `<img>` until the full image loads; when it is
 * missing the image simply loads without a placeholder (graceful fallback).
 *
 * A subtle `group-hover:scale-105` zoom on the image adds a streaming-style
 * touch; it is disabled under `prefers-reduced-motion: reduce`.
 *
 * View Transitions (design decision #8): the `<img>` carries
 * `transition:name="cover-<_id>"` so navigating to a detail page whose hero img
 * shares the same name produces a native cross-fade morph with zero JS.
 *
 * API:
 *   <MediaCard
 *     variant="poster"
 *     kind="book"
 *     _id="doc-123"
 *     href="/es/libros/el-libro"
 *     title="El Libro"
 *     author="Autor"
 *     asset={{ url, metadata: { lqip } }}
 *   />
 */
import { buildImage, type MediaVariant, type SanityAssetRef } from '@lib/image';
import { badgeVariants } from '@components/ui/badge';

interface Props {
  /** Card context: drives aspect ratio, responsive widths, and `sizes`. */
  variant: MediaVariant;
  /** Content kind; drives the high-contrast type tag (book → "Libro", news → "Noticia"). */
  kind?: 'book' | 'news';
  /** Document id; keys the View Transition name (`cover-<_id>`). */
  _id?: string;
  /** Destination for the whole-card link. */
  href: string;
  /** Title — caption heading and accessible name. */
  title: string;
  /** Author/byline shown below the title in the caption (optional). */
  author?: string;
  /**
   * Editorial synopsis. Retained for call-site compatibility but no longer
   * rendered (the hover overlay that showed it was removed).
   */
  synopsis?: string;
  /** Resolved cover asset (`{ url, metadata: { lqip } }`) for buildImage. */
  asset?: SanityAssetRef | null;
}

const { variant, kind, _id, href, title, author, asset } = Astro.props;

const image = buildImage({ asset, _id }, variant);

// Aspect ratio per variant: posters are tall (2/3, the shademanga cover ratio),
// wide is landscape (16/9), ranked posters share the poster 2/3 ratio but sit in
// a numbered rail (kept consistent so covers read the same across rows).
const ASPECT: Record<MediaVariant, string> = {
  poster: 'aspect-[2/3]',
  wide: 'aspect-[16/9]',
  ranked: 'aspect-[2/3]',
};
const aspect = ASPECT[variant];

// Type tag label derived from `kind` (Spanish UI copy, intended). Undefined
// kind → no tag.
const KIND_LABEL: Record<NonNullable<Props['kind']>, string> = {
  book: 'Libro',
  news: 'Noticia',
};
const kindLabel = kind ? KIND_LABEL[kind] : undefined;

// Only paint the LQIP blur-up backdrop when the projection provided one.
const lqipStyle = image.lqip
  ? `background-image:url(${image.lqip});background-size:cover;background-position:center;`
  : undefined;
---

<a
  href={href}
  aria-label={title}
  data-variant={variant}
  class="mediacard group relative block outline-none focus-visible:ring-2 focus-visible:ring-accent"
>
  {/* Image block = the element that lifts on hover (see the "lifted by hand"
      rule in <style>). The badge lives inside it, so it rises together with the
      cover — only the image block moves, the caption below stays put. The COVER
      clips its image so the portrait stays rounded; the shadow deepens on hover
      to reinforce the lift. */}
  <div
    class:list={[
      'mediacard-stage relative block bg-base-muted shadow-elevation-1 transition-shadow duration-500 group-hover:shadow-elevation-3',
      aspect,
    ]}
  >
    <div
      class="mediacard-cover absolute inset-0 overflow-hidden"
      style={lqipStyle}
    >
      {
        image.src && (
          <img
            src={image.src}
            srcset={image.srcset}
            sizes={image.sizes}
            alt={title}
            loading="lazy"
            decoding="async"
            transition:name={_id ? `cover-${_id}` : undefined}
            class="mediacard-img h-full w-full object-cover"
          />
        )
      }
    </div>

    {/* High-contrast type tag (shadcn Badge). Sits over the cover but OUTSIDE
        the overflow-hidden cover box, so on hover it can scale/lift MORE than
        the cover and separate as its own layer (the "buy button" counterpart
        from the reference), simulating depth with 2D transforms. */}
    {
      kindLabel && (
        <span
          class={badgeVariants({
            variant: 'default',
            className:
              'mediacard-badge pointer-events-none absolute left-2 top-2 z-10 uppercase tracking-wide shadow-md ring-1 ring-black/10',
          })}
        >
          {kindLabel}
        </span>
      )
    }
  </div>

  {/* Always-visible caption BELOW the image: title + optional author. Text
      steps up slightly at sm so it stays legible at the ~130px mobile card
      width without crowding the wider desktop card. The ranked rail keeps the
      title to ONE truncated line (callers pre-shorten it); other variants wrap
      to two lines. */}
  <div class="mediacard-caption flex flex-col gap-0.5 pt-2">
    <h3
      class:list={[
        'text-xs font-semibold text-zinc-50 sm:text-sm',
        variant === 'ranked' ? 'truncate' : 'line-clamp-2',
      ]}
    >
      {title}
    </h3>
    {author && <p class="line-clamp-1 text-xs text-zinc-400 sm:text-sm">{author}</p>}
  </div>
</a>

<style>
  /* "Lifted by hand" hover: ONLY the image block grows UPWARD on hover — its
   * bottom edge stays anchored (transform-origin: bottom) so the card appears to
   * be gently picked up while the caption below stays put. The motion is slow,
   * soft, and SYMMETRIC: the same duration + ease-in-out on enter AND exit, so
   * releasing the mouse lowers it back the exact same way. 2D transform only, so
   * the scroll-track overflow never flattens it. */
  .mediacard :global(.mediacard-stage) {
    transform-origin: bottom center;
    transform: translateY(0);
    transition:
      transform 0.45s ease-in-out,
      box-shadow 0.45s ease-in-out;
    will-change: transform;
  }
  .mediacard:hover :global(.mediacard-stage),
  .mediacard:focus-visible :global(.mediacard-stage) {
    /* The WHOLE image block moves up as one piece (no scale, so nothing grows
     * past the track edge and gets clipped) = the card is "picked up". */
    transform: translateY(-10px);
  }

  /* NOTE: this hover is intentionally NOT gated behind
   * `prefers-reduced-motion: reduce`. It is a subtle, user-initiated hover lift
   * (not autoplaying/looping motion), so it stays on for everyone — many systems
   * report `reduce` from unrelated settings (battery saver, Windows animation
   * effects off), which would otherwise hide this basic affordance. Larger,
   * automatic motion elsewhere (hero autoplay, scroll reveals) still respects
   * the preference. */
</style>

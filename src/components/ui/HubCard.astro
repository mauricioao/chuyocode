---
/**
 * HubCard — a big, icon-led navigation card with a live count.
 *
 * Introduced for the Inglés hub (`/[lang]/ingles`, two cards: curated
 * exercises vs. community activities) as the new reusable "pick one of a
 * few equally-weighted destinations" look, instead of one more variant of
 * the site's existing text-only link cards.
 *
 * SQUARE-ISH ON DESKTOP, COMPACT ON PHONES: `aspect-square` only applies
 * from `sm:` up — a forced square on a narrow phone squeezes the title,
 * description AND count into a cramped tile, so mobile gets its natural
 * (shorter) height instead. Capped to a compact width on phones
 * (`max-w-xs`); `sm:` and up let the grid column set the width.
 *
 * TWO-TONE GRADIENT BACKDROP: every card blends the brand accent (yellow)
 * with a `tone` secondary hue, both at low opacity, so the two cards read as
 * a matched pair (same brand undertone) while staying visually distinct
 * (different secondary hue). `tone` picks from Tailwind's built-in palette
 * (`sky-500`/`violet-500`) rather than a new `--color-*` token — the
 * `@theme` block in `global.css` is additive, not a full palette override,
 * so these classes resolve the same raw Tailwind shade everywhere, in both
 * themes — unlike a semantic role (`text-success`, `text-accent-ink`, …),
 * which this pair deliberately is not (see `ingles:` below).
 *
 * The icon is a named slot so the caller decides which Phosphor icon to
 * render (typically `weight="duotone"`, unhydrated — a framework component
 * with no `client:*` directive renders to static SSR HTML like any other
 * Astro-nested content, so this stays zero extra JavaScript). It sits in a
 * rounded "icon tile" that scales slightly on hover, echoing the whole
 * card's own lift.
 *
 * ACCESSIBLE NAME: `aria-label` on the anchor is set to `"<title> —
 * <count>"` (or just `<title>` when there is no count), which OVERRIDES the
 * card's visible text for assistive tech — so a screen reader announces
 * "Ejercicios propuestos — 12 ejercicios" as one unit rather than reading
 * through the description too.
 *
 * Hover/focus: a subtle lift + scale, disabled under
 * `prefers-reduced-motion: reduce` via `motion-reduce:` (site convention —
 * see `UserMenu.tsx`'s avatar button for the same pattern). The
 * `focus-visible` ring stays on regardless of reduced motion; it is the
 * keyboard-focus indicator, not decorative motion.
 */
interface Props {
  href: string;
  title: string;
  description: string;
  /**
   * Pre-formatted live count ("12 ejercicios"), or `null`/omitted when the
   * count query failed or returned nothing usable — the card then renders
   * with NO number rather than a misleading "0".
   */
  count?: string | null;
  /** Secondary hue blended with the brand accent in the backdrop and icon tile. */
  tone?: 'sky' | 'violet';
}

const { href, title, description, count = null, tone = 'sky' } = Astro.props;

const TONE_CLASSES: Record<'sky' | 'violet', { backdrop: string; iconTile: string }> = {
  sky: {
    backdrop: 'from-accent/15 via-sky-500/10 to-transparent',
    // `ingles:` (global.css `@custom-variant ingles`) — the light Inglés hub
    // is the only caller of this card, and the pastel `sky-300`/`violet-300`
    // icon (tuned for a dark tile) has poor contrast against this same tile
    // tinted over a near-white card, so it steps to a darker shade ONLY in
    // that scope. Dark pages (none currently use this card) are unaffected.
    iconTile: 'bg-sky-500/15 text-sky-300 ingles:text-sky-700 group-hover:bg-sky-500/25',
  },
  violet: {
    backdrop: 'from-accent/15 via-violet-500/10 to-transparent',
    iconTile: 'bg-violet-500/15 text-violet-300 ingles:text-violet-700 group-hover:bg-violet-500/25',
  },
};
const toneClasses = TONE_CLASSES[tone];

const accessibleName = count ? `${title} — ${count}` : title;
---

<a
  href={href}
  aria-label={accessibleName}
  class="group relative mx-auto flex w-full max-w-xs flex-col items-center justify-center gap-3 overflow-hidden rounded-lg border border-border bg-surface-soft p-6 text-center transition-transform duration-200 ease-out hover:-translate-y-1 hover:scale-[1.02] hover:border-accent-ink focus-visible:-translate-y-1 focus-visible:scale-[1.02] focus-visible:border-accent-ink focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring sm:aspect-square sm:max-w-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 motion-reduce:hover:scale-100 motion-reduce:focus-visible:translate-y-0 motion-reduce:focus-visible:scale-100"
>
  <span
    aria-hidden="true"
    class:list={['pointer-events-none absolute inset-0 bg-gradient-to-br', toneClasses.backdrop]}
  />
  <span
    aria-hidden="true"
    class:list={[
      'relative z-10 flex items-center justify-center rounded-2xl p-4 transition-transform duration-200 ease-out group-hover:scale-105 motion-reduce:transition-none motion-reduce:group-hover:scale-100',
      toneClasses.iconTile,
    ]}
  >
    <slot name="icon" />
  </span>
  <span class="relative z-10 text-lg font-semibold text-foreground sm:text-xl">{title}</span>
  <span class="relative z-10 text-sm text-muted-foreground">{description}</span>
  {
    count && (
      <span class="relative z-10 text-xs font-semibold tracking-wide text-accent-ink tabular-nums">
        {count}
      </span>
    )
  }
</a>

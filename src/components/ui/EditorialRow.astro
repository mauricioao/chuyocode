---
/**
 * EditorialRow — titled horizontal discovery row (spec: home-discovery;
 * design decision #4). Extends the ContentRow pattern with three additions the
 * image-first redesign needs: a section title, prev/next arrow controls, and
 * edge-fade masks over a CSS scroll-snap track of {@link MediaCard}s.
 *
 * The track is pure CSS scroll-snap (`overflow-x-auto snap-x` on the track,
 * `snap-start shrink-0` on each card wrapper) — no island, no layout JS. A tiny
 * dependency-free `is:inline` script only wires the arrow buttons to `scrollBy`
 * on the track; scroll itself works without JS. The script is idempotent and
 * carries `data-astro-rerun` so it re-binds after a View Transition swap
 * (design decision #8).
 *
 * Layout (shademanga row pattern):
 *   - Cards start from a LEFT GUTTER aligned with the row title (they are not
 *     flush to the viewport edge).
 *   - The RIGHT edge carries a gradient fade to black so the last visible card
 *     visually cuts off, hinting there is more content past the edge.
 *   - A PROMINENT accent-yellow chevron button on the right is ALWAYS VISIBLE
 *     (the "there's more" affordance) and scrolls the row right on click. A
 *     left chevron mirrors it but stays hover/focus-gated since it is only
 *     useful once the row has already been scrolled.
 *
 * Mixed content: `items` are already-normalized {@link MediaItem}s, so a single
 * row can carry books AND news (spec: Mixed-type editorial row) — the row is
 * shape-agnostic and simply maps each item into a poster MediaCard.
 *
 * API:
 *   <EditorialRow title="Architecture" items={items} />
 */
import MediaCard from '@components/ui/MediaCard.astro';
import { buttonVariants } from '@components/ui/button';
import {
  ARROW_BUTTON_SHAPE,
  ARROW_BUTTON_VARIANT,
  chevronSvgMarkup,
} from '@lib/arrowControl';
import type { MediaItem } from '@lib/sanity';

interface Props {
  /** Section heading rendered above the track. */
  title: string;
  /** Normalized discovery items; rendered as poster MediaCards. */
  items: MediaItem[];
}

const { title, items } = Astro.props;

// The chevron glyphs and the shadcn variant both come from `@lib/arrowControl`,
// which the exercise stepper's React arrows are built from too. The row stays
// zero-JS except for the tiny scroll wiring below — the shared module is
// framework-free data plus a string builder, not a component.
const CHEVRON_LEFT_SVG = chevronSvgMarkup('prev');
const CHEVRON_RIGHT_SVG = chevronSvgMarkup('next');

// Nothing to render for an empty row — the home page also guards this, but the
// component stays self-safe so it degrades gracefully when used standalone.
const hasItems = items.length > 0;

// Arrow wiring only (scroll works without JS). Idempotent: guards against a
// double-bind if the script runs twice (initial load + astro:after-swap). The
// source lives in a frontmatter constant injected via set:html because Astro
// does not evaluate `{}` expressions inside <script> content.
const ARROW_SCRIPT = `
(function () {
  var rows = document.querySelectorAll('[data-editorial-row]');
  for (var r = 0; r < rows.length; r++) {
    (function (row) {
      if (row.getAttribute('data-arrows-bound') === '1') return;
      var track = row.querySelector('[data-editorial-track]');
      if (!track) return;
      var prev = row.querySelector('[data-editorial-prev]');
      var next = row.querySelector('[data-editorial-next]');
      function step(dir) {
        var amount = Math.max(240, Math.round(track.clientWidth * 0.8));
        track.scrollBy({ left: dir * amount, behavior: 'smooth' });
      }
      function bind(btn, dir) {
        if (!btn) return;
        // THE PAGE-SCROLL-ON-CLICK BUG.
        //
        // NOTE FOR EDITORS: this whole script is a template literal in the
        // frontmatter. A backtick or a dollar-brace in these comments TERMINATES
        // the string and breaks the build. Plain quotes only.
        //
        // The arrow is absolutely positioned and vertically centred on the row.
        // When it receives focus the browser scrolls it into view, and because
        // <html> carries scroll-behavior:smooth (BaseLayout.astro) that nudge is
        // ANIMATED - so it does not read as a jump, it reads as the page
        // deliberately scrolling down.
        //
        // The previous attempt was mousedown + preventDefault, i.e. suppress the
        // focus so nothing gets scrolled to. That covers exactly one entry point
        // and has two holes:
        //   1. TOUCH AND PEN. The browser drives activation from the pointer
        //      sequence and only synthesizes a compatibility mousedown after
        //      touchend; by then focus has already been applied, so the
        //      preventDefault arrives too late to stop anything.
        //   2. It DESTROYS focus on the path where it does work. After a click
        //      the active element falls back to body, so the next Tab restarts
        //      from the top of the document.
        //
        // So: focus the button OURSELVES, on pointerdown (one listener for
        // mouse, touch and pen), with preventScroll. The button ends up focused
        // - which is correct, it is a real control - and the browser's own
        // default focus is then a no-op on an already-focused element, so no
        // scroll-into-view happens on any pointer type.
        //
        // UNCONFIRMED IN A BROWSER. jsdom never scrolls and has no layout, so
        // the test below pins the SHAPE of this fix, not its effect.
        btn.addEventListener('pointerdown', function () {
          if (typeof btn.focus === 'function') {
            try { btn.focus({ preventScroll: true }); } catch (err) { btn.focus(); }
          }
        });
        btn.addEventListener('click', function (e) { e.preventDefault(); step(dir); });
      }
      bind(prev, -1);
      bind(next, 1);
      row.setAttribute('data-arrows-bound', '1');
    })(rows[r]);
  }
})();
`;
---

{
  hasItems && (
    <section class="editorial-row group/row flex flex-col gap-4" data-editorial-row>
      <h2 class="px-4 font-sans text-2xl font-extrabold uppercase tracking-tight text-foreground sm:px-6 sm:text-3xl">
        {title}
      </h2>

      <div class="relative">
        {/* Prev arrow — shadcn icon button (matches the Carousel controls),
            hover/focus-gated: only useful once already scrolled. The trailing
            space in `editorial-arrow ` is the opacity-gate hook. */}
        <button
          type="button"
          class={buttonVariants({
            ...ARROW_BUTTON_VARIANT,
            className: `editorial-arrow editorial-arrow-prev absolute left-3 top-1/2 z-20 hidden -translate-y-1/2 ${ARROW_BUTTON_SHAPE} border-white/15 bg-black/60 text-zinc-50 shadow-elevation-2 backdrop-blur transition-opacity duration-200 hover:bg-black/80 hover:text-zinc-50 focus-visible:ring-accent sm:inline-flex`,
          })}
          data-editorial-prev
          aria-label="Scroll left"
          set:html={CHEVRON_LEFT_SVG}
        />

        {/* Right-edge gradient fade to black: the last visible card cuts off
            into the fade, hinting there is more to scroll. Non-interactive so it
            never eats clicks aimed at the card underneath. */}
        <div
          class="editorial-fade pointer-events-none absolute inset-y-0 right-0 z-10 w-16 bg-gradient-to-l from-black to-transparent sm:w-24"
          aria-hidden="true"
        />

        {/* Next arrow — ALWAYS VISIBLE accent-amber shadcn icon button: the
            "there's more" affordance. Sits over the right fade and scrolls the
            row. NOT opacity-gated (no `editorial-arrow ` class). */}
        <button
          type="button"
          class={buttonVariants({
            ...ARROW_BUTTON_VARIANT,
            className: `editorial-arrow-next absolute right-3 top-1/2 z-20 -translate-y-1/2 ${ARROW_BUTTON_SHAPE} border-accent/40 bg-black/70 text-accent shadow-elevation-2 backdrop-blur transition-colors duration-200 hover:bg-black/90 hover:text-accent-hover focus-visible:ring-accent`,
          })}
          data-editorial-next
          aria-label="Scroll right"
          set:html={CHEVRON_RIGHT_SVG}
        />

        {/* Left-gutter scroll-snap track of poster MediaCards. The leading
            padding aligns the first card with the row title (px-4 sm:px-6) so
            cards start from a gutter, not flush to the viewport edge. Extra
            trailing padding leaves room so the last card can rest under the
            fade/arrow. */}
        <div
          class="editorial-track flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-1 pl-4 pr-16 pt-4 sm:pl-6 sm:pr-24"
          data-editorial-track
        >
          {items.map((item) => (
            <div class="w-[130px] shrink-0 snap-start sm:w-[200px] lg:w-[270px]">
              <MediaCard
                variant="poster"
                kind={item.kind}
                _id={item._id}
                href={item.href}
                title={item.title}
                author={item.tagline}
                synopsis={item.synopsis}
                asset={item.asset}
              />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  hasItems && (
    <script is:inline data-astro-rerun set:html={ARROW_SCRIPT} />
  )
}

<style>
  /* Hide the scrollbar while keeping scroll fully functional (matches the
   * ContentRow streaming aesthetic). Cross-browser. */
  .editorial-track {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE / legacy Edge */
  }
  .editorial-track::-webkit-scrollbar {
    display: none; /* Chrome / Safari / Edge */
  }

  /* The right-edge fade is a real element (`.editorial-fade`) rather than a
   * track mask so it does not fight the left gutter (`pl-*` on the track). Only
   * the right side fades to black — the left side starts from a clean gutter
   * aligned with the row title (shademanga row pattern).
   *
   * The prev arrow appears on hover of the row or when any child receives focus
   * so keyboard users can reach it; rest state keeps the left side clean. The
   * next arrow is ALWAYS visible (no opacity gate) — it is the primary
   * "there's more" affordance. */
  .editorial-arrow {
    opacity: 0;
  }
  .editorial-row:hover .editorial-arrow,
  .editorial-row:focus-within .editorial-arrow {
    opacity: 1;
  }
</style>

---
/**
 * NewsCard — news article card (spec 7: UI Components).
 *
 * Displays the article title, publish date, excerpt, and a "read more" link
 * to `href`. Tailwind-only styling, typed props, no inline styles.
 *
 * The `date` prop is the display string; formatting/localization of the raw
 * timestamp is the caller's responsibility (news pagination work unit). The
 * "read more" label is localized via `UI_LABELS[lang].news.readMore` — no
 * hardcoded UI strings (spec 5: UI Labels).
 */
import { UI_LABELS, type Lang } from '@lib/i18n';

interface Props {
  title: string;
  excerpt: string;
  date: string;
  href: string;
  lang: Lang;
}

const { title, excerpt, date, href, lang } = Astro.props;
const readMore = UI_LABELS[lang].news.readMore;
---

<article
  class="group flex flex-col gap-3 rounded-xl bg-card p-5 text-card-foreground ring-1 ring-foreground/10 transition-shadow duration-300 hover:shadow-elevation-2"
>
  <time class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
    {date}
  </time>
  <h3 class="text-base font-semibold leading-snug text-foreground">
    <a href={href} class="outline-none transition-colors hover:text-primary focus-visible:text-primary">{title}</a>
  </h3>
  <p class="line-clamp-3 text-sm text-muted-foreground">{excerpt}</p>
  <a
    href={href}
    class="mt-auto inline-flex w-fit text-sm font-semibold text-primary outline-none transition-colors hover:text-primary/80 focus-visible:text-primary"
  >
    {readMore} &rarr;
  </a>
</article>

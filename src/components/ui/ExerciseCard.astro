---
/**
 * ExerciseCard — the link card that represents ONE exercise.
 *
 * Extracted from two call sites that had converged on the same shape and were
 * one edit away from drifting apart again:
 *   - `[lang]/ingles/[level]/[focus]/[slug].astro` — the related-exercise grid
 *   - `[lang]/ingles/[level]/[focus]/index.astro`  — the listing
 *
 * They had already drifted once: the detail header rendered a raw `code-review`
 * slug while the cards one click away showed `Code review`.
 *
 * THE FOCUS LEADS. The language point — present simple, phrasal verbs — is what
 * the learner is choosing, so it is the heading. Level, skill and context are
 * badges beneath it: they QUALIFY the exercise, they do not identify it.
 *
 * WHAT THE TWO CALL SITES ACTUALLY DISAGREE ON — and why `title` is a prop
 * rather than something this component derives. Related cards CROSS language
 * points, so the focus is the single thing that tells them apart and it leads.
 * Listing cards are all inside one focus, which is already the page's own
 * `<h1>`, so leading with it would print the same words on every card; they
 * lead with the humanized slug instead. Deriving the title here would have to
 * re-learn which page it is on, which is exactly the coupling the extraction is
 * meant to kill.
 *
 * ZERO JAVASCRIPT. This is a link with an inline SVG. No React component enters
 * the tree, which is also what keeps the component renderable by
 * `AstroContainer` — see the note in `@lib/skillIcons`.
 *
 * The skill label is derived from `skill` rather than passed in, so the "English
 * in every locale" rule for taxonomy labels (docs/exercise-model.md, "Authoring
 * rules") holds structurally instead of depending on both call sites
 * remembering it. The LEVEL badge is the opposite case: "Nivel"/"Level" is
 * chrome and localizes, so the caller composes that string and passes it.
 */
import { badgeVariants } from '@components/ui/badge';
import {
  SKILL_LABELS,
  TOPIC_LABELS,
  type Skill,
  type Topic,
} from '@lib/exerciseTaxonomy';
import { skillIconPaths } from '@lib/skillIcons';

interface Props {
  /** Destination for the whole-card link. */
  href: string;
  /** Card heading. The caller decides what identifies the exercise — see above. */
  title: string;
  /** Drives BOTH the English skill label and its decorative glyph. */
  skill: Skill;
  /**
   * Pre-composed level badge (`Nivel A2` / `Level A2`), or omitted for no level
   * badge. The listing omits it: every card there shares the level with the
   * page header, so a badge would repeat identical text on every row.
   */
  levelBadge?: string;
  /**
   * The vocabulary CONTEXT, or `null`/omitted when the exercise has none.
   *
   * `null` is an ORDINARY value, not missing data: a pure grammar drill has no
   * natural setting, and the column is nullable precisely so an author is not
   * pushed into inventing one. It renders NO badge — never an empty pill.
   *
   * Derived to a label here rather than passed as a string, for the same
   * structural reason as `skill`: this component takes no `lang` prop, so a
   * call site cannot hand it a translated topic even by mistake.
   */
  topic?: Topic | null;
  /** Heading size. The related grid runs two columns and steps up to `xl`. */
  titleSize?: 'lg' | 'xl';
}

const { href, title, skill, levelBadge, topic, titleSize = 'lg' } = Astro.props;

/**
 * Full class names in a lookup, never a template string. Tailwind scans source
 * TEXT, so a constructed `text-${size}` is a class it never emits and a style
 * that silently does not exist. Same pattern as `ASPECT` in `MediaCard.astro`.
 */
const TITLE_SIZE: Record<NonNullable<Props['titleSize']>, string> = {
  lg: 'text-lg',
  xl: 'text-xl',
};

// `[]` for anything outside the taxonomy, which renders zero <path> elements.
const iconPaths = skillIconPaths(skill);

/**
 * The label degrades exactly like the icon does. `src/lib/exercises.ts` builds
 * rows with `skill: row.skill as Skill` — an UNCHECKED cast — so a value that
 * never passed `isSkill` can arrive here typed as one, and `SKILL_LABELS[skill]`
 * would be `undefined`. Guarding the glyph against that while letting the text
 * beside it fall over would be incoherent.
 *
 * MEASURED, not assumed: with this fallback removed the badge renders as an
 * EMPTY CHIP — a bordered pill with nothing in it. Astro renders `undefined` as
 * nothing at all, NOT as the literal word "undefined" (the rationale comment in
 * `@lib/exerciseCopy` says otherwise; it is wrong on that detail, though its
 * `''` return is still the right call). An empty chip is the worse failure
 * precisely because it looks deliberate. The raw value is the honest fallback:
 * it is an English slug either way, and it names what actually came out of the
 * database.
 */
const skillLabel = SKILL_LABELS[skill] ?? skill;

/**
 * The context badge's text, or `null` for no badge at all.
 *
 * TWO different absences collapse here on purpose, because the card's correct
 * response to both is identical — draw nothing:
 *   - `null`/omitted: the exercise genuinely has no setting.
 *   - `''`: a column that is empty rather than NULL, which would otherwise
 *     render a bordered pill containing nothing.
 *
 * A topic OUTSIDE the taxonomy is the third case and is treated differently: it
 * falls back to the raw slug, exactly like `skillLabel` above. That is not
 * symmetry for its own sake — it is the same bug, and this component already
 * shipped it once. `TOPIC_LABELS[topic]` for an unmapped value is `undefined`,
 * and Astro renders `undefined` as NOTHING (measured — not as the literal word
 * "undefined"), so the failure looks like a deliberate empty chip rather than
 * like something broken. The slug is an honest English value and names what
 * actually came out of the database.
 */
const topicLabel = topic ? (TOPIC_LABELS[topic] ?? topic) : null;
---

{/* `h-full` matters in the related GRID, where a short card must stretch to
    match a tall neighbour. In the listing's single-column list the parent has
    no resolved height, so `height: 100%` computes to `auto` and it is inert —
    which is why one class serves both without changing how the listing looks. */}
<a
  href={href}
  class:list={[
    'exercise-card flex h-full flex-col gap-3 rounded-lg border border-border bg-base-soft p-5',
    'transition-colors hover:border-accent focus-visible:border-accent',
  ]}
>
  <span class:list={[TITLE_SIZE[titleSize], 'font-semibold text-zinc-100']}>
    {title}
  </span>

  <div class="flex flex-wrap items-center gap-2">
    {
      levelBadge && (
        <span class={badgeVariants({ variant: 'secondary' })}>{levelBadge}</span>
      )
    }

    {/* The glyph is DECORATIVE and the label stays beside it: the icon adds a
        second, faster channel for sighted scanning without becoming the only
        channel. `aria-hidden` keeps a screen reader from announcing the skill
        twice, and `focusable="false"` keeps legacy IE/Edge SVG out of the tab
        order. Sizing and the icon/text gap come from `badgeVariants` itself
        (`[&>svg]:size-3!` and `gap-1`), which is why the svg must stay a DIRECT
        child of the badge; `size-3 shrink-0` repeats the same value so the icon
        still cannot blow up to the SVG default if that utility ever moves. */}
    <span class={badgeVariants({ variant: 'outline' })}>
      {
        iconPaths.length > 0 && (
          <svg
            class="size-3 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            {iconPaths.map((d) => (
              <path d={d} />
            ))}
          </svg>
        )
      }
      {skillLabel}
    </span>

    {/* LAST, and only when there is one. The badges narrow from placement to
        detail: which level, how you answer, and finally what it is about.
        Rendering an empty pill for an exercise with no context would invent a
        fourth, meaningless state — the whole reason `topic` was made nullable
        was so "no setting" could be said plainly instead of faked. */}
    {
      topicLabel && (
        <span class={badgeVariants({ variant: 'outline' })}>{topicLabel}</span>
      )
    }
  </div>
</a>

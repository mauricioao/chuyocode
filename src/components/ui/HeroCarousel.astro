---
/**
 * HeroCarousel — server wrapper for the interactive hero billboard.
 *
 * The hero is a shadcn Carousel (Embla) that MUST run on the client, but the
 * Sanity image pipeline ({@link buildImage}) is server-only (env + @sanity/
 * image-url). This component bridges the two: it runs buildImage per slide on
 * the SERVER, flattens each slide to plain data (resolved src/srcset/sizes/lqip
 * for the backdrop and the optional logo), and hands that to the
 * {@link HeroCarouselIsland} React island (`client:load`). Nothing server-only
 * ever ships to the browser.
 *
 * Hero art (spec: hero-logo-background), both purely ADDITIVE:
 *   - `backgroundAsset` (Sanity `heroBackground`): wide landscape backdrop;
 *     falls back to `asset` (the cover) via `??` when absent.
 *   - `logoAsset` (Sanity `contentLogo`): transparent-PNG title treatment shown
 *     ABOVE the <h2>; the text title always stays rendered.
 *
 * Edge cases (spec: Edge-Case Item Counts):
 *   - 0 items: NO carousel — a neutral placeholder holds the slot.
 *   - 1 item: rendered as a single, non-rotating slide (island handles this).
 *
 * TRADEOFF: the previous Astro `transition:name` cover morph is dropped for the
 * hero (View Transitions directives cannot cross into a React island). The row
 * MediaCards keep their morph.
 *
 * API:
 *   <HeroCarousel interval={6000} items={[{ _id, href, title, tagline?,
 *     ctaLabel?, asset, logoAsset?, backgroundAsset? }]} />
 */
import { buildImage, type SanityAssetRef } from '@lib/image';
import HeroCarouselIsland, {
  type HeroSlideData,
  type HeroImage,
} from '@components/islands/HeroCarouselIsland';

interface HeroSlide {
  _id?: string;
  href: string;
  title: string;
  tagline?: string;
  ctaLabel?: string;
  asset?: SanityAssetRef | null;
  logoAsset?: SanityAssetRef | null;
  backgroundAsset?: SanityAssetRef | null;
}

interface Props {
  /** Featured slides. 0 → placeholder only. */
  items: HeroSlide[];
  /** Auto-advance interval in milliseconds. Default 6000 (spec default 6 s). */
  interval?: number;
}

const { items, interval = 6000 } = Astro.props;
const isEmpty = items.length === 0;

/**
 * Flatten a buildImage result to the island's {@link HeroImage} shape, or
 * `null` when the variant produced no `src` (missing asset). Keeping `null`
 * (not undefined) lets the island's optional chaining short-circuit cleanly.
 */
function toHeroImage(
  asset: SanityAssetRef | null | undefined,
  _id: string | undefined,
  variant: 'hero' | 'logo',
): HeroImage | null {
  const built = buildImage({ asset, _id }, variant);
  if (!built.src) return null;
  return {
    src: built.src,
    srcset: built.srcset,
    sizes: built.sizes,
    ...(built.lqip ? { lqip: built.lqip } : {}),
  };
}

// Server-side image pipeline per slide → plain data for the client island.
// Backdrop prefers the dedicated landscape art, falls back to the cover (`??`
// so a null projection falls through but a real asset never does).
const slides: HeroSlideData[] = items.map((item) => ({
  ...(item._id ? { id: item._id } : {}),
  href: item.href,
  title: item.title,
  ...(item.tagline ? { tagline: item.tagline } : {}),
  ...(item.ctaLabel ? { ctaLabel: item.ctaLabel } : {}),
  image: toHeroImage(item.backgroundAsset ?? item.asset, item._id, 'hero'),
  logo: toHeroImage(item.logoAsset, item._id, 'logo'),
}));
---

{
  isEmpty ? (
    /* Zero featured items: NO carousel. A neutral placeholder holds the slot so
       the layout below (rows, spotlight) still flows. */
    <div
      class="hero-carousel-placeholder flex h-[88vh] min-h-[520px] w-full items-center justify-center bg-muted"
      data-hero-placeholder
    >
      <span class="text-sm text-muted-foreground">No featured content</span>
    </div>
  ) : (
    <HeroCarouselIsland
      client:load
      slides={slides}
      interval={interval}
      defaultCtaLabel="Leer"
    />
  )
}

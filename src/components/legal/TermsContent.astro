---
/**
 * TermsContent — Terms & Conditions body (es/en) for /[lang]/legal/terms.
 *
 * Content lives here (not in i18n.ts) so the long legal copy does not pollute
 * the short-label localization file. The owner identity comes from env vars
 * (LEGAL_OWNER_*) resolved by the page and passed in as props, so personal data
 * stays out of source control while still rendering publicly (required by Peru's
 * Ley 29733: the data controller must be identified on the site).
 *
 * Covers the whole live service as of this draft: the Spanish-first English
 * platform (accounts via Google or Supabase email+password, community
 * activities and curated exercises, guest play, Premium pricing), the
 * pre-existing books/news catalog and its ad-rewarded download access, and
 * account deletion (`src/lib/accountDeletion.ts` / migration 0020) — see that
 * module and migration for the exact data-layer behavior section 8 describes.
 *
 * DISCLAIMER: this is a solid industry-standard structure aligned with
 * Ley 29733 and the facts verified in the codebase at drafting time, NOT a
 * lawyer-reviewed document. Have it reviewed by a legal professional (and
 * confirmed by the owner — see the open points in this change's own report)
 * before relying on it in production, especially before Premium payments go
 * live.
 */
import type { Lang } from '@lib/i18n';

interface Props {
  lang: Lang;
  ownerName: string;
  ownerRuc: string;
  ownerCity: string;
  ownerEmail: string;
  /** Last-updated date, already formatted for display. */
  updated: string;
}

const { lang, ownerName, ownerRuc, ownerCity, ownerEmail, updated } =
  Astro.props;
const isEs = lang === 'es';
const refundsHref = `/${lang}/legal/reembolsos`;
---


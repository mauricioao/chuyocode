---
/**
 * CommunityFiltersPanel — the funnel trigger + compact filters panel for
 * `/[lang]/ingles/actividades` (unified search header pass). Sits in
 * `PageTitle`'s `actions` slot right next to `SearchFilter` (server mode),
 * same visual weight/size as its magnifier (36x36, round, amber).
 *
 * The panel is a plain `method="get"` form. Its level/type/sort fields are
 * the Inglés capsule dropdown (`CommunityFiltersIsland`, owner approval
 * 2026-11-09, maquette `ChuyoCode_others/propuestas/desplegables` B2/B3):
 * each submits a hidden field with the same name and value the native select
 * did, so the URLs and the server are unchanged. Those three fields need JS
 * now (owner accepted); the server render already shows the current values.
 * The "no las he visto" toggle, Aplicar and Limpiar stay plain HTML. The
 * open/close affordance itself is a native `<details>`/`<summary>` (zero JS
 * to toggle, native expanded/collapsed semantics for AT for free), styled
 * with CSS to read as an anchored popover at `lg:` and a bottom sheet below
 * it. A tiny enhancement script closes it on an outside click or Escape.
 *
 * "Aplicar" submits this form's own fields plus a preserved `q` (hidden,
 * from `query`) so applying filters never drops an active search. "Limpiar"
 * is a plain `<a href={clearHref}>` — computed by the caller, same pattern
 * as `SearchFilter`'s own clear link — that keeps `q` and drops the rest, no
 * JS required either.
 */
import type { Lang } from '@lib/i18n';
import type { Level } from '@lib/exerciseTaxonomy';
import { CommunityFiltersIsland, type FilterOption } from '@components/islands/activities/CommunityFiltersIsland';

interface Props {
  lang: Lang;
  action: string;
  /** Accessible label AND title/tooltip for the trigger ("Filtros"/"Filters"). */
  triggerLabel: string;
  /** Number of active filters among nivel/tipo/orden!=default/novistas. */
  activeCount: number;
  applyLabel: string;
  clearLabel: string;
  clearHref: string;
  levelSelectLabel: string;
  /** The current `?nivel=`, `null` for every level. */
  level: Level | null;
  /** The level list's none option ("Todos los niveles"). */
  allLevelsLabel: string;
  typeSelectLabel: string;
  /** The current `?tipo=`, `""` for every type. */
  type: string;
  typeOptions: FilterOption[];
  sortSelectLabel: string;
  /** The current `?orden=`. */
  sort: string;
  sortOptions: FilterOption[];
  showNovistas: boolean;
  novistasChecked: boolean;
  novistasLabel: string;
  /** Preserved as a hidden `q` input so applying filters never drops the active search. */
  query: string;
  class?: string;
}

const {
  lang,
  action,
  triggerLabel,
  activeCount,
  applyLabel,
  clearLabel,
  clearHref,
  levelSelectLabel,
  level,
  allLevelsLabel,
  typeSelectLabel,
  type,
  typeOptions,
  sortSelectLabel,
  sort,
  sortOptions,
  showNovistas,
  novistasChecked,
  novistasLabel,
  query,
  class: className,
} = Astro.props;
---

<details class:list={['filters-popover', className]} data-testid="filters-popover">
  <summary
    class="filters-trigger"
    aria-label={activeCount > 0 ? `${triggerLabel} (${activeCount})` : triggerLabel}
    title={triggerLabel}
    data-testid="filters-trigger"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true" class="filters-trigger-icon">
      <path
        d="M3 4h18l-7 8.5V19l-4 2v-8.5L3 4Z"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    {
      activeCount > 0 && (
        <span class="filters-badge" data-testid="filters-badge">
          {activeCount}
        </span>
      )
    }
  </summary>

  <form method="get" action={action} class="filters-panel">
    <input type="hidden" name="q" value={query} />

    <CommunityFiltersIsland
      client:load
      lang={lang}
      level={level}
      type={type}
      sort={sort}
      levelLabel={levelSelectLabel}
      allLevelsLabel={allLevelsLabel}
      typeLabel={typeSelectLabel}
      typeOptions={typeOptions}
      sortLabel={sortSelectLabel}
      sortOptions={sortOptions}
    />

    {
      showNovistas && (
        <label class="filters-checkbox">
          <input type="checkbox" name="novistas" value="1" checked={novistasChecked} />
          {novistasLabel}
        </label>
      )
    }

    <div class="filters-actions">
      <a href={clearHref} class="filters-clear" data-testid="filters-clear">{clearLabel}</a>
      <button type="submit" class="filters-apply" data-testid="filters-apply">{applyLabel}</button>
    </div>
  </form>
</details>

<style>
  .filters-popover {
    position: relative;
    display: inline-flex;
  }
  .filters-popover > summary {
    list-style: none;
    cursor: pointer;
  }
  .filters-popover > summary::-webkit-details-marker {
    display: none;
  }
  .filters-popover > summary::marker {
    content: '';
  }

  .filters-trigger {
    position: relative;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: none;
    border: none;
    color: var(--color-accent-ink, #facc15);
  }
  .filters-trigger:focus-visible {
    /* Keyboard-focus ring, themed separately from accent-as-text/border —
     * see `--ring`'s own header in global.css. */
    outline: 2px solid var(--ring, #facc15);
    outline-offset: 2px;
    border-radius: 999px;
  }
  .filters-trigger-icon {
    width: 20px;
    height: 20px;
  }

  .filters-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    min-width: 16px;
    height: 16px;
    padding: 0 4px;
    border-radius: 999px;
    background: var(--color-accent, #facc15);
    color: var(--primary-foreground, #000);
    font-size: 10px;
    font-weight: 700;
    line-height: 16px;
    text-align: center;
  }

  /* Anchored, right-aligned popover at `lg:` — the `<details>`'s own native
     open/close already shows/hides this, no extra CSS needed for that part.
     The same white floating surface as the dropdown lists (maquette B2):
     radius 20, the kit's thin ring and its ink-tinted floating shadow. */
  .filters-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 30;
    display: flex;
    width: 17.5rem;
    max-height: 70dvh;
    flex-direction: column;
    gap: 14px;
    overflow-y: auto;
    border-radius: 20px;
    background: var(--popover);
    padding: 1rem;
    box-shadow: var(--ingles-glass-ring), var(--shadow-floating);
  }

  /* Below `lg:`, the same panel becomes a bottom sheet instead of an anchored
     dropdown — a fixed slab pinned to the viewport bottom, full width. */
  @media (max-width: 1023px) {
    .filters-panel {
      position: fixed;
      inset-inline: 0;
      top: auto;
      bottom: 0;
      z-index: 50;
      width: auto;
      max-height: 80dvh;
      border-radius: 1rem 1rem 0 0;
      padding: 1rem 1rem calc(1rem + env(safe-area-inset-bottom));
    }
  }

  .filters-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted-foreground);
  }
  .filters-checkbox input {
    height: 1.125rem;
    width: 1.125rem;
    border-radius: 0.375rem;
    border: 1px solid var(--color-field-border);
    background-color: var(--color-field);
    accent-color: var(--color-accent, #facc15);
  }

  .filters-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }
  .filters-clear {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--muted-foreground);
    text-decoration: none;
  }
  .filters-clear:hover,
  .filters-clear:focus-visible {
    color: var(--color-accent-ink, #facc15);
  }
  /* The kit's button rule (DIRECCION-VISUAL §3.3): a 34px capsule that hugs
     its label, never stretched (no width). Same yellow fill as before. */
  .filters-apply {
    display: inline-flex;
    flex: none;
    align-items: center;
    height: 34px;
    padding: 0 22px;
    border-radius: 999px;
    background: var(--primary, #facc15);
    font-size: 0.875rem;
    line-height: 1.25rem;
    font-weight: 600;
    color: var(--primary-foreground, #000);
    white-space: nowrap;
    border: none;
    cursor: pointer;
  }
  .filters-apply:hover {
    background: var(--color-accent-hover, #eab308);
  }
  .filters-apply:focus-visible {
    outline: 2px solid var(--ring, #facc15);
    outline-offset: 2px;
  }
</style>

<script>
  // Purely additive polish: close the panel on an outside click or Escape.
  // The <details>/<summary> disclosure already works fully without this.
  //
  // A dropdown's list (`CapsuleSelect`, Radix) belongs to the panel even
  // though it is portaled to <body>, and a press that starts OR ends with a
  // list open belongs to that list, never to the panel:
  //  - opening: Radix opens on pointerdown and sets `pointer-events: none` on
  //    <body> while open, so that same press's `click` lands on <html>;
  //  - choosing an option, or pressing outside to dismiss the list (which
  //    closes the list only, like the first Escape): by the time that
  //    `click` fires the list is gone, so its state is read at pointerdown.
  // Reset on `window`, after every `document` listener has read it, so a
  // later keyboard click never sees a stale value.
  const isListOpen = () => document.querySelector('[data-slot="capsule-select-content"]') !== null;
  let pressStartedOnOpenList = false;
  document.addEventListener(
    'pointerdown',
    () => {
      pressStartedOnOpenList = isListOpen();
    },
    true,
  );
  window.addEventListener('click', () => {
    pressStartedOnOpenList = false;
  });

  function initFiltersPopovers(): void {
    document.querySelectorAll<HTMLDetailsElement>('.filters-popover').forEach((el) => {
      if (el.dataset.chuWired === '1') return;
      el.dataset.chuWired = '1';

      document.addEventListener('click', (e: MouseEvent) => {
        if (!el.open) return;
        if (el.contains(e.target as Node)) return;
        if (pressStartedOnOpenList || isListOpen()) return;
        el.open = false;
      });

      el.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key !== 'Escape' || !el.open) return;
        el.open = false;
        el.querySelector('summary')?.focus();
      });
    });
  }

  initFiltersPopovers();
  document.addEventListener('astro:page-load', initFiltersPopovers);
  document.addEventListener('DOMContentLoaded', initFiltersPopovers);
</script>

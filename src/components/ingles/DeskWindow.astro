---
/**
 * DeskWindow — the practice/creator pages render as a WINDOW over the
 * Inglés desk ("desktop" redesign PART 6a, owner spec 2026-10-06, approved
 * mockup `ChuyoCode_others/propuestas/ingles-escritorio/index.html`'s
 * `.window` / `.titlebar` / `.lights` / `.wactions`). Owner's own words on
 * the refinement that makes this possible without losing real URLs: "la
 * dirección cambia por detrás, pero vos nunca salís del escritorio" — this
 * component is purely the SHELL (lights, title, chip, an `actions` slot, a
 * body slot); the page behind it decides whether a desk renders at all
 * (`DeskScene.astro`, signed-in only — see `[id].astro`'s own header).
 *
 * NON-MODAL FLOATING WINDOW (PART 6c, owner spec 2026-10-07: "quiero que
 * sea una ventana dentro de nuestro escritorio"): at the `desk:` breakpoint
 * and up this is a real floating window — draggable by its own title bar
 * (`@lib/ui/deskWindowDrag`), default-positioned just below the header
 * (`desk:top-(--chrome-header-offset)` — the SAME custom property
 * `BackButton.astro` already reads, `@lib/chromeVisibility.ts`'s own
 * `HEADER_OFFSET_VAR`, kept in sync with the header's REAL rendered height
 * rather than a literal pixel guess that would drift if that height ever
 * changes) — and the desk behind it stays fully visible AND interactive (no
 * veil, no `inert`, no focus trap: see `BaseLayout.astro`'s own header).
 * Below `desk:` it stays the full-screen sheet it always was (no desk
 * visible there regardless, and no drag).
 *
 * VERTICAL CENTRING (owner request, 2026-10-18): the bottom inset used to be
 * a fixed `bottom-16` (64px) — noticeably less than the measured top offset
 * above, which sat the window ~30px low. It now reuses the SAME
 * `--chrome-header-offset` custom property as the top inset, so the window
 * is vertically centred between the header and the viewport's own bottom
 * edge; it only ever gets SHORTER than before, never taller, so it can
 * never grow into the header. The floating minimized-windows tray
 * (`MinimizedWindowsTray.astro`) is independently `fixed`-positioned at the
 * viewport level (its own `desk:bottom-[10px]`, `z-[60]` — above this
 * window's `z-50`), so it was never actually coupled to this inset.
 *
 * Both "close" (red) and "minimize" (yellow) are plain `<a href={closeHref}>`
 * anchors, not buttons — same no-JS-first posture as `BackButton.astro`:
 * a visitor with scripting disabled still lands on the desk (or the
 * ChuyoCode home for a guest) either way. Once `@lib/ui/deskWindow.ts
 * #initDeskWindow` runs, the two diverge: red ALWAYS navigates straight to
 * the desk (PART 6c — never `history.back()`, see that module's own
 * header) and drops any tray chip for this activity, with a subtle "close"
 * animation; yellow REALLY minimizes — it remembers this window as a chip
 * in the desk's own tray, plays a short "shrink toward the tray" animation,
 * then does a plain navigation to the hub. Both animations are skipped
 * under `prefers-reduced-motion: reduce`. "Full screen" (green) has no
 * meaningful no-JS behaviour (there is no state to toggle without a script)
 * and stays a real `<button>`.
 *
 * RENDERED THROUGH `BaseLayout.astro`'s `overlay` SLOT (bugfix, 2026-10-06):
 * `[id].astro` passes this component with `slot="overlay"` — the layout's
 * own LAST element in `<body>` BEFORE the minimized-windows tray, after the
 * footer, outside `<main>` — never the default slot. See `global.css`'s own
 * `.ingles-window` comment for why: rendering inside `<main>` let the
 * footer paint OVER the dialog (a stacking-context trap, not a z-index
 * problem by itself), and `z-50` here only matters once the markup already
 * sits outside that trap.
 *
 * INITIAL FOCUS lands on the dialog element itself (`tabindex="-1"`,
 * `outline-none` — never visibly focus-ringed, this is a container, not a
 * control), not the red light: focusing a traffic light first showed a
 * focus ring on it even for a pointer visit, which this dialog never wants
 * on open. There is no focus trap (PART 6c — the window is not modal): Tab
 * is free to leave it for the desk or the header, same as any other
 * non-modal floating window.
 */
import { ClockIcon } from '@phosphor-icons/react/dist/ssr/Clock';
import { NotePencilIcon } from '@phosphor-icons/react/dist/ssr/NotePencil';
import type { Lang } from '@lib/i18n';
import { ROW_PADDING_X } from '@lib/ui/layout';
import { DESK_WINDOW_LIGHT_CLASS } from '@lib/ui/deskWindowLights';

interface Props {
  lang: Lang;
  title: string;
  titleId?: string;
  /** e.g. "Básico A2" — omitted entirely when the activity has no level. */
  levelChip?: string | null;
  /** The hub (signed-in) or the ChuyoCode home (guest) — see `[id].astro`'s own header. */
  closeHref: string;
  closeLabel: string;
  minimizeLabel: string;
  fullScreenLabel: string;
  /**
   * PART 6a (owner spec 2026-10-06): true for a GUEST (no desk behind the
   * window — a guest cannot see the gated hub at all). The window opens full
   * screen (inset 0, no radius) rather than the normal desktop-inset window,
   * so there is no plain-background gap at the edges revealing the page's
   * own footer underneath. Server-rendered (no-JS-first, same posture as
   * `BackButton.astro`): a guest's full-screen start never depends on a
   * script running. The green light still toggles from there normally.
   */
  forceFullScreen?: boolean;
  /**
   * Minimize-to-tray (owner feedback 2026-10-06): the activity id the yellow
   * light remembers as a tray chip on the desk (`@lib/ui/minimizedWindows`).
   * `null`/omitted for a GUEST — no desk/tray renders behind a guest's
   * window (see the `forceFullScreen` doc above), so the yellow light there
   * just falls back to doing exactly what the red one does
   * (`@lib/ui/deskWindow.ts#initDeskWindow`'s own `minimize()`).
   */
  trayId?: string | null;
  /**
   * PART 6b (the activity editor, `src/pages/[lang]/crear/[id].astro`, is
   * the first non-default caller): false for a window whose BODY already
   * owns Escape for its own purpose (the editor deselects the current zone
   * on Escape — `ActivityEditorIsland`'s own listener) — closing the whole
   * window on top of that would both fight the editor's own shortcut AND
   * discard an unsaved draft with no chance to confirm. `false` here simply
   * skips registering the window's own Escape-closes listener entirely
   * (`@lib/ui/deskWindow.ts#initDeskWindow`); the red light (or whatever
   * shortcut the caller documents) is the only way to close that window.
   * Defaults to `true` — every existing caller (the practice page) keeps
   * today's behaviour unchanged.
   */
  closeOnEscape?: boolean;
  /**
   * PART 6b: an optional muted status string shown right after the title
   * (and `levelChip`, if any) — the activity editor's own live autosave
   * state ("Guardando…" / "Guardado hace un momento" / the error text),
   * mirroring the approved mockup's `.wtitle .saved` span. Omitted entirely
   * (no span at all) for every other caller, which has nothing to show
   * there. This is the SSR-rendered initial value only — the editor island
   * keeps it in sync afterwards with a direct `textContent` write on its own
   * `status` state changes (same thin-DOM-wiring posture as `goToBlock`'s
   * `document.getElementById`), since two separate hydration islands cannot
   * otherwise share one React state.
   */
  status?: string | null;
  /** The status span's own id, for the live-updating caller to target. */
  statusId?: string;
  /**
   * PART 6b polish (owner report: "double framing" + a duplicated title —
   * the editor's own body used to repeat the title as a second, separately
   * boxed input right below this bar's plain text): true makes the title
   * bar's own title area the EDITABLE title instead of static text — a
   * visually-hidden `<span id={titleId}>` keeps `aria-labelledby` working
   * (SSR text, kept in sync the SAME way the non-editable `<b>` always was —
   * see `ActivityEditorIsland.tsx`'s own `DESK_WINDOW_TITLE_ID` effect),
   * plus an EMPTY `#desk-window-title-group` slot the caller's own React
   * island fills via `createPortal` with its real controlled title
   * `<input>` (same technique, same reasoning, as `DESK_WINDOW_ACTIONS_ID`'s
   * own slot below — two separate hydration islands cannot otherwise share
   * one React state). `levelChip` (the practice window's own static pill) is
   * never rendered on this path either — the editor portals an interactive
   * level `<select>` plus its review-status badge into the SAME slot
   * instead. Defaults to `false` — every existing caller (the practice
   * window, the activities-creator PICKER) keeps today's plain-text title
   * unchanged.
   */
  titleEditable?: boolean;
  /**
   * Author preview (R1, owner decision 2026-10-12): "Borrador"/"En
   * revisión"/"Rechazada" — the SAME status label text + pill style
   * `MisActividadesIsland`/`ActivityEditorIsland` already use
   * (`rounded-full border border-border bg-muted …`), shown right in the
   * title bar so it is obvious at a glance that this render is a private
   * preview, never the public one. `null`/omitted (every other caller, and
   * a normal published render) renders nothing — never shown next to
   * `levelChip` unless the caller has one. Unlike `levelChip`, this is NEVER
   * hidden below `sm:` — it is the one privacy signal on the page, so it
   * must survive on a phone too.
   */
  statusChip?: string | null;
  /**
   * UI round 2 (visual pass, 2026-10-12): which calm tone `statusChip`
   * reads in — never red/error, even for "Rechazada" (owner spec: "no debe
   * parecer un error"). `'neutral'` (Borrador) keeps today's plain
   * `bg-muted` pill; `'review'` (En revisión) gets the kit's accent-ink
   * wash plus a small clock glyph; `'caution'` (Rechazada) stays just as
   * calm — the SAME muted pill as `'neutral'`, with a small note-pencil
   * glyph instead of a color change, so the only signal is "this needs a
   * look", never "something broke". Ignored when `statusChip` is unset.
   */
  statusTone?: 'neutral' | 'review' | 'caution';
  /**
   * EMBEDDED (window-manager architecture): true when this window renders
   * inside the host's own `<iframe>` (`@lib/ui/embeddedWindow`'s own
   * header). The HOST frame element now draws the desktop inset/rounded
   * corners/drop shadow (and owns dragging/maximizing it) — this window
   * just fills whatever box the iframe already is, at every viewport width,
   * same as the existing below-`desk:`/guest full-screen sheet. Defaults to
   * `false` — every caller keeps today's own `fixed inset-0 … desk:inset-x-…`
   * desktop-window treatment unchanged.
   */
  embedded?: boolean;
}

const {
  title,
  titleId = 'desk-window-title',
  levelChip = null,
  closeHref,
  closeLabel,
  minimizeLabel,
  fullScreenLabel,
  forceFullScreen = false,
  trayId = null,
  closeOnEscape = true,
  status = null,
  statusId = 'desk-window-status',
  titleEditable = false,
  statusChip = null,
  statusTone = 'neutral',
  embedded = false,
} = Astro.props;
---

<section
  id="desk-window"
  data-desk-window
  data-close-target={closeHref}
  data-tray-id={trayId ?? undefined}
  data-close-on-escape={closeOnEscape ? 'true' : 'false'}
  data-fullscreen={forceFullScreen ? 'true' : undefined}
  role="dialog"
  aria-labelledby={titleId}
  tabindex="-1"
  data-desk-window-embedded={embedded ? '' : undefined}
  class:list={[
    // `bg-chrome`, not `bg-card` (UI-kit refactor, stage-inset pass): the
    // WINDOW's own surface is now the chrome band the titlebar always
    // used, so the small gap `data-desk-window-body` opens around itself
    // below reveals chrome, not a mismatched white sliver. The body itself
    // carries its own `bg-card` unconditionally (below), so this is a no-op
    // in every mode with no gap (mobile, embedded, maximized).
    'ingles-window fixed inset-0 z-50 flex flex-col overflow-clip rounded-none bg-chrome outline-none',
    // EMBEDDED (window-manager architecture): the HOST frame element draws
    // the desktop inset/rounded corners/drop shadow now (and owns dragging/
    // maximizing it) — this window just fills the iframe at every width,
    // same as the existing below-`desk:`/guest full-screen sheet, never the
    // desktop-inset treatment below. See the `embedded` prop's own doc.
    !embedded && [
      'desk:inset-x-[max(48px,calc((100vw-1240px)/2))] desk:top-(--chrome-header-offset) desk:bottom-(--chrome-header-offset) desk:rounded-[20px]',
      'shadow-[0_0_0_1px_rgb(17_18_21_/_0.08),0_30px_80px_rgb(17_18_21_/_0.22)]',
    ],
  ]}
>
  {/* ACTIVITY WINDOW CHROME PASS (owner mockup
      `visor-actividad-franjas-2026-10-17.jpg`, 2026-10-17): the titlebar is
      now a 3-column CSS GRID (`grid-cols-[1fr_auto_1fr]`) instead of a flex
      row — the old flex layout only ever centered the title in the
      LEFTOVER space between the lights and the actions, which drifted
      off-centre whenever those two groups were different widths (lights
      ~84px vs. a wide actions row). The two outer `1fr` columns share the
      bar's free space EQUALLY once the middle `auto` column claims what its
      own content needs, so the title sits on the bar's real centre line
      regardless of how wide either side is — `min-w-0` on the title column
      (below) still lets it shrink/truncate rather than force the grid
      wider. Also shorter now (`py-2`, was `py-3`) — the owner's "gain space
      for the canvas" note on the mockup.

      The editor's own old PART 6b problem (its two TEXT actions — "Ver
      como presentación"/"Enviar a revisión" — squeezing the title to zero
      width on a narrow phone) no longer needs a row-level `flex-wrap` fix:
      below `lg:` those actions move entirely into the title column's own
      "⋯" menu (`ActivityEditorIsland.tsx`'s own `mobileMenu`), which
      already wraps INTERNALLY via its own `flex-wrap` — the grid row
      simply grows to fit that column's height, no special-case needed
      here. */}
  <div
    data-testid="desk-window-titlebar"
    data-desk-window-titlebar
    class={`grid flex-none grid-cols-[1fr_auto_1fr] items-center gap-4 border-b border-border bg-chrome desk:cursor-grab ${ROW_PADDING_X} py-2`}
  >
    {/* TRAFFIC LIGHTS HIT AREA (owner spec: "mejora el área donde se puede
        hacer click en los botones para cerrar, minimizar y maximizar, se
        debe ser muy preciso para poder hacer click"): each light's own
        clickable element is now a comfortable >=28x28px (`h-7 w-7`) box —
        the visible DOT stays the original ~14px (`h-3.5 w-3.5`), centered
        inside it via `inline-flex items-center justify-center` — rather
        than the dot itself being the only clickable area. `group` on this
        wrapper is what reveals every light's own macOS-style glyph (×/−/the
        expand arrows) together on hover OR keyboard focus of ANY one of the
        three (`group-hover`/`group-focus-within`), same as a real macOS
        title bar. `measureTitlebarDragRegions` (`deskWindowTitlebarRegions.ts`)
        excludes every `button`/`a` it finds by its OWN rendered rect, so the
        larger hit area is automatically kept out of the drag regions too —
        no change needed there. */}
    <div class="group flex items-center gap-2">
      <a
        href={closeHref}
        data-desk-window-close
        aria-label={closeLabel}
        title={closeLabel}
        class="relative inline-flex h-7 w-7 items-center justify-center rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <span aria-hidden="true" class={`h-3.5 w-3.5 rounded-full ${DESK_WINDOW_LIGHT_CLASS.close}`}></span>
        <svg
          aria-hidden="true"
          viewBox="0 0 10 10"
          class="pointer-events-none absolute h-2 w-2 text-black/60 opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
        >
          <path d="M2 2L8 8M8 2L2 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" />
        </svg>
      </a>
      <a
        href={closeHref}
        data-desk-window-minimize
        aria-label={minimizeLabel}
        title={minimizeLabel}
        class="relative inline-flex h-7 w-7 items-center justify-center rounded-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
      >
        <span aria-hidden="true" class={`h-3.5 w-3.5 rounded-full ${DESK_WINDOW_LIGHT_CLASS.minimize}`}></span>
        <svg
          aria-hidden="true"
          viewBox="0 0 10 10"
          class="pointer-events-none absolute h-2 w-2 text-black/60 opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
        >
          <path d="M2 5H8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" />
        </svg>
      </a>
      {/* Green (full screen) light — hidden below `desk:` (owner report,
          2026-10-07): every window is ALREADY full screen on a phone (the
          whole `.ingles-window` itself, see this file's own header), so
          there is no state left for this light to toggle there — showing it
          anyway just crowded the title bar next to red/yellow, which stay
          (closing/minimizing is always meaningful). */}
      <button
        type="button"
        data-desk-window-fullscreen
        aria-label={fullScreenLabel}
        title={fullScreenLabel}
        aria-pressed={forceFullScreen ? 'true' : 'false'}
        class="relative hidden h-7 w-7 items-center justify-center rounded-full border-0 bg-transparent p-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring desk:inline-flex"
      >
        <span aria-hidden="true" class={`h-3.5 w-3.5 rounded-full ${DESK_WINDOW_LIGHT_CLASS.fullscreen}`}></span>
        <svg
          aria-hidden="true"
          viewBox="0 0 10 10"
          class="pointer-events-none absolute h-2 w-2 text-black/60 opacity-0 transition-opacity group-hover:opacity-100 group-focus-within:opacity-100"
        >
          <path
            d="M2 4.5V2H4.5M8 5.5V8H5.5"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            fill="none"
          />
        </svg>
      </button>
    </div>
    {/* PART 6b polish bugfix (owner-reported e2e regression: the PRACTICE
        window's own title bar grew past one row on a narrow phone) —
        `flex-wrap`/`items-center` are needed ONLY for the editor's own
        title/level-select/status-badge group (so it can wrap internally
        instead of overlapping, see the `min-w-[220px]` comment below); the
        practice window's plain-text `<b>` title + static chip never needed
        to wrap at all, and its ORIGINAL `items-baseline`, no-wrap layout
        (text truncates/shrinks to fit one line instead) is kept byte
        identical for it. */}
    <div
      class={titleEditable
        ? 'flex min-w-0 flex-wrap items-center gap-2.5'
        /* Centered bold title (UI-kit refactor, macOS-style chrome; activity
           window chrome pass) — only the plain-text branch: the titlebar
           itself is the 3-column grid that centers THIS WHOLE COLUMN in the
           bar now (see the titlebar's own comment above), `justify-center`
           here only centers this column's own children (title/chip/badge)
           relative to each other. The editable branch keeps its own
           left-alignment/wrap needs (narrow-phone overlap fix, see this
           prop's own doc) that a centered flex row would fight. */
        : 'flex min-w-0 items-baseline justify-center gap-2.5'}
      data-desk-window-title-col>
      {titleEditable ? (
        <>
          {/* SSR/no-JS + `aria-labelledby` fallback only — visually hidden,
              kept in sync by the SAME effect that used to write the plain
              `<b>` title's `textContent` (`ActivityEditorIsland.tsx`'s own
              `DESK_WINDOW_TITLE_ID`). The VISIBLE, editable title lives in
              the portal slot right after it. */}
          <span id={titleId} class="sr-only">{title}</span>
          {/* `min-w-[220px]` (not `min-w-0`, PART 6b polish bugfix — owner
              report: "en el teléfono el selector de nivel se superpone con
              el texto de guardado"): without a real minimum, the muted
              autosave status span right after this (its own content-based
              width, `~178px` for "Guardado hace un momento") competed for
              the SAME flex line on a narrow phone and squeezed this slot
              down to ~94px — too narrow for its own level `<select>`
              (`shrink-0`, so it overflowed rather than shrinking) to fit,
              overlapping the status text instead of wrapping cleanly. A
              real minimum here claims its fair share FIRST, so the status
              span is what wraps to its own line below once space is tight —
              exactly the "lights never truncate, title/level/badge win the
              row" priority the mockup wants. */}
          <span
            id="desk-window-title-group"
            data-testid="desk-window-title-group"
            class="flex min-w-[220px] flex-1 flex-wrap items-center gap-2.5"
          />
        </>
      ) : (
        <b id={titleId} class="min-w-0 truncate font-display text-[19px] font-extrabold tracking-[-0.02em] text-foreground">
          {title}
        </b>
      )}
      {/* Hidden below `sm:` (owner report, 2026-10-07: on a 390px phone the
          title collapsed down to "C…" — lights/chip/actions all competing
          for the same tight row left it almost no room). The level is not
          needed in the title bar itself on a phone — it is not otherwise
          surfaced anywhere in the window right now, a deliberate simpler
          trade than adding a second place to show it just for this width. */}
      {!titleEditable && levelChip && (
        <span class="hidden shrink-0 whitespace-nowrap rounded-full bg-[rgb(61_170_107_/_0.14)] px-2.5 py-0.5 text-xs font-semibold text-[#1e6b43] sm:inline-block">
          {levelChip}
        </span>
      )}
      {!titleEditable && statusChip && (
        <span
          data-testid="desk-window-status-chip"
          data-tone={statusTone}
          class:list={[
            'inline-flex shrink-0 items-center gap-1 whitespace-nowrap rounded-full border px-2.5 py-0.5 text-xs font-medium',
            statusTone === 'review'
              ? 'border-transparent bg-accent-ink/10 text-accent-ink'
              : 'border-border bg-muted text-foreground',
          ]}
        >
          {statusTone === 'review' && <ClockIcon aria-hidden="true" size={12} weight="bold" />}
          {statusTone === 'caution' && <NotePencilIcon aria-hidden="true" size={12} weight="bold" />}
          {statusChip}
        </span>
      )}
      {status != null && (
        <span id={statusId} data-testid="desk-window-status" class="min-w-0 shrink truncate text-sm text-muted-foreground">
          {status}
        </span>
      )}
    </div>
    {/* `justify-self-end` (activity window chrome pass) — pins this column's
        own content to the grid column's right edge, replacing the old
        `ml-auto` flex push now that this is its own grid column rather than
        a trailing flex item. `min-w-0 max-w-full` caps it at the column's
        width, so a child allowed to shrink (the editor's submit button)
        ellipsizes instead of spilling past the window's edge. */}
    <div class="flex min-w-0 max-w-full flex-none items-center justify-self-end gap-3" id="desk-window-actions">
      <slot name="actions" />
    </div>
  </div>

  {/* `data-desk-window-body` (PART 6b polish; dock pass: now also `relative`):
      the ONE non-scrolling ancestor the editor's own floating side toolbar
      (`EditorSideToolbar.tsx`) measures against for its ghost dock-target/
      snap-back check (`measureBounds()`), AND — `relative` — the real CSS
      containing block its DOCKED `position: absolute` state anchors to, so
      it moves/resizes with the window for free, no JS positioning while
      docked. See that component's own header. Harmless for every other
      caller (the practice window): nothing else reads this attribute or
      relies on it being a positioning context. */}
  <div
    class:list={[
      // The white STAGE, inset inside the chrome window above it (UI-kit
      // refactor, owner spec: the content area is a white card sitting a
      // small gap inside the `#f0f0f4` chrome, not a flush white fill —
      // `bg-card` unconditionally, since below `desk:`, embedded, and
      // maximized all still want a plain white content area with no gap
      // (see each branch's own note below).
      'relative flex min-h-0 flex-1 flex-col overflow-clip bg-card',
      // GAP + CONCENTRIC RADIUS, desk: and non-embedded only — the same two
      // conditions the window's own desktop inset above is gated on (an
      // embedded window's HOST iframe already draws this framing; below
      // `desk:` the window is the full-screen sheet it always was, with no
      // chrome gap to inset from). `mx-2`/`mb-2` is the owner's ~8px gap on
      // the sides and bottom only — never the top, which stays flush
      // against the titlebar's own bottom border, so only the BOTTOM
      // corners need the concentric radius (window radius 20px − gap 8px
      // = 12px); the top ones stay square where the titlebar meets it.
      // `.ingles-window[data-fullscreen='true']`'s own override (global.css)
      // zeroes this back out for the maximized green-light state, same
      // reasoning that rule already applies to the window's own inset.
      !embedded && 'desk:mx-2 desk:mb-2 desk:rounded-b-[12px] desk:shadow-[var(--shadow-elevation-1),var(--ingles-inset-hairline)]',
    ]}
    data-desk-window-body
  >
    <slot />
  </div>
</section>

<script>
  import { initDeskWindow, initDeskOpenWindowLinks } from '@lib/ui/deskWindow';
  import { initDeskWindowDrag } from '@lib/ui/deskWindowDrag';

  const run = () => {
    const windowEl = document.getElementById('desk-window');
    const closeTarget = windowEl?.getAttribute('data-close-target');
    if (windowEl && closeTarget) {
      const trayId = windowEl.getAttribute('data-tray-id');
      const closeOnEscape = windowEl.getAttribute('data-close-on-escape') !== 'false';
      initDeskWindow(windowEl, closeTarget, trayId, closeOnEscape, document, window);
      initDeskWindowDrag(windowEl, document, window);
    }
    // Embedded only (self-guarded, a no-op otherwise) — see this function's own header.
    initDeskOpenWindowLinks(document, window);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run, { once: true });
  } else {
    run();
  }
  document.addEventListener('astro:page-load', run);
</script>

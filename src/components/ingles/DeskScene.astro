---
/**
 * DeskScene — the Inglés "desk" itself (greeting, folders, widgets, levels
 * dock), extracted from `index.astro` ("desktop" redesign PARTS 3-5) so the
 * SAME desk can render on more than one route.
 *
 * PART 6a (owner spec 2026-10-06, "la dirección cambia por detrás, pero vos
 * nunca salís del escritorio"): the practice page now renders this behind
 * its own window (`DeskWindow.astro`) for every SIGNED-IN visitor — real
 * URLs stay (QR codes, shared links, the sitemap, the back button all still
 * work), but the desk never unmounts underneath. `transition:persist` below
 * is what makes that possible: Astro's ClientRouter keeps THIS element's own
 * DOM (and therefore its drag positions, widget state, scroll) across a
 * hub -> practice (-> hub) client-side navigation, rather than discarding
 * and re-rendering it. A server render still has to produce a real `<section
 * data-desk>` on BOTH pages for a no-JS / direct visit, which is why this
 * component takes its data as plain props (`@lib/ingles/deskSceneData`)
 * instead of assuming a client-side hydration step will fill it in later.
 *
 * NON-MODAL (PART 6c, owner spec 2026-10-07): the desk is never `inert`
 * anymore, even on the practice/creator pages where it sits BEHIND an open
 * window — that window floats on top of it now (non-modal, draggable,
 * `DeskWindow.astro`'s own header), and the desk stays fully visible AND
 * interactive around it, same as the hub itself.
 */
import DeskChrome from '@components/ingles/DeskChrome.astro';
import DeskFolder from '@components/ingles/DeskFolder.astro';
import DeskClockWidget from '@components/ingles/DeskClockWidget.astro';
import DeskCalendarWidget from '@components/ingles/DeskCalendarWidget.astro';
import DeskWeatherWidget from '@components/ingles/DeskWeatherWidget.astro';
import DeskPlayerWidget from '@components/ingles/DeskPlayerWidget';
import { LEVELS, type Level } from '@lib/exerciseTaxonomy';
import type { Lang } from '@lib/i18n';
import type { DeskScenePlayerLabels, DeskSceneLabels } from '@lib/ingles/deskSceneData';
import { characterPoseFallbackSrc, characterPoseSrcSet, characterPoseWidth } from '@/content/characterPoses';

interface Props {
  lang: Lang;
  /** True only on the Inglés hub — forwarded straight to `DeskChrome`'s own `isHub`. */
  isHub: boolean;
  greetingLine1: string;
  activityCountLabel: string | null;
  dailyPickHref: string;
  dailyPickMeta: string | null;
  dailyPickPeek: string | null;
  /** N4: the "Mis actividades" folder, right before "+ Crear actividad" — the route itself is a constant (`/${lang}/mis-actividades`), computed inline below, same as the community folder's own `href`. */
  myActivitiesMeta: string;
  myActivitiesBadgeCount: number;
  myActivitiesBadgeLabel: string | null;
  weatherLat: number;
  weatherLon: number;
  weatherCity: string;
  weatherLabel: string;
  playerLabels: DeskScenePlayerLabels;
  levelLabels: Record<Level, string>;
  labels: DeskSceneLabels;
}

const {
  lang,
  isHub,
  greetingLine1,
  activityCountLabel,
  dailyPickHref,
  dailyPickMeta,
  dailyPickPeek,
  myActivitiesMeta,
  myActivitiesBadgeCount,
  myActivitiesBadgeLabel,
  weatherLat,
  weatherLon,
  weatherCity,
  weatherLabel,
  playerLabels,
  levelLabels,
  labels: t,
} = Astro.props as Props;

// CEFR band -> the dock tile's filled-bar colour (pop tokens, part 2) and how
// many of the 6 bars light up — the level's own position in the ascending
// `LEVELS` list (A1 -> 1 bar … C2 -> 6 bars).
const BAND_FILL_CLASS: Record<'A' | 'B' | 'C', string> = {
  A: 'bg-pop-green',
  B: 'bg-pop-sky',
  C: 'bg-pop-violet',
};
const BAR_HEIGHTS = [7, 11, 15, 19, 23, 27] as const;

function bandOf(level: Level): 'A' | 'B' | 'C' {
  return level[0] as 'A' | 'B' | 'C';
}
---

<section
  data-desk
  transition:persist="desk-scene"
  class="flex w-full flex-col gap-8 px-4 pb-8 desk:relative desk:grid desk:min-h-dvh desk:grid-cols-[minmax(0,1fr)_auto] desk:items-start desk:justify-items-start desk:gap-6 desk:px-7 desk:pt-(--desk-chrome-offset) desk:pb-0"
>
  {/* Desk-integrated logo + account control row ("desktop" redesign, owner
      spec 2026-10-07) — FIRST child so it sits earliest in this stacking
      context; `desk:absolute` there (see its own header) is what lets a
      window or a dragged widget, both later in source order, paint over
      it. */}
  <DeskChrome lang={lang} isHub={isHub} />

  {/* Shared gradients for every `DeskFolder`'s back/front SVG layers —
      defined ONCE here, referenced by id, same `url(#…)` pattern the
      approved mockup itself uses (`index.html`'s `#fb`/`#ff`). */}
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="desk-folder-back" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3aa6dc" />
        <stop offset="1" stop-color="#2b8fc6" />
      </linearGradient>
      <linearGradient id="desk-folder-front" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#6fcdf5" />
        <stop offset="1" stop-color="#4fb5ea" />
      </linearGradient>
    </defs>
  </svg>

  {/* Greeting — the one big type moment, centred on desktop, left-aligned
      and FIRST on phones. `pointer-events-none` on desktop only: it
      overlays the widgets/folders columns, and must never steal a click
      meant for them. */}
  <div
    class="order-1 text-left desk:order-none desk:pointer-events-none desk:absolute desk:top-[46%] desk:left-1/2 desk:w-[min(980px,calc(100%-440px))] desk:-translate-x-1/2 desk:-translate-y-1/2 desk:text-center"
  >
    <h1 class="text-[clamp(40px,4.3vw,68px)] leading-[1.04] font-extrabold tracking-[-0.03em] text-foreground">
      {greetingLine1}
      <br />
      <span class="desk:whitespace-nowrap">{t.greetingQuestion}</span>
    </h1>
    <p class="mx-auto mt-4 max-w-[54ch] text-base text-muted-foreground desk:mt-[18px] desk:text-lg">
      {t.greetingSubtitle}
    </p>
  </div>

  {/* Folders — a right-edge column on desktop, a home-screen grid on
      phones (4 items since N4: "Actividades de la comunidad" + "Para ti
      hoy" + "Mis actividades" + "Crear actividad" now fill a clean 2×2
      exactly, no spot left over). "Ejercicios
      propuestos" folded into the community folder below (owner spec
      2026-10-07: "ya no tendremos ejercicios propuestos separados de
      actividades de la comunidad... de igual manera será una carpeta y
      abrirá una ventana dentro del escritorio") — its own curated-exercise
      count is gone from the desk for the same reason. `openerId="community"`
      gives it the SAME folder-origin scale-in the daily-pick folder already
      has (`@lib/ui/deskWindowManager.ts#onClickCapture`/`applyOpenAnimation`)
      — its destination (`/[lang]/ingles/actividades`) now renders as a
      window too. */}
  <nav
    data-desk-folders
    aria-label={t.foldersLabel}
    class="order-2 grid grid-cols-2 gap-1 desk:order-none desk:col-start-2 desk:row-start-1 desk:flex desk:flex-col desk:items-end desk:gap-[18px] desk:pt-1"
  >
    <DeskFolder
      href={`/${lang}/ingles/actividades`}
      label={t.communityTitle}
      meta={activityCountLabel}
      icon="busts-in-silhouette"
      openerId="community"
    />
    <DeskFolder
      href={dailyPickHref}
      label={t.todayTitle}
      meta={dailyPickMeta}
      icon="glowing-star"
      peekSrc={dailyPickPeek}
      openerId="today"
    />
    {/* N4 (owner spec, resolves UX-INGLES.md's F3/F5): the author's own
        workspace, right before "+ Crear actividad" — same single-instance
        window pattern as the community folder (`openerId="myActivities"`,
        `@lib/deskWindowsState#classifyWindowRoute`'s own case for
        `/[lang]/mis-actividades`). The badge is the "needs action" signal
        (owner spec: "su globo muestra cuántas cambiaron de estado") — only
        ever shown for a REJECTED activity, never for one merely in review. */}
    <DeskFolder
      href={`/${lang}/mis-actividades`}
      label={t.myActivitiesTitle}
      meta={myActivitiesMeta}
      icon="books"
      openerId="myActivities"
      badgeCount={myActivitiesBadgeCount}
      badgeLabel={myActivitiesBadgeLabel}
    />
    <a
      href={`/${lang}/crear`}
      data-desk-window-open="create"
      class="group grid w-full justify-items-center gap-1.5 rounded-2xl px-2 py-2 text-center transition-colors hover:bg-pop-sky/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring desk:w-[148px]"
    >
      <span class="relative block h-[77px] w-24 desk:h-24 desk:w-[120px]">
        <span class="absolute left-1/2 top-1/2 h-[60%] w-[48%] -translate-x-1/2 -translate-y-1/2 rounded-lg border border-border bg-card shadow-elevation-1">
          <span
            aria-hidden="true"
            class="absolute inset-x-3 top-[30%] block h-[3px] rounded-sm bg-muted shadow-[0_9px_0_var(--muted),0_18px_0_var(--muted)]"
          ></span>
          {/* The "+" sits on the sheet's own corner, so it stays attached at
              every size. */}
          <span
            aria-hidden="true"
            class="absolute -right-3 -bottom-2.5 grid h-7 w-7 place-items-center rounded-full bg-pop-sky-deep text-lg font-bold leading-none text-white shadow-elevation-1"
          >
            +
          </span>
        </span>
      </span>
      <span class="text-[13px] font-semibold text-foreground">{t.createActivityLabel}</span>
    </a>
  </nav>

  {/* Widgets — top-left on desktop (160/160/320 columns × 2 rows, 20px
      gaps, exactly the mockup's own `.widgets`), two columns on phones
      (clock+calendar side by side, player/weather full width — the
      `col-span-2` below, unprefixed, is the phone layout; `desk:` swaps
      it back to the 2-column span row 2 actually needs). DOM order
      matches the mockup's own source order (clock, calendar, player,
      weather), which is also what the drag system (`@lib/ui/deskDrag`)
      falls back to positioning from on a visitor's very first visit. */}
  <section
    aria-label={t.widgetsLabel}
    class="order-3 grid grid-cols-2 gap-3 desk:order-none desk:col-start-1 desk:row-start-1 desk:grid-cols-[160px_160px_320px] desk:grid-rows-[auto_auto] desk:gap-5"
  >
    {/* PACO, breaking the box (visual-polish pass, DIRECCION-VISUAL.md
        §4.3): a plain sibling wrapper, `relative`, around the clock widget
        ONLY — not the whole widgets grid — so Paco anchors to THAT widget's
        own box regardless of where the grid places it. Desktop only
        (`desk:` and up), hidden on mobile: there is no room for a
        decorative character once the widgets drop to a 2-column phone
        grid. `aria-hidden` + `alt=""`: purely decorative, never announced,
        never focusable, never covering the clock's own hands (the clock
        itself is already `aria-hidden`/non-interactive, so overlapping its
        box is safe).

        NO EXTRA MARKUP NEEDED FOR THE "GLASS OCCLUSION" EFFECT: Paco is
        BEFORE `DeskClockWidget` in source order and both are plain (non-
        `isolate`d) boxes in the same stacking context, so the widget — an
        `.ingles-glass` surface, `backdrop-filter: blur(24px) saturate(170%)`
        — already paints OVER him by default. His own image is cropped so
        his seat sits at ~63px down from the TOP of his own 140px-tall
        export (~45% of it — `scripts/characters/export-web.mjs`'s own
        `sentado-borde` row); `top-0 -translate-y-[63px]` lifts the whole
        image by exactly that amount so the seam lands right at the clock's
        own top edge (`top-0` on this `relative` wrapper) — everything above
        it (head, shoulders) rises OUTSIDE the widget's box and reads crisp;
        everything below (his seated legs) falls INSIDE the box's footprint
        and reads frosted through the glass. */}
    <div class="relative">
      {/* `hidden desk:block` on PACO ONLY — the clock widget itself (the
          sibling below) must keep rendering at every width; only the
          decorative character is desktop-only. */}
      <picture
        data-testid="desk-scene-paco"
        aria-hidden="true"
        class="pointer-events-none absolute top-0 left-1/2 z-0 hidden h-[140px] w-auto -translate-x-1/2 -translate-y-[63px] desk:block"
      >
        <source type="image/avif" srcset={characterPoseSrcSet('paco/sentado-borde', 'avif')} />
        <source type="image/webp" srcset={characterPoseSrcSet('paco/sentado-borde', 'webp')} />
        <img
          src={characterPoseFallbackSrc('paco/sentado-borde')}
          alt=""
          width={characterPoseWidth('paco/sentado-borde')}
          height="140"
          decoding="async"
          loading="lazy"
          class="block h-[140px] w-auto"
        />
      </picture>
      <div class="relative z-10">
        <DeskClockWidget />
      </div>
    </div>
    <DeskCalendarWidget />
    {/* The drag identity lives on this Astro wrapper, never on the React island's own root: `deskDrag` edits its widget's attributes and inline styles, and doing that to React-owned markup before hydration made React report a hydration mismatch. */}
    <div data-desk-widget="player" class="w-full max-w-[320px] desk:w-[320px]">
      <DeskPlayerWidget labels={playerLabels} client:load />
    </div>
    <DeskWeatherWidget
      lat={weatherLat}
      lon={weatherLon}
      city={weatherCity}
      label={weatherLabel}
      unavailableLabel={t.weatherUnavailable}
      attributionLabel={t.weatherAttribution}
    />
  </section>

  {/* Levels dock — bottom centre on desktop, a horizontal scroller on
      phones. LEVELS ONLY again (PART 6c, owner spec 2026-10-07): the
      minimized-windows tray moved OUT to its own fixed bottom-right
      container (`MinimizedWindowsTray.astro`, mounted once by
      `BaseLayout.astro`) — a small rectangle per window, not a chip squeezed
      in here next to the level tiles. */}
  <div class="order-4 grid justify-items-center gap-2 desk:order-none desk:absolute desk:bottom-10 desk:left-1/2 desk:-translate-x-1/2">
    <span class="text-center text-sm text-muted-foreground">{t.levelShortcutTitle}</span>
    <div
      data-desk-dock
      class="ingles-glass flex max-w-full items-stretch gap-2.5 overflow-x-auto rounded-[26px] p-2.5 desk:max-w-none desk:overflow-visible"
    >
      <nav aria-label={t.levelShortcutTitle} class="flex shrink-0 gap-2.5">
        {
          LEVELS.map((level, index) => {
            const band = bandOf(level);
            return (
              <a
                href={`/${lang}/ingles/actividades?nivel=${level}`}
                data-desk-window-open="community"
                aria-label={`${level}, ${levelLabels[level]}`}
                class="flex w-[76px] shrink-0 flex-col items-center gap-1 rounded-2xl py-1 transition-colors hover:bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              >
                <span class="flex h-14 w-14 items-end justify-center gap-[3px] rounded-[13px] bg-gradient-to-b from-card to-muted pb-3 shadow-[var(--ingles-inset-hairline),0_1px_2px_rgb(17_18_21_/_0.06)]">
                  {BAR_HEIGHTS.map((height, barIndex) => (
                    <i
                      class:list={[
                        'block w-[5px] rounded-sm',
                        barIndex <= index ? BAND_FILL_CLASS[band] : 'bg-muted',
                      ]}
                      style={`height:${height}px`}
                    />
                  ))}
                </span>
                <b class="text-[13px] leading-none text-foreground">{level}</b>
                <small class="text-center text-[11px] leading-tight text-muted-foreground">
                  {levelLabels[level]}
                </small>
              </a>
            );
          })
        }
      </nav>
    </div>
  </div>
</section>

---
/**
 * DeskScene — the Inglés "desk" itself (greeting, folders, widgets, levels
 * dock), extracted from `index.astro` ("desktop" redesign PARTS 3-5) so the
 * SAME desk can render on more than one route.
 *
 * PART 6a (owner spec 2026-10-06, "la dirección cambia por detrás, pero vos
 * nunca salís del escritorio"): the practice page now renders this behind
 * its own window (`DeskWindow.astro`) for every SIGNED-IN visitor — real
 * URLs stay (QR codes, shared links, the sitemap, the back button all still
 * work), but the desk never unmounts underneath. `transition:persist` below
 * is what makes that possible: Astro's ClientRouter keeps THIS element's own
 * DOM (and therefore its drag positions, widget state, scroll) across a
 * hub -> practice (-> hub) client-side navigation, rather than discarding
 * and re-rendering it. A server render still has to produce a real `<section
 * data-desk>` on BOTH pages for a no-JS / direct visit, which is why this
 * component takes its data as plain props (`@lib/ingles/deskSceneData`)
 * instead of assuming a client-side hydration step will fill it in later.
 *
 * `inert` (new, PART 6a): true on the practice page, where the desk sits
 * BEHIND the open window and must not be interactive or reachable by
 * keyboard/AT (the window is `aria-modal`) — `false`/omitted on the hub,
 * where the desk is the whole page.
 */
import DeskFolder from '@components/ingles/DeskFolder.astro';
import DeskClockWidget from '@components/ingles/DeskClockWidget.astro';
import DeskCalendarWidget from '@components/ingles/DeskCalendarWidget.astro';
import DeskWeatherWidget from '@components/ingles/DeskWeatherWidget.astro';
import DeskPlayerWidget from '@components/ingles/DeskPlayerWidget';
import { LEVELS, type Level } from '@lib/exerciseTaxonomy';
import type { Lang } from '@lib/i18n';
import type { DeskScenePlayerLabels, DeskSceneLabels } from '@lib/ingles/deskSceneData';

interface Props {
  lang: Lang;
  /** True on the practice page, where the desk sits behind the open window. */
  inert?: boolean;
  greetingLine1: string;
  exerciseCountLabel: string | null;
  activityCountLabel: string | null;
  dailyPickHref: string;
  dailyPickMeta: string | null;
  dailyPickPeek: string | null;
  weatherLat: number;
  weatherLon: number;
  weatherCity: string;
  weatherLabel: string;
  playerLabels: DeskScenePlayerLabels;
  levelLabels: Record<Level, string>;
  labels: DeskSceneLabels;
}

const {
  lang,
  inert = false,
  greetingLine1,
  exerciseCountLabel,
  activityCountLabel,
  dailyPickHref,
  dailyPickMeta,
  dailyPickPeek,
  weatherLat,
  weatherLon,
  weatherCity,
  weatherLabel,
  playerLabels,
  levelLabels,
  labels: t,
} = Astro.props as Props;

// CEFR band -> the dock tile's filled-bar colour (pop tokens, part 2) and how
// many of the 6 bars light up — the level's own position in the ascending
// `LEVELS` list (A1 -> 1 bar … C2 -> 6 bars).
const BAND_FILL_CLASS: Record<'A' | 'B' | 'C', string> = {
  A: 'bg-pop-green',
  B: 'bg-pop-sky',
  C: 'bg-pop-violet',
};
const BAR_HEIGHTS = [7, 11, 15, 19, 23, 27] as const;

function bandOf(level: Level): 'A' | 'B' | 'C' {
  return level[0] as 'A' | 'B' | 'C';
}
---

<section
  data-desk
  transition:persist="desk-scene"
  inert={inert}
  class="flex w-full flex-col gap-8 px-4 pb-8 desk:relative desk:grid desk:min-h-[calc(100dvh-96px)] desk:grid-cols-[minmax(0,1fr)_auto] desk:items-start desk:justify-items-start desk:gap-6 desk:px-7 desk:pt-3 desk:pb-0"
>
  {/* Shared gradients for every `DeskFolder`'s back/front SVG layers —
      defined ONCE here, referenced by id, same `url(#…)` pattern the
      approved mockup itself uses (`index.html`'s `#fb`/`#ff`). */}
  <svg width="0" height="0" class="absolute" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="desk-folder-back" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#3aa6dc" />
        <stop offset="1" stop-color="#2b8fc6" />
      </linearGradient>
      <linearGradient id="desk-folder-front" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#6fcdf5" />
        <stop offset="1" stop-color="#4fb5ea" />
      </linearGradient>
    </defs>
  </svg>

  {/* Greeting — the one big type moment, centred on desktop, left-aligned
      and FIRST on phones. `pointer-events-none` on desktop only: it
      overlays the widgets/folders columns, and must never steal a click
      meant for them. */}
  <div
    class="order-1 text-left desk:order-none desk:pointer-events-none desk:absolute desk:top-[46%] desk:left-1/2 desk:w-[min(980px,calc(100%-440px))] desk:-translate-x-1/2 desk:-translate-y-1/2 desk:text-center"
  >
    <h1 class="text-[clamp(40px,4.3vw,68px)] leading-[1.04] font-extrabold tracking-[-0.03em] text-foreground">
      {greetingLine1}
      <br />
      <span class="desk:whitespace-nowrap">{t.greetingQuestion}</span>
    </h1>
    <p class="mx-auto mt-4 max-w-[54ch] text-base text-muted-foreground desk:mt-[18px] desk:text-lg">
      {t.greetingSubtitle}
    </p>
  </div>

  {/* Folders — a right-edge column on desktop, a home-screen grid on
      phones (4 items: the 3 folders + "Crear actividad" fit a clean 2×2). */}
  <nav
    aria-label={t.foldersLabel}
    class="order-2 grid grid-cols-2 gap-1 desk:order-none desk:col-start-2 desk:row-start-1 desk:flex desk:flex-col desk:items-end desk:gap-[18px] desk:pt-1"
  >
    <DeskFolder
      href={`/${lang}/ingles/propuestos`}
      label={t.proposedTitle}
      meta={exerciseCountLabel}
      icon="books"
    />
    <DeskFolder
      href={`/${lang}/ingles/actividades`}
      label={t.communityTitle}
      meta={activityCountLabel}
      icon="busts-in-silhouette"
    />
    <DeskFolder
      href={dailyPickHref}
      label={t.todayTitle}
      meta={dailyPickMeta}
      icon="glowing-star"
      peekSrc={dailyPickPeek}
      openerId="today"
    />
    <a
      href={`/${lang}/crear`}
      data-desk-window-open="create"
      class="group grid w-full justify-items-center gap-1.5 rounded-2xl px-2 py-2 text-center transition-colors hover:bg-pop-sky/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring desk:w-[148px]"
    >
      <span class="relative block h-[77px] w-24 desk:h-24 desk:w-[120px]">
        <span class="absolute left-1/2 top-1/2 h-[60%] w-[48%] -translate-x-1/2 -translate-y-1/2 rounded-lg border border-border bg-card shadow-[0_2px_6px_rgb(28_28_30_/_0.08)]">
          <span
            aria-hidden="true"
            class="absolute inset-x-3 top-[30%] block h-[3px] rounded-sm bg-muted shadow-[0_9px_0_var(--muted),0_18px_0_var(--muted)]"
          ></span>
          {/* The "+" sits on the sheet's own corner, so it stays attached at
              every size. */}
          <span
            aria-hidden="true"
            class="absolute -right-3 -bottom-2.5 grid h-7 w-7 place-items-center rounded-full bg-pop-sky-deep text-lg font-bold leading-none text-white shadow-[0_1px_3px_rgb(28_28_30_/_0.2)]"
          >
            +
          </span>
        </span>
      </span>
      <span class="text-[13px] font-semibold text-foreground">{t.createActivityLabel}</span>
    </a>
  </nav>

  {/* Widgets — top-left on desktop (160/160/320 columns × 2 rows, 20px
      gaps, exactly the mockup's own `.widgets`), two columns on phones
      (clock+calendar side by side, player/weather full width — the
      `col-span-2` below, unprefixed, is the phone layout; `desk:` swaps
      it back to the 2-column span row 2 actually needs). DOM order
      matches the mockup's own source order (clock, calendar, player,
      weather), which is also what the drag system (`@lib/ui/deskDrag`)
      falls back to positioning from on a visitor's very first visit. */}
  <section
    aria-label={t.widgetsLabel}
    class="order-3 grid grid-cols-2 gap-3 desk:order-none desk:col-start-1 desk:row-start-1 desk:grid-cols-[160px_160px_320px] desk:grid-rows-[auto_auto] desk:gap-5"
  >
    <DeskClockWidget />
    <DeskCalendarWidget />
    <DeskPlayerWidget labels={playerLabels} client:load />
    <DeskWeatherWidget
      lat={weatherLat}
      lon={weatherLon}
      city={weatherCity}
      label={weatherLabel}
      unavailableLabel={t.weatherUnavailable}
      attributionLabel={t.weatherAttribution}
    />
  </section>

  {/* Levels dock — bottom centre on desktop, a horizontal scroller on
      phones — PLUS the minimized-windows tray (owner feedback 2026-10-06),
      a slot to its right on desktop, separated by a hairline "like macOS's
      dock" (owner's own words); a compact row ABOVE the dock on phones (it
      is first in DOM order, which is also visual order in the `flex-col`
      phone layout), hidden below `sm:` where there is no room for it to sit
      cleanly above a horizontally-scrolling dock. Always server-rendered
      (empty, `hidden`) so a no-JS visit degrades to exactly today's dock —
      `@lib/ui/minimizedWindows#initMinimizedWindowsTray` is what actually
      fills/unhides it, from `sessionStorage`, once it runs. */}
  <div
    class="order-4 flex flex-col items-center gap-2 desk:order-none desk:absolute desk:bottom-10 desk:left-1/2 desk:-translate-x-1/2 desk:flex-row desk:items-stretch"
  >
    <div class="grid justify-items-center gap-2">
      <span class="text-center text-sm text-muted-foreground">{t.levelShortcutTitle}</span>
      <nav
        aria-label={t.levelShortcutTitle}
        class="ingles-glass flex max-w-full gap-2.5 overflow-x-auto rounded-[26px] p-2.5"
      >
        {
          LEVELS.map((level, index) => {
            const band = bandOf(level);
            return (
              <a
                href={`/${lang}/ingles/propuestos?nivel=${level}`}
                aria-label={`${level}, ${levelLabels[level]}`}
                class="flex w-[76px] shrink-0 flex-col items-center gap-1 rounded-2xl py-1 transition-colors hover:bg-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              >
                <span class="flex h-14 w-14 items-end justify-center gap-[3px] rounded-[13px] bg-gradient-to-b from-card to-muted pb-3 shadow-[inset_0_0_0_0.5px_rgb(28_28_30_/_0.1),0_1px_2px_rgb(28_28_30_/_0.06)]">
                  {BAR_HEIGHTS.map((height, barIndex) => (
                    <i
                      class:list={[
                        'block w-[5px] rounded-sm',
                        barIndex <= index ? BAND_FILL_CLASS[band] : 'bg-muted',
                      ]}
                      style={`height:${height}px`}
                    />
                  ))}
                </span>
                <b class="text-[13px] leading-none text-foreground">{level}</b>
                <small class="text-center text-[11px] leading-tight text-muted-foreground">
                  {levelLabels[level]}
                </small>
              </a>
            );
          })
        }
      </nav>
    </div>

    <div
      aria-hidden="true"
      data-minimized-tray-hairline
      data-testid="minimized-tray-hairline"
      hidden
      class="h-px w-10 self-center bg-border sm:order-first desk:order-none desk:h-auto desk:w-px desk:self-stretch"
    ></div>
    <nav
      data-minimized-tray
      data-testid="minimized-tray"
      data-remove-label={t.trayRemoveLabel}
      hidden
      aria-label={t.trayLabel}
      class="order-first hidden max-w-full flex-wrap items-center justify-center gap-2 sm:order-none sm:flex desk:flex-nowrap desk:justify-start"
    ></nav>
  </div>
</section>

<script>
  import { initMinimizedWindowsTray } from '@lib/ui/minimizedWindows';

  const run = () => initMinimizedWindowsTray();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run, { once: true });
  } else {
    run();
  }
  document.addEventListener('astro:page-load', run);
</script>

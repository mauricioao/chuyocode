---
/**
 * Footer — site footer (spec 7: Footer requirement).
 *
 * Renders the copyright line and secondary links (Términos, Privacidad,
 * Reembolsos, Créditos). Simple zinc-900 background surface.
 *
 * The secondary links point at the single localized legal route
 * `/[lang]/legal/[page]` (design decision #9). They previously targeted
 * `/[lang]/terminos` and `/[lang]/privacidad`, which had no backing page and
 * 404'd; they now resolve to real `terms` / `privacy` / `reembolsos`
 * documents (the last one keeps its Spanish slug in both languages, same
 * convention as every other `[lang]`-scoped page segment).
 *
 * i18n note: secondary link labels come from the shared `src/lib/i18n.ts`
 * (`UI_LABELS`). The previous inline FOOTER_LABELS map was removed once
 * i18n.ts landed (Phase 3).
 *
 * "Premium" link (pricing page, owner decision 2026-10-04): points at the
 * new `/[lang]/premium` route, listed first since it is a product link, not
 * legal boilerplate like the two links after it. Footer-only on purpose —
 * `Header.astro` is not touched by this change.
 *
 * Cleaner transitions (navigation-without-flicker PR): `transition:animate
 * ="none"` excludes the footer from the page's fade animation — only
 * `<main>` (`BaseLayout.astro`) cross-fades on navigation.
 *
 * SMART VISIBILITY (chrome-visibility feature): `data-chrome-footer` is the
 * hook `src/lib/chromeVisibility.ts` and `global.css` use to fade this
 * element in/out — see `Header.astro`'s own matching note for why it has to
 * sit on the real `<footer>` rather than the `display:contents` wrapper
 * around it. Unlike the header, this element has no `transition:persist`
 * (a fresh copy renders on every navigation), so the wiring script never
 * caches a reference to it — it is re-queried whenever needed instead.
 *
 * INGLÉS "BLOCKS" VARIANT (owner spec 2026-10-05, town.com-style): the
 * `ingles` prop renders the SAME copyright + secondary links as one bordered/
 * rounded panel block inside the page margins, instead of a full-width dark
 * bar — see `Header.astro`'s own matching note for why this lives as a
 * second branch of the SAME component rather than a separate file. Every
 * OTHER page keeps the original branch, byte-for-byte unchanged.
 */
import { UI_LABELS, DEFAULT_LANG, type Lang } from '@lib/i18n';

interface Props {
  lang?: Lang;
  /** Owner spec 2026-10-05: renders the INGLÉS bordered panel instead of the default dark bar. Defaults to `false` — every existing call site is unaffected. */
  ingles?: boolean;
}

const { lang = DEFAULT_LANG, ingles = false } = Astro.props;

const labels = UI_LABELS[lang].footer;
const base = `/${lang}`;

// Copyright year (SEO basics pass): computed at render time instead of
// hardcoded, so the footer never silently goes stale after a new year.
const currentYear = new Date().getFullYear();

const secondaryLinks = [
  { href: `${base}/premium`, label: labels.premium },
  { href: `${base}/legal/terms`, label: labels.terms },
  { href: `${base}/legal/privacy`, label: labels.privacy },
  { href: `${base}/legal/reembolsos`, label: labels.reembolsos },
  { href: `${base}/creditos`, label: labels.credits },
];
---

{ingles ? (
  /* INGLÉS panel branch (owner spec 2026-10-05) — `data-chrome-footer`
     stays on this outer element (the grid container `global.css`'s
     `[data-chrome-mode='ingles']` rules collapse/expand) and `data-chrome-
     collapse` marks its one grid-item child, clipped to zero height while
     collapsed. NEITHER of those two carries its own padding/margin —
     `overflow: hidden` only clips a DESCENDANT's box, never the box's own
     padding, so a grid container/item with its own padding could never
     actually reach zero height. The page-margin padding (so the panel sits
     "inside the page margins" rather than edge-to-edge) lives one level
     deeper instead, on this plain inner div. */
  <footer data-chrome-footer transition:animate="none">
    <div data-chrome-collapse>
      <div class="mx-auto w-full max-w-6xl px-4 pb-6 sm:pb-8">
        <div class="flex w-full flex-col items-center justify-between gap-4 rounded-card border border-border bg-card px-6 py-6 shadow-elevation-1 sm:flex-row">
          <p class="text-sm text-muted-foreground">&copy; {currentYear} ChuyoCode</p>
          <nav
            class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:justify-end"
            aria-label="Secondary"
          >
            {
              secondaryLinks.map((link) => (
                <a
                  href={link.href}
                  class="whitespace-nowrap text-sm text-muted-foreground transition-theme duration-theme hover:text-accent-ink"
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
      </div>
    </div>
  </footer>
) : (
  <footer
    data-chrome-footer
    class="border-t border-border bg-card transition-theme duration-theme"
    transition:animate="none"
  >
    <div
      class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-4 px-4 py-6 sm:flex-row"
    >
      <p class="text-sm text-muted-foreground">&copy; {currentYear} ChuyoCode</p>
      {/* Five links do not fit one row on a phone: the row wraps between
          links and every label stays on one line (tests/e2e/mobile-overflow). */}
      <nav
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:justify-end"
        aria-label="Secondary"
      >
        {
          secondaryLinks.map((link) => (
            <a
              href={link.href}
              class="whitespace-nowrap text-sm text-muted-foreground transition-theme duration-theme hover:text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </footer>
)}

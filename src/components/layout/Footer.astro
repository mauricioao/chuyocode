---
/**
 * Footer — site footer (spec 7: Footer requirement).
 *
 * Renders the copyright line and secondary links (Premium, Términos,
 * Privacidad). Simple zinc-900 background surface.
 *
 * The legal links point at the single localized legal route
 * `/[lang]/legal/[page]` (design decision #9). They previously targeted
 * `/[lang]/terminos` and `/[lang]/privacidad`, which had no backing page and
 * 404'd; they now resolve to real `terms` / `privacy` documents.
 *
 * i18n note: secondary link labels come from the shared `src/lib/i18n.ts`
 * (`UI_LABELS`). The previous inline FOOTER_LABELS map was removed once
 * i18n.ts landed (Phase 3).
 *
 * FOOTER SIMPLIFICATION (owner decision, "opción A", 2026-10-06): the footer
 * now shows exactly four items — copyright, Premium, Términos, Privacidad.
 * "Reembolsos" and "Créditos" were REMOVED from here; their pages and routes
 * stay live and stay in the sitemap, just no longer linked from every page's
 * footer:
 *  - the refund policy is reachable from the Premium FAQ
 *    (`[lang]/premium.astro`'s own `t.faq` refund item) and from the Terms
 *    page (`TermsContent.astro`'s section 7, "Premium: precios y pagos");
 *  - the credits page is reachable from the Terms page's new final section
 *    ("Créditos y licencias"/"Credits and licences").
 * "Premium" gets its own eye-catching treatment to match (below): a yellow
 * pill with a sparkle glyph, not a plain text link like Términos/Privacidad
 * — it is a product link, not legal boilerplate.
 *
 * Cleaner transitions (navigation-without-flicker PR): `transition:animate
 * ="none"` excludes the footer from the page's fade animation — only
 * `<main>` (`BaseLayout.astro`) cross-fades on navigation.
 *
 * SMART VISIBILITY (chrome-visibility feature): `data-chrome-footer` is the
 * hook `src/lib/chromeVisibility.ts` and `global.css` use to fade this
 * element in/out — see `Header.astro`'s own matching note for why it has to
 * sit on the real `<footer>` rather than the `display:contents` wrapper
 * around it. Unlike the header, this element has no `transition:persist`
 * (a fresh copy renders on every navigation), so the wiring script never
 * caches a reference to it — it is re-queried whenever needed instead.
 *
 * INGLÉS "BLOCKS" VARIANT (owner spec 2026-10-05, town.com-style): the
 * `ingles` prop renders the SAME copyright + secondary links — see
 * `Header.astro`'s own matching note for why this lives as a second branch
 * of the SAME component rather than a separate file. Every OTHER page keeps
 * the original branch, byte-for-byte unchanged.
 *
 * PART 1 of the "desktop" redesign (owner spec 2026-10-06, scope extension
 * item A) REPLACED the original bordered/rounded "panel inside the page
 * margins" look above with a full-width bar — edge to edge, `border-t` +
 * `bg-card` resolving to the light Inglés palette, same shape as the SITE
 * branch below — carrying every item the footer always has (same
 * `secondaryLinks`, same copyright line, now bold). `data-chrome-footer`
 * stays directly on the `<footer>`; there is no `data-chrome-collapse`
 * wrapper anymore either — see "clean footer scroll" in
 * `chromeVisibility.ts`'s own header for why the Inglés footer no longer
 * collapses/animates at all, in either branch's CSS consequence
 * (`global.css`'s own chrome-visibility section).
 */
import { UI_LABELS, DEFAULT_LANG, type Lang } from '@lib/i18n';

interface Props {
  lang?: Lang;
  /** Owner spec 2026-10-05: renders the INGLÉS bordered panel instead of the default dark bar. Defaults to `false` — every existing call site is unaffected. */
  ingles?: boolean;
  /**
   * PART 6a bugfix (owner spec 2026-10-06): true while the practice page's
   * window sits open over this page — see `Header.astro`'s own matching
   * `inert` prop doc. Defaults to `false` — every existing call site is
   * unaffected.
   */
  inert?: boolean;
}

const { lang = DEFAULT_LANG, ingles = false, inert = false } = Astro.props;

const labels = UI_LABELS[lang].footer;
const base = `/${lang}`;

// Copyright year (SEO basics pass): computed at render time instead of
// hardcoded, so the footer never silently goes stale after a new year.
const currentYear = new Date().getFullYear();

const secondaryLinks = [
  { href: `${base}/legal/terms`, label: labels.terms },
  { href: `${base}/legal/privacy`, label: labels.privacy },
];
const premiumHref = `${base}/premium`;

// Phosphor "Sparkle", regular weight, 256×256 viewBox — path copied verbatim
// from `node_modules/@phosphor-icons/react/dist/defs/Sparkle.es.js` (MIT
// licensed, credited on `/[lang]/creditos`), same "copy the geometry, skip
// the React import" posture `@lib/skillIcons.ts`/`Header.astro`'s own
// "Ordenar escritorio" icon already document — this file renders no React.
const SPARKLE_PATH =
  'M197.58,129.06,146,110l-19-51.62a15.92,15.92,0,0,0-29.88,0L78,110l-51.62,19a15.92,15.92,0,0,0,0,29.88L78,178l19,51.62a15.92,15.92,0,0,0,29.88,0L146,178l51.62-19a15.92,15.92,0,0,0,0-29.88ZM137,164.22a8,8,0,0,0-4.74,4.74L112,223.85,91.78,169A8,8,0,0,0,87,164.22L32.15,144,87,123.78A8,8,0,0,0,91.78,119L112,64.15,132.22,119a8,8,0,0,0,4.74,4.74L191.85,144ZM144,40a8,8,0,0,1,8-8h16V16a8,8,0,0,1,16,0V32h16a8,8,0,0,1,0,16H184V64a8,8,0,0,1-16,0V48H152A8,8,0,0,1,144,40ZM248,88a8,8,0,0,1-8,8h-8v8a8,8,0,0,1-16,0V96h-8a8,8,0,0,1,0-16h8V72a8,8,0,0,1,16,0v8h8A8,8,0,0,1,248,88Z';

// Shared pill classes for the Premium link in BOTH branches below: the
// ChuyoCode brand-accent FILL (`bg-accent`, `--color-accent: #facc15` in
// both the dark brand and light Inglés palettes — `global.css`'s own
// `@theme` header), ink text (`text-primary-foreground`, already the
// correct dark ink in both palettes), a soft hover step one shade deeper
// (`hover:bg-accent-hover`), and a visible keyboard focus ring — same
// ring/offset pattern as every other interactive control (`premium.astro`'s
// own `PRIMARY_CTA`). `transition-colors` only (no motion) respects
// `prefers-reduced-motion` by construction: there is nothing to reduce.
const PREMIUM_PILL =
  'inline-flex items-center gap-1 whitespace-nowrap rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-primary-foreground transition-colors duration-theme hover:bg-accent-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2';
---

{ingles ? (
  /* INGLÉS full-width bar (PART 1 scope extension, item A) — same shape as
     the SITE branch below (`border-t` + `bg-card`, full width, no rounded/
     floating panel), just the light Inglés palette + the bold copyright. No
     `data-chrome-collapse` wrapper: see this file's own header for why the
     Inglés footer is no longer a collapsible grid item at all. */
  <footer
    data-chrome-footer
    inert={inert}
    class="border-t border-border bg-card transition-theme duration-theme"
    transition:animate="none"
  >
    {/* "Desktop" redesign PART 3 (owner spec 2026-10-06): same full-width,
        gutter-matched treatment as the header above — see that file's own
        matching note. */}
    <div class="flex w-full flex-col items-center justify-between gap-4 px-4 py-6 desk:px-7 sm:flex-row">
      <p class="text-sm font-bold text-muted-foreground">&copy; {currentYear} ChuyoCode</p>
      <nav
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:justify-end"
        aria-label="Secondary"
      >
        <a href={premiumHref} class={PREMIUM_PILL}>
          <svg viewBox="0 0 256 256" class="h-3 w-3" aria-hidden="true" fill="currentColor">
            <path d={SPARKLE_PATH} />
          </svg>
          {labels.premium}
        </a>
        {
          secondaryLinks.map((link) => (
            <a
              href={link.href}
              class="whitespace-nowrap text-sm text-muted-foreground transition-theme duration-theme hover:text-accent-ink"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </footer>
) : (
  <footer
    data-chrome-footer
    inert={inert}
    class="border-t border-border bg-card transition-theme duration-theme"
    transition:animate="none"
  >
    <div
      class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-4 px-4 py-6 sm:flex-row"
    >
      <p class="text-sm text-muted-foreground">&copy; {currentYear} ChuyoCode</p>
      {/* The row wraps between items on a phone and every label stays on one
          line (tests/e2e/mobile-overflow). */}
      <nav
        class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 sm:justify-end"
        aria-label="Secondary"
      >
        <a href={premiumHref} class={PREMIUM_PILL}>
          <svg viewBox="0 0 256 256" class="h-3 w-3" aria-hidden="true" fill="currentColor">
            <path d={SPARKLE_PATH} />
          </svg>
          {labels.premium}
        </a>
        {
          secondaryLinks.map((link) => (
            <a
              href={link.href}
              class="whitespace-nowrap text-sm text-muted-foreground transition-theme duration-theme hover:text-primary"
            >
              {link.label}
            </a>
          ))
        }
      </nav>
    </div>
  </footer>
)}

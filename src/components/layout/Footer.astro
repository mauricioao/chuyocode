---
/**
 * Footer — site footer (spec 7: Footer requirement).
 *
 * Renders the copyright line and secondary links (Términos, Privacidad,
 * Reembolsos). Simple zinc-900 background surface.
 *
 * The secondary links point at the single localized legal route
 * `/[lang]/legal/[page]` (design decision #9). They previously targeted
 * `/[lang]/terminos` and `/[lang]/privacidad`, which had no backing page and
 * 404'd; they now resolve to real `terms` / `privacy` / `reembolsos`
 * documents (the last one keeps its Spanish slug in both languages, same
 * convention as every other `[lang]`-scoped page segment).
 *
 * i18n note: secondary link labels come from the shared `src/lib/i18n.ts`
 * (`UI_LABELS`). The previous inline FOOTER_LABELS map was removed once
 * i18n.ts landed (Phase 3).
 *
 * "Premium" link (pricing page, owner decision 2026-10-04): points at the
 * new `/[lang]/premium` route, listed first since it is a product link, not
 * legal boilerplate like the two links after it. Footer-only on purpose —
 * `Header.astro` is not touched by this change.
 *
 * Cleaner transitions (navigation-without-flicker PR): `transition:animate
 * ="none"` excludes the footer from the page's fade animation — only
 * `<main>` (`BaseLayout.astro`) cross-fades on navigation.
 */
import { UI_LABELS, DEFAULT_LANG, type Lang } from '@lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;

const labels = UI_LABELS[lang].footer;
const base = `/${lang}`;

// Copyright year (SEO basics pass): computed at render time instead of
// hardcoded, so the footer never silently goes stale after a new year.
const currentYear = new Date().getFullYear();

const secondaryLinks = [
  { href: `${base}/premium`, label: labels.premium },
  { href: `${base}/legal/terms`, label: labels.terms },
  { href: `${base}/legal/privacy`, label: labels.privacy },
  { href: `${base}/legal/reembolsos`, label: labels.reembolsos },
];
---

<footer
  class="border-t border-border bg-card transition-theme duration-theme"
  transition:animate="none"
>
  <div
    class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-4 px-4 py-6 sm:flex-row"
  >
    <p class="text-sm text-muted-foreground">&copy; {currentYear} ChuyoCode</p>
    <nav class="flex items-center gap-6" aria-label="Secondary">
      {
        secondaryLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm text-muted-foreground transition-theme duration-theme hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>

---
/**
 * Header — site masthead (spec 7: Header requirement).
 *
 * Renders:
 *  - The masthead logo (small image + "ChuyoCode" wordmark), linked to the
 *    localized home (`/{lang}/`). The image points at `/logo.svg`, which is
 *    intentionally absent until the real asset is dropped in `public/` — it
 *    renders as a broken-image placeholder on purpose in the meantime.
 *  - Primary, localized nav links (Libros, Noticias, Cursos, Inglés), on the
 *    RIGHT side of the bar next to the account area (logo stays on the
 *    left). The Cursos/Inglés routes are intentional future links (they 404
 *    until their pages land).
 *  - A mobile hamburger button (structure + JS toggle stub only).
 *
 * The site is dark-only and Spanish-only in the chrome: there is no theme
 * toggle, no language toggle, and no disabled English slot. (The `/en/` routes
 * stay functional at the routing level; only the UI toggle was removed.)
 *
 * i18n note: nav labels come from the shared `src/lib/i18n.ts` (`UI_LABELS`),
 * the single source of truth for localized chrome. The previous inline
 * NAV_LABELS map was removed once i18n.ts landed (Phase 3).
 *
 * 🔴 THE ACCOUNT CHIP (`UserMenu`) IS THE ONE CLIENT-ONLY ISLAND HERE, AND
 * THAT IS DELIBERATE (Login step 1b). `Header` is part of `BaseLayout`, which
 * PUBLIC pages (home, libros, noticias) serve under a public cache policy
 * (`src/lib/httpCache.ts`) — this file must therefore render BYTE-IDENTICAL
 * markup for every visitor, signed in or not, or the CDN could serve one
 * visitor's name/avatar to the next request for the same URL (T7). So
 * `Header` reads no `Astro.locals.user` at all, ever: `UserMenu` hydrates
 * client-side and asks `GET /api/me` (always private/no-store) instead. See
 * that component's header for the full reasoning.
 *
 * PERSISTENT ACROSS NAVIGATIONS (navigation-without-flicker PR):
 * `transition:persist` on the root `<header>` keeps this exact DOM subtree
 * — nav links AND the mounted `UserMenu` island — across every client-side
 * navigation instead of Astro swapping in a fresh copy. That is what stops
 * the double-header cross-fade (old + new header briefly superimposed) and
 * the "Ingresar" flash (`UserMenu` no longer remounts into its loading
 * placeholder, or re-fetches `/api/me`, on every page). `transition:animate
 * ="none"` on top: even though persisted elements are never part of the
 * transition's old/new pair, this makes that explicit rather than relying
 * on it implicitly. There is no active-nav-link state to update on
 * navigation (no `aria-current` styling exists yet) — nothing else here
 * needs an `astro:page-load` listener today.
 *
 * SMART VISIBILITY (chrome-visibility feature): `data-chrome-header` is the
 * hook `src/lib/chromeVisibility.ts` and `global.css` use to find and
 * animate THIS element specifically — not the `[data-theme="brand"]`
 * `contents` wrapper `BaseLayout.astro` renders around it, which (being
 * `display: contents`) cannot itself be positioned, transformed or faded.
 * `aria-expanded` on the hamburger button below and on `UserMenu`'s own
 * trigger is also how that script detects "a menu inside the header is
 * open" (one MutationObserver, no extra wiring needed here).
 *
 * INGLÉS "BLOCKS" VARIANT (owner spec 2026-10-05, town.com-style): the
 * `ingles` prop switches this SAME component to a second, independent
 * markup branch below — rendered ONLY by `BaseLayout.astro` when
 * `theme="ingles"`, and only ever inside the page's own light
 * `[data-theme="ingles"]` scope (no `[data-theme="brand"] dark` wrapper
 * there — see that file's own header). Every OTHER page keeps the original
 * branch below, byte-for-byte unchanged. Both branches share
 * `data-chrome-header` and the hamburger toggle script at the bottom (a
 * no-op in Inglés mode — see PART 1 below).
 *
 * PART 1 of the "desktop" redesign (owner spec 2026-10-06): the Inglés
 * branch dropped its own Libros/Noticias/Inglés nav block entirely (desktop
 * AND mobile) — it is a `theme="ingles"` page already, so that nav was
 * always "you are here" — and the bordered/padded box that used to wrap the
 * account control. What is left is just the unchanged logo block and the
 * bare `UserMenu` island (avatar trigger, or the "Ingresar" pill signed
 * out), sitting directly in the header row. With no nav links left, there is
 * nothing for a hamburger to hold either, so this branch renders no
 * `#mobile-menu-button`/`#mobile-menu` at all; the toggle script at the
 * bottom still looks for those ids unconditionally (shared with the SITE
 * branch below, which still has them) and simply no-ops when they are
 * absent.
 */
import { UI_LABELS, DEFAULT_LANG, type Lang } from '@lib/i18n';
import { isInglesHubPath } from '@lib/backNavigation';
import { ICON_TOOLTIP_BUBBLE_CLASS } from '@lib/ui/iconTooltip';
import UserMenu from '@components/islands/UserMenu';

interface Props {
  lang?: Lang;
  /** Owner spec 2026-10-05: renders the INGLÉS "blocks" layout instead of the default dark bar. Defaults to `false` — every existing call site is unaffected. */
  ingles?: boolean;
}

const { lang = DEFAULT_LANG, ingles = false } = Astro.props;

const labels = UI_LABELS[lang].nav;
const base = `/${lang}`;
const inglesHref = `${base}/ingles`;

// PART 1 scope extension (owner spec 2026-10-06, item B): only the HUB
// itself splits its logo block into two separate links (see that block's
// own comment below) — every other Inglés page keeps today's single link.
// `isInglesHubPath` is the SAME hub-path check `backNavigation.ts` uses for
// the back button, reused here rather than duplicated.
const isHub = ingles && isInglesHubPath(Astro.url.pathname);
const backToChuyoCodeLabel = UI_LABELS[lang].english.hub.backToChuyoCode;

// Computed here (server-side) so `UserMenu` — hydrated on EVERY page — only
// ever receives its own small slice of copy as a plain prop, never the full
// `UI_LABELS` dictionary. See that component's own header/props doc.
const userMenuLabels = UI_LABELS[lang].auth.userMenu;

// "Cursos" is deliberately NOT in this list yet: the paid Courses feature
// (see `0017_courses.sql`) is being built base-first and stays HIDDEN — no
// nav/hub/menu entry anywhere — until payments actually exist and the
// feature is ready to announce. `src/navCoursesGuard.test.ts` guards this
// repo-wide, not just here.
const navLinks = [
  { href: `${base}/libros`, label: labels.books },
  { href: `${base}/noticias`, label: labels.news },
  { href: inglesHref, label: labels.englishLink },
];
---

{ingles ? (
  /* INGLÉS "blocks" branch (owner spec 2026-10-05) — see the file header's
     own note. `data-chrome-header` sits on THIS root so it is also the grid
     container `global.css`'s `[data-chrome-mode='ingles']` rules collapse/
     expand; `data-chrome-collapse` marks the ONE child that wraps every bit
     of content, which is what that same CSS clips to zero height. */
  <header data-chrome-header transition:persist transition:animate="none">
    <div data-chrome-collapse>
      <div class="mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-4">
        {/* Logo block: the word "Inglés" (display font) over a small "by
            ChuyoCode" byline, standing in for the owner's own AI-generated
            lettering until that asset exists — see the comment right above
            the fallback <span> below for the one-line swap.
            PART 1 scope extension (owner spec 2026-10-06, item B): on the
            HUB only, the byline becomes its OWN link back to the ChuyoCode
            home — a visitor already on the hub has no other one-click way
            back. Two links means this block can no longer be a single outer
            `<a>` (nested anchors are invalid HTML), so the hub renders the
            same visual block as a plain `<div>` wrapping two separate
            links instead; every other Inglés page keeps the original single
            `<a>`, byline as plain text, unchanged byte-for-byte. */}
        {isHub ? (
          <div class="flex flex-none flex-col items-start gap-1 rounded-card border border-border bg-card px-4 py-2 shadow-elevation-1 transition-theme duration-theme">
            <a
              href={inglesHref}
              aria-label="Inglés"
              class="font-display text-2xl leading-none font-extrabold tracking-tight text-foreground transition-theme duration-theme hover:text-accent-ink sm:text-3xl"
            >
              Inglés
            </a>
            {/* "by ChuyoCode" — soft hover (color + underline, no motion) and
                the same hover/focus tooltip pattern the practice-page icon
                buttons use (`@lib/ui/iconTooltip`'s `ICON_TOOLTIP_BUBBLE_CLASS`):
                `group relative` here is what that bubble anchors to and
                reveals from. `aria-label` carries the same text as the
                tooltip (never only `title`, which some platforms' a11y trees
                ignore) and `aria-describedby` wires the two together without
                a screen reader hearing the name twice. */}
            <a
              href={`${base}/`}
              aria-label={backToChuyoCodeLabel}
              aria-describedby="header-back-to-chuyocode-tooltip"
              class="group relative flex items-center gap-1 text-[11px] leading-none font-medium text-muted-foreground transition-colors duration-theme hover:text-accent-ink hover:underline"
            >
              by
              <img src="/chuyocode.svg" alt="" class="h-3 w-3" />
              ChuyoCode
              <span
                role="tooltip"
                id="header-back-to-chuyocode-tooltip"
                class={ICON_TOOLTIP_BUBBLE_CLASS}
              >
                {backToChuyoCodeLabel}
              </span>
            </a>
          </div>
        ) : (
          <a
            href={inglesHref}
            aria-label="Inglés by ChuyoCode"
            class="flex flex-none flex-col items-start gap-1 rounded-card border border-border bg-card px-4 py-2 shadow-elevation-1 transition-theme duration-theme hover:border-accent-ink"
          >
            {/* IMAGE SLOT — once the owner drops the real lettering at
                `/images/brand/ingles-wordmark-v1.webp`, swap the fallback
                <span> below for:
                  <img src="/images/brand/ingles-wordmark-v1.webp" alt="Inglés" class="h-7 w-auto sm:h-8" />
                — a one-line change, nothing else in this block depends on it. */}
            <span class="font-display text-2xl leading-none font-extrabold tracking-tight text-foreground sm:text-3xl">
              Inglés
            </span>
            <span class="flex items-center gap-1 text-[11px] leading-none font-medium text-muted-foreground">
              by
              <img src="/chuyocode.svg" alt="" class="h-3 w-3" />
              ChuyoCode
            </span>
          </a>
        )}

        {/* Account block — same `UserMenu` island as the SITE branch. PART 1
            of the owner-approved "desktop" redesign (2026-10-06) drops the
            Libros/Noticias/Inglés nav (both the desktop block above and the
            mobile hamburger panel it used to share with the account block)
            and the bordered/padded box around the account control itself —
            the avatar trigger (signed in) or the "Ingresar" pill (signed
            out) now sits directly in the header row, with no surrounding
            card. No nav links are left for a hamburger to hold on an Inglés
            page, so there is no mobile menu button/panel in this branch
            either; `UserMenu`'s own dropdown already works (and is already
            reachable) at every breakpoint on its own, portaled to
            `document.body` — see that component's own header. */}
        <div class="flex flex-none items-center" data-header-actions>
          <UserMenu lang={lang} labels={userMenuLabels} client:load />
        </div>
      </div>
    </div>
  </header>
) : (
  <header
    data-chrome-header
    class="sticky top-0 z-40 border-b border-border bg-background/95 backdrop-blur transition-theme duration-theme"
    transition:persist
    transition:animate="none"
  >
    <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4">
      {/* Masthead: small logo image (left) + wordmark (right), vertically
          centered. `/logo.svg` is intentionally absent for now — it renders as a
          broken-image placeholder until the real asset lands in `public/`. */}
      <a
        href={`${base}/`}
        class="flex items-center gap-2 text-xl font-bold tracking-tight text-primary hover:text-primary/80"
      >
        <img src="/chuyocode.svg" alt="ChuyoCode" class="h-8 w-8 object-contain" />
        <span>ChuyoCode</span>
      </a>

      {/* Right side of the bar: primary nav next to the account area (logo
          stays left, above). */}
      <div class="flex items-center gap-6" data-header-actions>
        <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
          {
            navLinks.map((link) => (
              <a
                href={link.href}
                class="text-sm font-medium text-muted-foreground transition-theme duration-theme hover:text-primary"
              >
                {link.label}
              </a>
            ))
          }
        </nav>

        <div class="flex items-center gap-3">
          {/* Account chip — visible at every breakpoint, signed in or not. See
              the file header: client-only, never server-rendered from
              `Astro.locals.user`. `client:load` over `client:idle` so it starts
              resolving immediately rather than waiting for the main thread to go
              idle, which would stretch the loading placeholder's flash on a busy
              page with several other islands ahead of it in the idle queue. */}
          <UserMenu lang={lang} labels={userMenuLabels} client:load />

          {/* Mobile: hamburger button + JS toggle stub. The toggle just flips
              the `hidden` class on the mobile menu; no framework, no island. */}
          <button
            type="button"
            id="mobile-menu-button"
            class="inline-flex items-center justify-center rounded-md p-2 text-muted-foreground hover:text-primary md:hidden"
            aria-label="Toggle navigation menu"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-6 w-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <nav
      id="mobile-menu"
      class="hidden flex-col gap-2 border-t border-border px-4 py-3 md:hidden"
      aria-label="Mobile"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="py-1 text-sm font-medium text-muted-foreground hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
      {/* Account entries (Ingresar / Crear actividad / Mis actividades /
          Moderación / Cerrar sesión) — empty here on purpose, this panel must
          stay byte-identical for every visitor (see the file header's 🔴
          note). `UserMenu` (already mounted above, client-only) portals its
          own account actions into this exact slot once it knows who is signed
          in — see that component's own header. */}
      <div id="mobile-menu-account" class="flex flex-col gap-2 border-t border-border pt-2" />
    </nav>
  </header>
)}

<script is:inline data-astro-rerun>
  // Hamburger toggle stub: flips the mobile menu visibility + aria-expanded.
  (function () {
    var btn = document.getElementById('mobile-menu-button');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
  })();
</script>

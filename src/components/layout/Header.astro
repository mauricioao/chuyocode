---
/**
 * Header — site masthead (spec 7: Header requirement).
 *
 * Renders:
 *  - The masthead logo (small image + "ChuyoCode" wordmark), linked to the
 *    localized home (`/{lang}/`). The image points at `/logo.svg`, which is
 *    intentionally absent until the real asset is dropped in `public/` — it
 *    renders as a broken-image placeholder on purpose in the meantime.
 *  - Primary, localized nav links (Libros, Noticias, Cursos, Inglés). The
 *    Cursos/Inglés routes are intentional future links (they 404 until their
 *    pages land).
 *  - A mobile hamburger button (structure + JS toggle stub only).
 *
 * The site is dark-only and Spanish-only in the chrome: there is no theme
 * toggle, no language toggle, and no disabled English slot. (The `/en/` routes
 * stay functional at the routing level; only the UI toggle was removed.)
 *
 * i18n note: nav labels come from the shared `src/lib/i18n.ts` (`UI_LABELS`),
 * the single source of truth for localized chrome. The previous inline
 * NAV_LABELS map was removed once i18n.ts landed (Phase 3).
 */
import { UI_LABELS, DEFAULT_LANG, type Lang } from '@lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = DEFAULT_LANG } = Astro.props;

const labels = UI_LABELS[lang].nav;
const base = `/${lang}`;

const navLinks = [
  { href: `${base}/libros`, label: labels.books },
  { href: `${base}/noticias`, label: labels.news },
  { href: `${base}/cursos`, label: labels.courses },
  { href: `${base}/ingles`, label: labels.englishLink },
];
---

<header
  class="sticky top-0 z-40 border-b border-base-muted bg-base/95 backdrop-blur transition-theme duration-theme"
>
  <div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4">
    {/* Masthead: small logo image (left) + wordmark (right), vertically
        centered. `/logo.svg` is intentionally absent for now — it renders as a
        broken-image placeholder until the real asset lands in `public/`. */}
    <a
      href={`${base}/`}
      class="flex items-center gap-2 text-xl font-bold tracking-tight text-accent hover:text-accent-hover"
    >
      <img src="/chuyocode.svg" alt="ChuyoCode" class="h-8 w-8 object-contain" />
      <span>ChuyoCode</span>
    </a>

    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-zinc-300 transition-theme duration-theme hover:text-accent"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    {/* Mobile: hamburger button + JS toggle stub. The toggle just flips the
        `hidden` class on the mobile menu; no framework, no island. */}
    <button
      type="button"
      id="mobile-menu-button"
      class="inline-flex items-center justify-center rounded-md p-2 text-zinc-300 hover:text-accent md:hidden"
      aria-label="Toggle navigation menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    class="hidden flex-col gap-2 border-t border-base-muted px-4 py-3 md:hidden"
    aria-label="Mobile"
  >
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class="py-1 text-sm font-medium text-zinc-300 hover:text-accent"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>

<script is:inline data-astro-rerun>
  // Hamburger toggle stub: flips the mobile menu visibility + aria-expanded.
  (function () {
    var btn = document.getElementById('mobile-menu-button');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', String(open));
    });
  })();
</script>
